TYPE "UDT_Divert_Constraint_Setting"
VERSION : 0.1
   STRUCT
      Enable : Bool := FALSE;
      Threshold : Int;
      Priority : Int;
      Sort_Code : Int;
      Preferred_Direction : Byte := 16#00;   // Bit0 = Wait Bit1= Straight Bit2= Left Bit3 = Right
      Disallowed_Direction : Byte := 16#00;   // Bit0 = Wait Bit1= Straight Bit2= Left Bit3 = Right
   END_STRUCT;

END_TYPE

TYPE "UDT_SWS_Servo_Setting"
VERSION : 0.1
   STRUCT
      Enable_Soft_Limit { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool := TRUE;
      Enable_Hard_Limit { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      Continuous_Action_Mode : Bool := TRUE;
      STOUsed : Bool;
      Left_Position_Setpoint : Int := -60;   // [°]
      Right_Position_Setpoint : Int := 60;   // [°]
      Speed_Setpoint : Int := 1200;   // [°/s]
      Acc_Setpoint { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int := 20000;   // [°/s²]
      Dec_Setpoint { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int := 20000;   // [°/s²]
      Max_Left_Position { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int := -65;   // [°]
      Max_Right_Position { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int := 65;   // [°]
      Max_Speed { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Int := 1500;   // [°/s]
   END_STRUCT;

END_TYPE

TYPE "UDT_SWS_Roller_Hardware_Setting"
VERSION : 0.1
   STRUCT
      Module_Roller_Count : Int := 29;
      Speed_Straight : Int := 1200;
      Speed_Left : Int := 1500;
      Speed_Right : Int := 1500;
      Reference_RPM : Real := 470.0;
      Acceleration : Int := 4000;   // [mm/s²] Ramp up
      Deceleration : Int := 4000;   // [mm/s²] Ramp down
   END_STRUCT;

END_TYPE

TYPE "i_udtSettings"
VERSION : 0.1
   STRUCT
      timStartReadDelay : UDInt := 40;   // Start read delay time (mseconds)
      timSpare_Timer2 : UDInt;   // Not in use
      timNoActivity : UDInt := 10000;   // Time to consider Camera not working ok
      timTimeOutRead : UDInt := 400;   // TimeOut to get Barcode (mseconds)
      TimeStarting : UDInt := 5000;   // Time starting camera (waitting for normal operation)
      timTrshNoReadRow : Int;   // threshold no reads in a row
      xIndexProtocol : Bool := TRUE;   // 1: In Use; 0: Not used
      xIOConditioning : Bool := FALSE;   // 1: In Use; 0: Not used
      xFocusingDevice : Bool := FALSE;
      Protocol : Struct
         Encapsulation : Bool := TRUE;
         Header : String := '$02';
         Footer : String := '$03';
         Separator : String := '€';
         VirtualID : String := '!';
         ValidTelegram : String := '*';
         NoRead : String := '??????????';
         MultiRead : String := '9999999999';
      END_STRUCT;
      Telegrams : Struct
         Number : Int := 4;
         Parameters : Array[0..10] of Struct
            Length : Int;   // Telegram length without encapsulation
            "Type" : Int;   // 0: No Code; 1: Status Telegram; 2: Barcode Telegram; 9: Special Barcode Telegram
            ID : Char;   // Telegram ID. D: Status; I: Index Barcode
            Barcode : Struct   // Only for Types > 2
               FromDAD : String;
               ToPLC : String := '0000000000';
            END_STRUCT;
         END_STRUCT;
      END_STRUCT;
   END_STRUCT;

END_TYPE

TYPE "UDT_G115D_Setting"
VERSION : 0.1
   STRUCT
      Speed1 : Int := 1000;   // [mm/s] Target speed 1
      Speed2 : Int := 500;   // [mm/s] Target speed 2
      Speed3 : Int;   // [mm/s] Target speed 3
      Speed4 : Int;   // [mm/s] Target speed 4
      Acceleration : Int := 4000;   // [mm/s²] Ramp up
      Deceleration : Int := 4000;   // [mm/s²] Ramp down
      RefSpeed : Int;   // [mm/s] Speed at 3000RPM
      RefRampTime : Int := 10000;   // [ms] Ramp up and ramp down time for 3000RPM
      Magnetization_Delay : Int;   // [ms] Delay time from run command to mote have speed
      ReverseDirection : Bool;   // TRUE = Reverse inverter output direction
      STOUsed : Bool;   // TRUE = STO is used
   END_STRUCT;

END_TYPE

