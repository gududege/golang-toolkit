         Spare_20_0 : Real;   // RealValue Spare Data
         Spare_24_0 : Real;   // RealValue Spare Data
         Spare_28_0 : Real;   // RealValue Spare Data
         Spare_32_0 : Real;   // RealValue Spare Data
         Spare_36_0 : Real;   // RealValue Spare Data
      END_STRUCT;
      Output : Struct
         Start_Command : Bool;
         Stop_Command : Bool;
         Reset_Alarm : Bool;
         Slow_Down : Bool;
         Wake_Up : Bool;
         Hold : Bool;
         Spare_0_6 : Bool;   // Signal Spare Bit
         Spare_0_7 : Bool;   // Signal Spare Bit
         Upstream_RTS : Bool;
         Downstream_RTR : Bool;
         Spare_1_2 : Bool;   // Signal Spare Bit
         Spare_1_3 : Bool;   // Signal Spare Bit
         Spare_1_4 : Bool;   // Signal Spare Bit
         Spare_1_5 : Bool;   // Signal Spare Bit
         Spare_1_6 : Bool;   // Signal Spare Bit
         Spare_1_7 : Bool;   // Signal Spare Bit
         Spare_2_0 : Bool := false;   // Signal Spare Bit
         Spare_2_1 : Bool := false;   // Signal Spare Bit
         Spare_2_2 : Bool := false;   // Signal Spare Bit
         Spare_2_3 : Bool := false;   // Signal Spare Bit
         Spare_2_4 : Bool := false;   // Signal Spare Bit
         Spare_2_5 : Bool := false;   // Signal Spare Bit
         Spare_2_6 : Bool := false;   // Signal Spare Bit
         Spare_2_7 : Bool := false;   // Signal Spare Bit
         LifeSign : Bool := false;   // Heartbeat Signal (500ms)
         Spare_3_1 : Bool := false;   // Signal Spare Bit
         Spare_3_2 : Bool := false;   // Signal Spare Bit
         Spare_3_3 : Bool := false;   // Signal Spare Bit
         Spare_3_4 : Bool := false;   // Signal Spare Bit
         Spare_3_5 : Bool := false;   // Signal Spare Bit
         Spare_3_6 : Bool := false;   // Signal Spare Bit
         Spare_3_7 : Bool := false;   // Signal Spare Bit
         Upstream_Running : Bool := false;
         Downstream_Running : Bool := false;
         Upstream_Faulted : Bool := false;
         Dowstream_Faulted : Bool := false;
         Spare_4_4 : Bool := false;   // Diagnostic Spare Bit
         Spare_4_5 : Bool := false;   // Diagnostic Spare Bit
         Spare_4_6 : Bool := false;   // Diagnostic Spare Bit
         Spare_4_7 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_0 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_1 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_2 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_3 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_4 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_5 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_6 : Bool := false;   // Diagnostic Spare Bit
         Spare_5_7 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_0 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_1 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_2 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_3 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_4 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_5 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_6 : Bool := false;   // Diagnostic Spare Bit
         Spare_6_7 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_0 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_1 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_2 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_3 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_4 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_5 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_6 : Bool := false;   // Diagnostic Spare Bit
         Spare_7_7 : Bool := false;   // Diagnostic Spare Bit
         Infeed_Speed : Real := 0.0;   // [m/s]
         Outfeed_Speed : Real := 0.0;   // [m/s]
         Spare_16_0 : Real := 0.0;   // RealValue Spare Data
         Spare_20_0 : Real := 0.0;   // RealValue Spare Data
         Spare_24_0 : Real := 0.0;   // RealValue Spare Data
         Spare_28_0 : Real := 0.0;   // RealValue Spare Data
         Spare_32_0 : Real := 0.0;   // RealValue Spare Data
         Spare_36_0 : Real := 0.0;   // RealValue Spare Data
      END_STRUCT;
   END_STRUCT;

END_TYPE

TYPE "UDT_TL70_IO"
VERSION : 0.1
   STRUCT
      Module_1_Color : Int;   // 0 = Green, 1 = Red, 2 = Orange, 3 = Amber, 4 = Yellow, 5 = Lime Green, 6 = Spring Green, 7 = Cyan, 8 = Sky Blue, 9 = Blue, 10 = Violet, 11 = Magenta, 12 = Rose, 13 = Daylight White (5000K), 14 = Custom 1, 15 = Custom 2
      Module_1_Flash : Int;   // 0 = Off, 1 = Steady, 2 = Flash 1Hz, 3 = Flash 2Hz, 4 = Flash 10Hz, 5 = Flash Custom Rate 
      Module_2_Color : Int;   // 0 = Green, 1 = Red, 2 = Orange, 3 = Amber, 4 = Yellow, 5 = Lime Green, 6 = Spring Green, 7 = Cyan, 8 = Sky Blue, 9 = Blue, 10 = Violet, 11 = Magenta, 12 = Rose, 13 = Daylight White (5000K), 14 = Custom 1, 15 = Custom 2
      Module_2_Flash : Int;   // 0 = Off, 1 = Steady, 2 = Flash 1Hz, 3 = Flash 2Hz, 4 = Flash 10Hz, 5 = Flash Custom Rate 
      Module_3_Color : Int;   // 0 = Green, 1 = Red, 2 = Orange, 3 = Amber, 4 = Yellow, 5 = Lime Green, 6 = Spring Green, 7 = Cyan, 8 = Sky Blue, 9 = Blue, 10 = Violet, 11 = Magenta, 12 = Rose, 13 = Daylight White (5000K), 14 = Custom 1, 15 = Custom 2
      Module_3_Flash : Int;   // 0 = Off, 1 = Steady, 2 = Flash 1Hz, 3 = Flash 2Hz, 4 = Flash 10Hz, 5 = Flash Custom Rate 
      Module_4_Color : Int;   // 0 = Green, 1 = Red, 2 = Orange, 3 = Amber, 4 = Yellow, 5 = Lime Green, 6 = Spring Green, 7 = Cyan, 8 = Sky Blue, 9 = Blue, 10 = Violet, 11 = Magenta, 12 = Rose, 13 = Daylight White (5000K), 14 = Custom 1, 15 = Custom 2
      Module_4_Flash : Int;   // 0 = Off, 1 = Steady, 2 = Flash 1Hz, 3 = Flash 2Hz, 4 = Flash 10Hz, 5 = Flash Custom Rate 
      Module_5_Color : Int;   // 0 = Green, 1 = Red, 2 = Orange, 3 = Amber, 4 = Yellow, 5 = Lime Green, 6 = Spring Green, 7 = Cyan, 8 = Sky Blue, 9 = Blue, 10 = Violet, 11 = Magenta, 12 = Rose, 13 = Daylight White (5000K), 14 = Custom 1, 15 = Custom 2
      Module_5_Flash : Int;   // 0 = Off, 1 = Steady, 2 = Flash 1Hz, 3 = Flash 2Hz, 4 = Flash 10Hz, 5 = Flash Custom Rate 
      Buzzer : Bool;
      Port_Healthy : Bool;
   END_STRUCT;

END_TYPE

TYPE "UDT_MCC_Command"
VERSION : 0.1
   STRUCT
      Start : Bool;
      Stop : Bool;
      Reset : Bool;
   END_STRUCT;

END_TYPE

TYPE "UDT_SCADA_Command"
VERSION : 0.1
   STRUCT
      Start : Bool;
      Stop : Bool;
      Reset : Bool;
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_Conv_Dual_G115D"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_U01_Telegram_HW_ID : HW_SUBMODULE;
      i_U01_Additional_HW_ID : HW_SUBMODULE;
      i_U02_Telegram_HW_ID : HW_SUBMODULE;
      i_U02_Additional_HW_ID : HW_SUBMODULE;
      i_IO_PEC_Position : Bool;
      i_IO_PEC_Trigger : Bool;
      i_Setting : "UDT_Conv_Dual_G115D_Setting";
      i_External_Request : "UDT_External_Request";
      i_Command : "UDT_Conv_Dual_G115D_Command";
   END_VAR

   VAR_OUTPUT RETAIN
      o_Status : "UDT_Conv_Dual_G115D_Status";
      o_General_Status : "UDT_General_Status";
      o_Diagnostics : "UDT_Conv_Dual_G115D_Diagnostics";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_System_Control : "UDT_System_Control";
      io_U01_G115D_IO : "UDT_G115D_HW_Interface";
      io_U02_G115D_IO : "UDT_G115D_HW_Interface";
      io_FIF_Upstream : "UDT_Flow_Interface";
      io_FIF : "UDT_Flow_Interface";
      io_FIF_Downstream : "UDT_Flow_Interface";
   END_VAR

   VAR 
      s_FB_Displacement_AccDec : "FB_Displacement_AccDec";
      s_FB_EQP_PEC_Position : "FB_EQP_PEC_Position";
      s_FB_EQP_PEC_Trigger : "FB_EQP_PEC_Trigger";
      s_FB_EQP_Transport : "FB_EQP_Transport";
      s_U01_FB_HW_VFD_G115D : "FB_HW_VFD_G115D";
      s_U02_FB_HW_VFD_G115D : "FB_HW_VFD_G115D";
   END_VAR
   VAR RETAIN
      s_Cnt_PEC_Items : Int;
      s_Speed_Select : Int;
      s_SW_Actual_Speed : Int;
      s_U01_HW_Actual_Speed : Int;
      s_U02_HW_Actual_Speed : Int;
      s_CMD_PEC_Preset_Latch : Bool;
      s_CMD_Motor : Bool;
      s_CMD_Motor_Reverse : Bool;
      s_U01_HW_Req_Halt : Bool;
      s_U02_HW_Req_Halt : Bool;
      s_PE_Position_Latch : Bool;
      s_PE_Trigger_Latch : Bool;
      s_Ext_Req_Stop : Bool;
      s_Ext_Req_Halt : Bool;
      s_Ext_Req_Disable_Send : Bool;
      s_Ext_Req_Disable_Recv : Bool;
      s_Ext_Req_Rest_ESave : Bool;
      s_Ext_Req_Clear_Data : Bool;
      s_SW_Motor_OnSpeed : Bool;
      s_U01_HW_Motor_Running : Bool;
      s_U02_HW_Motor_Running : Bool;
   END_VAR

   VAR_TEMP 
      t_PEC_Position_Items : UDInt;
      t_PEC_Trigger_Items : UDInt;
      t_PEC_Position_Ready_To_Reset : Bool;
      t_PEC_Trigger_Ready_To_Reset : Bool;
      t_U01_HW_VFD_Ready_To_Reset : Bool;
      t_U02_HW_VFD_Ready_To_Reset : Bool;
   END_VAR


BEGIN
	REGION NETWORK AA: Conveyor Cycle Displacement
	    #s_FB_Displacement_AccDec(i_Conveyor_Speed   := #io_FIF.Speed,
	                              i_Accelaration     := #i_Setting.Hardware_U01.Acceleration,
	                              i_Decelaration     := #i_Setting.Hardware_U01.Deceleration,
	                              i_Prev_Cycle_Time  := #io_Global.OB_Prev_Cycle_Time,
	                              i_PPI_Displacement := 0,
	                              i_Section_Run      := #io_FIF.Motor_Run,
	                              o_Motor_On_Speed   => #o_General_Status.Motor_On_Speed,
	                              o_Motor_Stopped    => #io_FIF.Motor_Stopped,
	                              o_Actual_Speed     => #s_SW_Actual_Speed,
	                              o_Displacement     => #io_FIF.Displacement);
	    
	    #o_General_Status.Motor_Stopped := #io_FIF.Motor_Stopped;
	END_REGION
	
	REGION NETWORK BA: Equipment layer - PEC
	    #s_FB_EQP_PEC_Position(i_IO_Available             := #io_System_Control.IO_Available,
	                           i_CMD_Reset                := #io_System_Control.OS_Reset_Jam,
	                           i_CMD_Clear_Stat           := #io_System_Control.OS_Clear_Statistics,
	                           i_CFG_Blockage_Length      := #i_Setting.PE1.Blockage_Length,
	                           i_CFG_Delay_On             := #i_Setting.PE1.Delay_On,
	                           i_CFG_Delay_Off            := #i_Setting.PE1.Delay_Off,
	                           i_CFG_Shifting_Offset      := #i_Setting.PE1.Shifting_Offset,
	                           i_CFG_Handover_Offset      := #i_Setting.PE1.Handover_Offset,
	                           i_CFG_Detect_PEC_OnStopped := #i_Setting.PE1.Detect_PEC_OnStopped,
	                           i_CFG_Reset_Block_PEC_Oc   := #i_Setting.PE1.Reset_Block_PEC_Oc,
	                           i_CFG_Item_On              := #i_Setting.PE1.Item_On,
	                           i_CMD_Preset_Latch         := #s_CMD_PEC_Preset_Latch,
	                           i_CMD_Clear_Data           := #s_Ext_Req_Clear_Data,
	                           i_Cycle_Count              := #io_FIF.Displacement,
	                           i_IO_PEC                   := #i_IO_PEC_Position,
	                           i_Section_Running          := NOT #io_FIF.Motor_Stopped,
	                           o_Ready_To_Reset           => #t_PEC_Position_Ready_To_Reset,
	                           o_ER_PEC_Blockage          => #o_Status.ER_PE1_Blockage,
	                           o_PEC_Filter               => #s_PE_Position_Latch,
	                           o_Handover                 => #io_FIF.Handover,
	                           o_Cnt_Buffer_Used          => #s_Cnt_PEC_Items,
	                           o_Stat_Items               => #t_PEC_Position_Items);
	    
	    #s_FB_EQP_PEC_Trigger(i_IO_Available             := #io_System_Control.IO_Available,
	                          i_CMD_Reset                := #io_System_Control.OS_Reset_Jam,
	                          i_CMD_Clear_Stat           := #io_System_Control.OS_Clear_Statistics,
	                          i_CFG_Blockage_Length      := #i_Setting.PE2.Blockage_Length,
	                          i_CFG_Delay_On             := #i_Setting.PE2.Delay_On,
	                          i_CFG_Delay_Off            := #i_Setting.PE2.Delay_Off,
	                          i_CFG_Detect_PEC_OnStopped := #i_Setting.PE2.Detect_PEC_OnStopped,
	                          i_CFG_Reset_Block_PEC_Oc   := #i_Setting.PE2.Reset_Block_PEC_Oc,
	                          i_CFG_Item_On              := #i_Setting.PE2.Item_On,
	                          i_CMD_Preset_Latch         := false,
	                          i_Cycle_Count              := #io_FIF.Displacement,
	                          i_IO_PEC                   := #i_IO_PEC_Trigger,
	                          i_Section_Running          := NOT #io_FIF.Motor_Stopped,
	                          o_Ready_To_Reset           => #t_PEC_Trigger_Ready_To_Reset,
	                          o_ER_PEC_Blockage          => #o_Status.ER_PE2_Blockage,
	                          o_PEC_Filter               => #s_PE_Trigger_Latch,
	                          o_Stat_Items               => #t_PEC_Trigger_Items);
	    
	    #io_FIF.PECTrigger_Latch := #s_PE_Trigger_Latch;
	END_REGION
	
	REGION NETWORK CA: Conditions to basic control
	    // Condition to request stop
	    #s_Ext_Req_Stop := #o_Status.ER_U01_VFD_PN_NotPresent
	    // OR #o_Status.ER_U01_PN_Error
	    OR #o_Status.ER_U01_VFD_Fault
	    OR #o_Status.ER_U01_VFD_STO_Active
	    OR #o_Status.ER_U02_VFD_PN_NotPresent
	    // OR #o_Status.ER_U02_PN_Error
	    OR #o_Status.ER_U02_VFD_Fault
	    OR #o_Status.ER_U02_VFD_STO_Active
	    OR #i_External_Request.Request_Stop;
	    
	    // Condition to request halt
	    #s_Ext_Req_Halt := #s_U01_HW_Req_Halt
	    OR #s_U02_HW_Req_Halt
	    OR #i_External_Request.Request_Halt
	    OR #i_Command.Man_Mode
	    OR #o_Status.ER_PE1_Blockage
	    OR #o_Status.ER_PE2_Blockage;
	    
	    // Condition to request disable send
	    #s_Ext_Req_Disable_Send := #i_External_Request.Request_Disable_Send;
	    
	    // Condition to request disable receive
	    #s_Ext_Req_Disable_Recv := #i_External_Request.Request_Disable_Receive OR #i_Command.Man_Mode;
	    
	    // Condition to request reset engergy saving
	    #s_Ext_Req_Rest_ESave := #i_External_Request.Request_Reset_EnergySave OR #io_Global.Common_Setting.Disable_Energy_Saving OR #i_Command.Cmd_Reset_ESave OR #s_PE_Trigger_Latch OR #s_FB_EQP_PEC_Position.s_PEC_Filter;
	    
	    // Condition to request clear flow interface data
	    #s_Ext_Req_Clear_Data := #i_External_Request.Request_Clear_Data OR (#i_Command.Man_Clear AND #i_Command.Man_Mode);
	END_REGION
	
	REGION NETWORK DA: Equipment Layer - Basic
	    #s_FB_EQP_Transport(i_Enable                 := #io_System_Control.Enable,
	                        i_IO_Available           := #io_System_Control.IO_Available,
	                        i_Safety_OK              := #io_System_Control.Safety_OK,
	                        i_CMD_Reset              := #io_System_Control.OS_Reset,
	                        i_CMD_Start              := #io_System_Control.OS_Start,
	                        i_CMD_Controlled_Stop    := #io_System_Control.Controlled_Stop,
	                        i_End_PEC_Latch          := #s_PE_Position_Latch,
	                        i_Manual_Run             := #i_Command.Man_Run AND #i_Command.Man_Mode,
	                        i_CFG_Slave_Conveyor     := #i_Setting.Base_Conveyor.Slave_Mode,
	                        i_CFG_Enable_DieForward  := #i_Setting.Base_Conveyor.Enable_DieForward,
	                        i_Delay_Waiting_Item     := #i_Setting.Base_Conveyor.Delay_Waiting_Item,
	                        i_Delay_Dieback          := #i_Setting.Base_Conveyor.Delay_Dieback,
	                        i_Delay_Startup          := #i_Setting.Base_Conveyor.Delay_Startup,
	                        i_Delay_Finish_Handover  := #i_Setting.Base_Conveyor.Delay_Finish_Handover,
	                        i_Delay_Energysave       := #i_Setting.Base_Conveyor.Delay_Energysave,
	                        i_Delay_Cascade_Startup  := #i_Setting.Base_Conveyor.Delay_Cascade_Startup,
	                        i_Delay_Cascade_Shutdown := #i_Setting.Base_Conveyor.Delay_Cascade_Shutdown,
	                        i_Delay_Motor_Startup    := #i_Setting.Hardware_U01.Magnetization_Delay,
	                        i_Minimum_Gap            := #i_Setting.Flow_Control.Minimum_Gap,
	                        i_Minimum_Head_To_Head   := #i_Setting.Flow_Control.Minimum_Head_To_Head,
	                        i_Ext_Req_Stop           := #s_Ext_Req_Stop,
	                        i_Ext_Req_Halt           := #s_Ext_Req_Halt,
	                        i_Ext_Req_Dis_Send       := #s_Ext_Req_Disable_Send,
	                        i_Ext_Req_Dis_Recv       := #s_Ext_Req_Disable_Recv,
	                        i_Ext_Req_Rst_ESave      := #s_Ext_Req_Rest_ESave,
	                        i_Ext_Req_Clear_Data     := #s_Ext_Req_Clear_Data,
	                        o_Ready_To_Start         => #io_System_Control.Ready_To_Start,
	                        o_ST_Safety_Stop         => #o_General_Status.Safety_Stop,
	                        o_ST_Items               => #o_General_Status.Items,
	                        o_ST_Die_Back            => #o_General_Status.Die_Back,
	                        o_ST_Motor_Running       => #o_General_Status.Motor_Running,
	                        o_ST_Started             => #o_General_Status.Started,
	                        o_ST_Energy_Saving       => #o_General_Status.Energy_Saving,
	                        o_MTR_Run                => #s_CMD_Motor,
	                        io_Global                := #io_Global,
	                        io_FIF_Upstream          := #io_FIF_Upstream,
	                        io_FIF                   := #io_FIF,
	                        io_FIF_Downstream        := #io_FIF_Downstream);
	END_REGION
	
	REGION NETWORK EA: Hardware Layer - G115D Convertor
	    #s_Speed_Select := #i_External_Request.Request_Speed;
	    
	    #s_U01_FB_HW_VFD_G115D(i_Telegram_HW_ID        := #i_U01_Telegram_HW_ID,
	                           i_Additional_HW_ID      := #i_U01_Additional_HW_ID,
	                           i_Enable                := (#io_System_Control.Enable OR #i_Command.Man_Mode) AND NOT #i_Command.Man_DisableAxis,
	                           i_IO_Available          := #io_System_Control.IO_Available,
	                           i_Safety_OK             := #io_System_Control.Safety_OK,
	                           i_CMD_Reset             := #io_System_Control.OS_Reset,
	                           i_CMD_Clear_Stat        := #io_System_Control.OS_Clear_Statistics,
	                           i_HW_Setting            := #i_Setting.Hardware_U01,
	                           i_CFG_Motor_Switch_Time := 500,
	                           i_CMD_Select_Speed      := #s_Speed_Select,
	                           i_CMD_Motor_Run         := #s_CMD_Motor,
	                           i_CMD_Motor_Reverse     := #s_CMD_Motor_Reverse,
	                           o_Ready_To_Reset        => #t_U01_HW_VFD_Ready_To_Reset,
	                           o_Req_Halt              => #s_U01_HW_Req_Halt,
	                           o_ER_PN_Not_Present     => #o_Status.ER_U01_VFD_PN_NotPresent,
	                           o_ER_PN_Error           => #o_Status.ER_U01_VFD_PN_Error,
	                           o_ER_Motor_Fault        => #o_Status.ER_U01_VFD_Fault,
	                           o_WN_Motor_Alarm        => #o_Status.WN_U01_VFD_Alarm,
	                           o_ER_STO_Active         => #o_Status.ER_U01_VFD_STO_Active,
	                           o_WN_No_MemoryCard      => #o_Status.WN_U01_No_MemoryCard,
	                           o_ST_Motor_Running      => #s_U01_HW_Motor_Running,
	                           o_FaultCode             => #o_Status.U01_FaultCode,
	                           o_AlarmCode             => #o_Status.U01_AlarmCode,
	                           o_Speed_Selected        => #io_FIF.Speed,
	                           o_Diagnostics           => #o_Diagnostics.Hardware_U01,
	                           io_Global               := #io_Global,
	                           io_G115D_Interface      := #io_U01_G115D_IO);
	END_REGION
	
	REGION NETWORK EB: Hardware Layer - G115D Convertor
	    #s_Speed_Select := #i_External_Request.Request_Speed;
	    
	    #s_U02_FB_HW_VFD_G115D(i_Telegram_HW_ID        := #i_U02_Telegram_HW_ID,
	                           i_Additional_HW_ID      := #i_U02_Additional_HW_ID,
	                           i_Enable                := (#io_System_Control.Enable OR #i_Command.Man_Mode) AND NOT #i_Command.Man_DisableAxis,
	                           i_IO_Available          := #io_System_Control.IO_Available,
	                           i_Safety_OK             := #io_System_Control.Safety_OK,
	                           i_CMD_Reset             := #io_System_Control.OS_Reset,
	                           i_CMD_Clear_Stat        := #io_System_Control.OS_Clear_Statistics,
	                           i_HW_Setting            := #i_Setting.Hardware_U02,
	                           i_CFG_Motor_Switch_Time := 500,
	                           i_CMD_Select_Speed      := #s_Speed_Select,
	                           i_CMD_Motor_Run         := #s_CMD_Motor,
	                           i_CMD_Motor_Reverse     := #s_CMD_Motor_Reverse,
	                           o_Ready_To_Reset        => #t_U02_HW_VFD_Ready_To_Reset,
	                           o_Req_Halt              => #s_U02_HW_Req_Halt,
	                           o_ER_PN_Not_Present     => #o_Status.ER_U02_VFD_PN_NotPresent,
	                           o_ER_PN_Error           => #o_Status.ER_U02_VFD_PN_Error,
	                           o_ER_Motor_Fault        => #o_Status.ER_U02_VFD_Fault,
	                           o_WN_Motor_Alarm        => #o_Status.WN_U02_VFD_Alarm,
	                           o_ER_STO_Active         => #o_Status.ER_U02_VFD_STO_Active,
	                           o_WN_No_MemoryCard      => #o_Status.WN_U02_No_MemoryCard,
	                           o_ST_Motor_Running      => #s_U02_HW_Motor_Running,
	                           o_FaultCode             => #o_Status.U02_FaultCode,
	                           o_AlarmCode             => #o_Status.U02_AlarmCode,
	                           o_Diagnostics           => #o_Diagnostics.Hardware_U02,
	                           io_Global               := #io_Global,
	                           io_G115D_Interface      := #io_U02_G115D_IO);
	END_REGION
	
	REGION NETWORK: Diagnositcs
	    #o_Diagnostics.RTS := #io_FIF.RTS;
	    #o_Diagnostics.TIP := #io_FIF.TIP;
	    #o_Diagnostics.Downstream_RTR := #io_FIF_Downstream.RTR;
	    #o_Diagnostics.Displacement := #io_FIF.Displacement;
	    #o_Diagnostics.Items_Count := MAX_UDINT(IN1 := #t_PEC_Position_Items, IN2 := #t_PEC_Trigger_Items);
	END_REGION
	
	REGION NETWORK FA: Make Generate Status
	    #o_Status.OL_Maintenance_Mode := #i_Command.Man_Mode;
	    
	    #o_General_Status.Safety_Stop := #o_Status.ER_U01_VFD_STO_Active OR #o_Status.ER_U02_VFD_STO_Active OR NOT #io_System_Control.Safety_OK;
	    #o_General_Status.Off_Line := #o_Status.OL_Maintenance_Mode;
	    #o_General_Status.Manual := FALSE;
	    #o_General_Status.Error := #o_Status.ER_U01_VFD_PN_NotPresent
	    OR #o_Status.ER_U01_VFD_PN_Error
	    OR #o_Status.ER_U01_VFD_Fault
	    OR #o_Status.ER_U02_VFD_PN_NotPresent
	    OR #o_Status.ER_U02_VFD_PN_Error
	    OR #o_Status.ER_U02_VFD_Fault;
	    #o_General_Status.Jam := #o_Status.ER_PE1_Blockage OR #o_Status.ER_PE2_Blockage;
	    #o_General_Status.Warning := #o_Status.WN_U01_VFD_Alarm
	    OR #o_Status.WN_U01_No_MemoryCard
	    OR #o_Status.WN_U02_VFD_Alarm
	    OR #o_Status.WN_U02_No_MemoryCard;
	END_REGION
	
	REGION NETWORK EA: System Feedback State
	    #io_System_Control.Ready_To_Reset := #t_PEC_Position_Ready_To_Reset
	    OR #t_PEC_Trigger_Ready_To_Reset
	    OR #t_U01_HW_VFD_Ready_To_Reset
	    OR #t_U02_HW_VFD_Ready_To_Reset;
	END_REGION
END_FUNCTION_BLOCK

