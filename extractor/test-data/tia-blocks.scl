   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_SINA_Save_Parameter"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Trigger : Bool;
      i_VFD_Type : Int;   // 1: G115D 2: S210
      i_HW_ID : HW_ANY;
   END_VAR

   VAR_OUTPUT 
      o_Ready : Bool;
      o_Busy : Bool;
      o_Done : Bool;
      o_Error : Bool;
   END_VAR

   VAR 
      s_SinaParaS {InstructionName := 'SinaParaS'; LibVersion := '1.1'} : SinaParaS;
      s_Copy_Trigger { S7_SetPoint := 'True'} : Bool;
      s_Excute : Bool;
   END_VAR

   VAR_TEMP 
      t_Parameter : UInt;
   END_VAR

   VAR CONSTANT 
      C_G115D_P_INDEX : UInt := 971;
      C_S210_P_INDEX : UInt := 977;
   END_VAR


BEGIN
	IF #i_VFD_Type = 1 THEN
	    #t_Parameter := #C_G115D_P_INDEX;
	ELSIF #i_VFD_Type = 2 THEN
	    #t_Parameter := #C_S210_P_INDEX;
	ELSE
	    RETURN;
	END_IF;
	
	IF #i_Trigger AND NOT #s_Copy_Trigger THEN
	    #s_Excute := TRUE;
	END_IF;
	
	#s_SinaParaS(Start       := #s_Excute,
	             ReadWrite   := TRUE,
	             Parameter   := #t_Parameter,
	             Index       := 0,
	             ValueWrite1 := 1.0,
	             AxisNo      := 1,
	             hardwareId  := #i_HW_ID,
	             Ready       => #o_Ready,
	             Busy        => #o_Busy,
	             Done        => #o_Done,
	             Error       => #o_Error);
	
	IF NOT #o_Busy THEN
	    #s_Excute := FALSE;
	END_IF;
	
	#s_Copy_Trigger := #i_Trigger;
END_FUNCTION_BLOCK

FUNCTION "FC_SWS_Convert_Motor_Status" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Status_Byte_1 : Byte;
      i_Status_Byte_2 : Byte;
   END_VAR

   VAR_OUTPUT 
      o_Motor_Status : "UDT_SWS_Roller_Module_Motor_Status";
   END_VAR

   VAR_TEMP 
      t_Status_Word : Word;
   END_VAR


BEGIN
	#t_Status_Word.%B0 := #i_Status_Byte_1;
	#t_Status_Word.%B1 := #i_Status_Byte_2;
	
	IF #t_Status_Word = 16#FFFF THEN
	    #o_Motor_Status.None := TRUE;
	    #o_Motor_Status.NotConnected := FALSE;
	    #o_Motor_Status.Blockage := FALSE;
	    #o_Motor_Status.OK := FALSE;
	ELSIF #t_Status_Word = 16#80C0 THEN
	    #o_Motor_Status.None := FALSE;
	    #o_Motor_Status.NotConnected := TRUE;
	    #o_Motor_Status.Blockage := FALSE;
	    #o_Motor_Status.OK := FALSE;
	ELSIF #t_Status_Word = 16#0040 THEN
	    #o_Motor_Status.None := FALSE;
	    #o_Motor_Status.NotConnected := FALSE;
	    #o_Motor_Status.Blockage := TRUE;
	    #o_Motor_Status.OK := FALSE;
	ELSE
	    #o_Motor_Status.None := FALSE;
	    #o_Motor_Status.NotConnected := FALSE;
	    #o_Motor_Status.Blockage := FALSE;
	    #o_Motor_Status.OK := TRUE;
	END_IF;
	
END_FUNCTION

