TYPE "UDT_Conv_Multiple_S210_Status"
VERSION : 0.1
   STRUCT
      OL_Maintenance_Mode : Bool;   // Maintenance mode on
      ER_PE1_Blockage : Bool;   // PE1 blockage
      ER_PE2_Blockage : Bool;   // PE2 blockage
      ER_U01_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U01_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U01_Servo_Fault : Bool;   // Servo driver has error
      WN_U01_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U01_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U01_No_MemoryCard : Bool;   // Memory card is missing
      ER_U02_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U02_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U02_Servo_Fault : Bool;   // Servo driver has error
      WN_U02_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U02_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U02_No_MemoryCard : Bool;   // Memory card is missing
      ER_U03_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U03_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U03_Servo_Fault : Bool;   // Servo driver has error
      WN_U03_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U03_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U03_No_MemoryCard : Bool;   // Memory card is missing
      ER_U04_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U04_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U04_Servo_Fault : Bool;   // Servo driver has error
      WN_U04_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U04_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U04_No_MemoryCard : Bool;   // Memory card is missing
      ER_U05_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U05_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U05_Servo_Fault : Bool;   // Servo driver has error
      WN_U05_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U05_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U05_No_MemoryCard : Bool;   // Memory card is missing
      ER_U06_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U06_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U06_Servo_Fault : Bool;   // Servo driver has error
      WN_U06_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U06_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U06_No_MemoryCard : Bool;   // Memory card is missing
      ER_U07_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U07_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U07_Servo_Fault : Bool;   // Servo driver has error
      WN_U07_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U07_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U07_No_MemoryCard : Bool;   // Memory card is missing
      ER_U08_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U08_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U08_Servo_Fault : Bool;   // Servo driver has error
      WN_U08_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U08_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U08_No_MemoryCard : Bool;   // Memory card is missing
      ER_U09_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U09_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U09_Servo_Fault : Bool;   // Servo driver has error
      WN_U09_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U09_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U09_No_MemoryCard : Bool;   // Memory card is missing
      ER_U10_Servo_PN_NotPresent : Bool;   // Servo driver not present on profinet network
      ER_U10_Servo_PN_Error : Bool;   // Servo driver has error profinet network
      ER_U10_Servo_Fault : Bool;   // Servo driver has error
      WN_U10_Servo_Alarm : Bool;   // Servo driver has an warning
      ER_U10_Servo_STO_Active : Bool;   // Servo driver STO is active
      WN_U10_No_MemoryCard : Bool;   // Memory card is missing
      U01_FaultCode : Word;
      U01_AlarmCode : Word;
      U02_FaultCode : Word;
      U02_AlarmCode : Word;
      U03_FaultCode : Word;
      U03_AlarmCode : Word;
      U04_FaultCode : Word;
      U04_AlarmCode : Word;
      U05_FaultCode : Word;
      U05_AlarmCode : Word;
      U06_FaultCode : Word;
      U06_AlarmCode : Word;
      U07_FaultCode : Word;
      U07_AlarmCode : Word;
      U08_FaultCode : Word;
      U08_AlarmCode : Word;
      U09_FaultCode : Word;
      U09_AlarmCode : Word;
      U10_FaultCode : Word;
      U10_AlarmCode : Word;
   END_STRUCT;

END_TYPE

