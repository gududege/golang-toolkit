FUNCTION_BLOCK "FB_SINA_SPEED_TEL1"
TITLE = 'Speed Control with SINAMICS and S7'
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : DRVDPS7
FAMILY : DRIVES
NAME : SINA_SPD
VERSION : 5.1
//Copyright (C) Siemens AG 2012. All Rights Reserved. Confidential
//-------------------------------------------------------------------------------------- 
//SINA_SPEED: Drehzahlregelung mit dem Antriebsbaustein SINAMICS S120/G120 <-> S7-1200
//------------------------------------------------------------------------------------- Ersteller: Siemens AG Erlangen A&D MC PM   Datum:  07.07.10        Vers.:2.1
//Änderung:  J.B. Typical Team                       07.12.12              2.2
//    Umsetzung in SCL / TIA 
//Änderung:  J.B. Typical Team                       29.04.13              2.3
//    1. "Q" an den AusgÃ¤nge entfernen
//    2. Neuer Ausgang PwrInhibit
//Änderung:  J.B. Typical Team                       28.06.13              2.4
//    Ã„nderung HW-Zugriff Ã¼ber LOG2MOD
//     
//Änderung:  J.B. Typical Team                       18.07.13              2.5
//    Ã„nderung HW-Zugriff Ã¼ber zwei HW-EingÃ¤nge
//
//Änderung:  J.B. Typical Team                       17.07.14              3.0
//    Optimmierung
//
//Änderung:  J.B. Typical Team                       30.07.14              4.0
//    Festlegung auf einheitlicher neuer Version 4.0
//
//Änderung:  P.Z. Typical Team                       03.12.15              4.1
//    Schnittstelle an Programmierleitfadeb TIA-Potal angepasst
//    zusÃ¤tzlicher Eingang "ConfigAxis" fÃ¼r STW-Bits
//
//Änderung:  G.F. Typical Team                       01.03.16              4.2
//    Sollwert auf INT - Grenzen begrenzt
//Änderung:  F.G. Typical Team                       13.09.16              4.3
//    Ausgabewerte am Ausgang "Status" angepasst 
//
//Änderung:  G.F. Typical Team                       11.01.17              5.0
//    - Festlegung auf einheitlicher neuer Version 5.0 
//
//Änderung:  G.F. Typical Team                       03.05.18              5.1
//    - Alle Bits des Eingang ConfigAxis auf STW1 aufgelegt 
//
//Bibliothek V7
//Funktion: Drehzahlregelung mit dem Antriebsbaustein SINAMICS S120/G120 <-> S7-1200
//********************************************************************************************************************************************************
//************************************************************************FB283***************************************************************************
//********************************************************************************************************************************************************
   VAR_INPUT 
      EnableAxis : Bool;   // 0-->1; 1 = Enable the drive (OFF2 / OFF 3 are 1 in default status) (OFF1 = 0-->1)
      AckError : Bool;   // 1 = Acknowledge drive error
      SpeedSetpoint : Int;   // Speed standardises with the standardisation factor
      RefSpeed : Int;   // Standardisation factor of speed
      Acceleration : Int;   // Ramp up
      Deceleration : Int;   // Ramp down
      RefRampTime : Int;   // Ramp time reference for ref speed
      ConfigAxis : Word := 16#003F;   // binary programmed input to control all functions in the telegram without its own function block input
   END_VAR

   VAR_OUTPUT 
      AxisEnabled : Bool;   // 1 = Drive is enabled
      Lockout : Bool;   // 1 = Drive lockout active
      Fault : Bool;   // 1 = Fault
      Alarm : Bool;   // 1 = Alarm
      ActualSpeed : Int;   // Actual in [U/min]
      FaultCode : Word;
      AlarmCode : Word;
   END_VAR

   VAR_IN_OUT 
      io_HW_Interface : "UDT_G115D_HW_Interface";
   END_VAR

   VAR CONSTANT 
      C_MIN_SCALE : Real := -32768.0;
      C_MAX_SCALE : Real := 32767.0;
   END_VAR


BEGIN
	//=============================================================================
	//SIEMENS AG
	//(c)Copyright 2017 All Rights Reserved
	//-----------------------------------------------------------------------------
	// Library: DriveLib - UDT Updated Version
	// Function: Speed control with SINAMICS using UDT interface
	//=============================================================================
	
	// Evaluate drive status from UDT bits
	#AxisEnabled := #io_HW_Interface.Input.ZSW1_Bit02_Enabled;     // Bit 2: Operation enabled
	#Fault := #io_HW_Interface.Input.ZSW1_Bit03_Fault OR #io_HW_Interface.Input.ZSW_G115D_Bit08_PowerOff;             // Bit 3: Fault
	#Alarm := #io_HW_Interface.Input.ZSW1_Bit07_Alarm;             // Bit 7: Alarm
	#Lockout := #io_HW_Interface.Input.ZSW1_Bit06_Inhibit;         // Bit 6: Switching on inhibited
	#FaultCode := #io_HW_Interface.Input.FaultCode;
	#AlarmCode := #io_HW_Interface.Input.AlarmCode;
	
	// Calculate actual velocity from NIST_A
	IF #RefSpeed <> 0 THEN
	    #ActualSpeed := REAL_TO_INT(INT_TO_REAL(#io_HW_Interface.Input.NIST_A) / 16384.0 * INT_TO_REAL(#RefSpeed));
	ELSE
	    #ActualSpeed := 0;
	END_IF;
	
	// Build control word using UDT unpacked bits
	// STW1 bit mapping using UDT variables instead of slice access
	
	// Bit 0: ON/OFF1 (EnableAxis)
	#io_HW_Interface.Output.STW1_Bit00_On := #EnableAxis;
	
	// Bit 1: OFF2 (from ConfigAxis bit 0, inverted logic: 1=active/no OFF2)
	#io_HW_Interface.Output.STW1_Bit01_Off2 := #ConfigAxis.%X0;
	
	// Bit 2: OFF3 (from ConfigAxis bit 1, inverted logic: 1=active/no OFF3)
	#io_HW_Interface.Output.STW1_Bit02_Off3 := #ConfigAxis.%X1;
	
	// Bit 3: Operation enable (from ConfigAxis bit 2)
	#io_HW_Interface.Output.STW1_Bit03_Enable := #ConfigAxis.%X2;
	
	// Bit 4: Ramp enable (from ConfigAxis bit 3)
	#io_HW_Interface.Output.STW1_Bit04_RampEnable := #ConfigAxis.%X3;
	
	// Bit 5: Ramp continue (from ConfigAxis bit 4)
	#io_HW_Interface.Output.STW1_Bit05_RampContinue := #ConfigAxis.%X4;
	
	// Bit 6: Setpoint enable (from ConfigAxis bit 5)
	#io_HW_Interface.Output.STW1_Bit06_SetEnable := #ConfigAxis.%X5;
	
	// Bit 7: Acknowledge fault
	#io_HW_Interface.Output.STW1_Bit07_Ack := #AckError;
	
	// Bit 8: Reserved (from ConfigAxis bit 10)
	#io_HW_Interface.Output.STW1_Bit08_Reserved := #ConfigAxis.%X10;
	
	// Bit 9: Reserved (from ConfigAxis bit 11)
	#io_HW_Interface.Output.STW1_Bit09_Reserved := #ConfigAxis.%X11;
	
	// Bit 10: Control by PLC (must be TRUE)
	#io_HW_Interface.Output.STW1_Bit10_PLC := TRUE;
	
	// Bit 11: Reverse direction (from ConfigAxis bit 6)
	#io_HW_Interface.Output.STW1_Bit11_Reverse := #ConfigAxis.%X6;
	
	// Bit 12: Reserved (from ConfigAxis bit 7)
	#io_HW_Interface.Output.STW1_Bit12_Reserved := #ConfigAxis.%X7;
	
	// Bit 13: MOP up (from ConfigAxis bit 8)
	#io_HW_Interface.Output.STW1_Bit13_MOP_Up := #ConfigAxis.%X8;
	
	// Bit 14: MOP down (from ConfigAxis bit 9)
	#io_HW_Interface.Output.STW1_Bit14_MOP_Down := #ConfigAxis.%X9;
	
	// Bit 15: Reserved (from ConfigAxis bit 12)
	#io_HW_Interface.Output.STW1_Bit15_Reserved := #ConfigAxis.%X12;
	
	// Calculate velocity setpoint
	IF #RefSpeed <> 0.0 THEN
	    #io_HW_Interface.Output.NSOLL_A := REAL_TO_INT(
	                                                   LIMIT_REAL(MN := #C_MIN_SCALE,
	                                                              IN := INT_TO_REAL(#SpeedSetpoint) * (16384.0 / INT_TO_REAL(#RefSpeed)),
	                                                              MX := #C_MAX_SCALE));
	ELSE
	    #io_HW_Interface.Output.NSOLL_A := 0;
	END_IF;
	
	#io_HW_Interface.Output.RampUpScaling := REAL_TO_INT(
	                                                     LIMIT_REAL(MN := 0,
	                                                                IN := INT_TO_REAL(#RefSpeed) / INT_TO_REAL(#Acceleration) * 1000 / INT_TO_REAL(#RefRampTime) * 16384.0,
	                                                                MX := #C_MAX_SCALE));
	#io_HW_Interface.Output.RampDownScaling := REAL_TO_INT(
	                                                       LIMIT_REAL(MN := 0,
	                                                                  IN := INT_TO_REAL(#RefSpeed) / INT_TO_REAL(#Deceleration) * 1000 / INT_TO_REAL(#RefRampTime) * 16384.0,
	                                                                  MX := #C_MAX_SCALE));
	
END_FUNCTION_BLOCK

FUNCTION "FC_IFM_VFD_G115D_In" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID : HW_SUBMODULE;
      i_Additional_HW_ID : HW_SUBMODULE;
   END_VAR

   VAR_OUTPUT 
      o_Telegram_Start_Address : Int;
      o_ActualValue_Start_Address : Int;
      o_Data : "UDT_G115D_HW_Input";
   END_VAR

   VAR_TEMP 
      t_ZSW1_Word : Word;
      t_ZSW_G115D_Word : Word;
      t_ZSW2_G115D_Word : Word;
      t_Value_Byte : Byte;
      t_Ret_Val_Int : Int;
      t_HW_RD_Inf_Rec_I_Address : UDInt;
      t_HW_RD_Inf_Rec_I_Len : UInt;
      t_HW_WR_Inf_Rec_O_Address : UDInt;
      t_HW_WR_Inf_Rec_O_Len : UInt;
      t_Word_Scale_Data : Word;
   END_VAR

   VAR CONSTANT 
      C_REF_VOLTAGE : Int := 1000;   // [V]
      C_REF_CURRENT : Int := 10;   // [A]
      C_REF_TORQUE : Int := 100;   // [Nm]
      C_REF_POWER : Int := 31420;   // [W]
      C_REF_TEMP : Int := 100;   // [°C]
   END_VAR


BEGIN
	REGION Telegram Module
	    #t_ZSW1_Word := 0;
	   
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Telegram_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_Telegram_Start_Address := UDINT_TO_INT(#t_HW_RD_Inf_Rec_I_Address);
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_RD_Inf_Rec_I_Len = 4 THEN
	        #t_ZSW1_Word := PEEK_WORD(area := 16#81, // Input area
	                                  dbNumber := 0,
	                                  byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address));
	        
	        #o_Data.NIST_A := PEEK_WORD(area := 16#81, // Input area
	                                    dbNumber := 0,
	                                    byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 2);
	    ELSE
	        #o_Data.NIST_A := 0;
	    END_IF;
	    #o_Data.ZSW1_Bit00_ReadyOn := #t_ZSW1_Word.%X0;
	    #o_Data.ZSW1_Bit01_Ready := #t_ZSW1_Word.%X1;
	    #o_Data.ZSW1_Bit02_Enabled := #t_ZSW1_Word.%X2;
	    #o_Data.ZSW1_Bit03_Fault := #t_ZSW1_Word.%X3;
	    #o_Data.ZSW1_Bit04_NoCoastActive := #t_ZSW1_Word.%X4;
	    #o_Data.ZSW1_Bit05_NoQuickStopActive := #t_ZSW1_Word.%X5;
	    #o_Data.ZSW1_Bit06_Inhibit := #t_ZSW1_Word.%X6;
	    #o_Data.ZSW1_Bit07_Alarm := #t_ZSW1_Word.%X7;
	    #o_Data.ZSW1_Bit08_DeviationOK := #t_ZSW1_Word.%X8;
	    #o_Data.ZSW1_Bit09_ControlQuest := #t_ZSW1_Word.%X9;
	    #o_Data.ZSW1_Bit10_OverSpeed := #t_ZSW1_Word.%X10;
	    #o_Data.ZSW1_Bit11_Limit := #t_ZSW1_Word.%X11;
	    #o_Data.ZSW1_Bit12_Brake := #t_ZSW1_Word.%X12;
	    #o_Data.ZSW1_Bit13_MotorTempOK := #t_ZSW1_Word.%X13;
	    #o_Data.ZSW1_Bit14_Direction_CW := #t_ZSW1_Word.%X14;
	    #o_Data.ZSW1_Bit15_VFDTempOK := #t_ZSW1_Word.%X15;
	END_REGION
	
	REGION Actual Value Module
	    #t_ZSW_G115D_Word := 0;
	    #t_ZSW2_G115D_Word := 0;
	    
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Additional_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_ActualValue_Start_Address := UDINT_TO_INT(#t_HW_RD_Inf_Rec_I_Address);
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_RD_Inf_Rec_I_Len = 20 THEN
	        #t_ZSW_G115D_Word := PEEK_WORD(area := 16#81, // Input area
	                                       dbNumber := 0,
	                                       byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address));
	        
	        #o_Data.FaultCode := PEEK_WORD(area := 16#81, // Input area
	                                       dbNumber := 0,
	                                       byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 2);
	        
	        #o_Data.AlarmCode := PEEK_WORD(area := 16#81, // Input area
	                                      dbNumber := 0,
	                                      byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 4);
	        
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81, // Input area
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 6);
	        
	        #o_Data.DCLinkVoltage := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * #C_REF_VOLTAGE / 16#4000);
	        
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81, // Input area
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 8);
	        
	        #o_Data.ActualCurrent := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * #C_REF_CURRENT * 10 / 16#4000);
	        
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81, // Input area
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 10);
	        
	        #o_Data.ActivePower := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * #C_REF_POWER / 16#4000);
	        
	        #t_ZSW2_G115D_Word := PEEK_WORD(area := 16#81, // Input area
	                                       dbNumber := 0,
	                                       byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 12);
	    ELSE
	        #o_Data.FaultCode := 0;
	        #o_Data.AlarmCode := 0;
	        #o_Data.DCLinkVoltage := 0;
	        #o_Data.ActualCurrent := 0;
	        #o_Data.ActivePower := 0;
	    END_IF;
	    #o_Data.ZSW_G115D_Bit00_DI0 := #t_ZSW_G115D_Word.%X0;
	    #o_Data.ZSW_G115D_Bit01_DI1 := #t_ZSW_G115D_Word.%X1;
	    #o_Data.ZSW_G115D_Bit02_DI2 := #t_ZSW_G115D_Word.%X2;
	    #o_Data.ZSW_G115D_Bit03_DI3 := #t_ZSW_G115D_Word.%X3;
	    #o_Data.ZSW_G115D_Bit04_DIO24 := #t_ZSW_G115D_Word.%X4;
	    #o_Data.ZSW_G115D_Bit05_DIO25 := #t_ZSW_G115D_Word.%X5;
	    #o_Data.ZSW_G115D_Bit06_STOActive := #t_ZSW_G115D_Word.%X6;
	    #o_Data.ZSW_G115D_Bit07_Reserved := #t_ZSW_G115D_Word.%X7;
	    #o_Data.ZSW_G115D_Bit08_PowerOff := #t_ZSW_G115D_Word.%X8;
	    #o_Data.ZSW_G115D_Bit09_Auto := #t_ZSW_G115D_Word.%X9;
	    #o_Data.ZSW_G115D_Bit10_Manual := #t_ZSW_G115D_Word.%X10;
	    #o_Data.ZSW_G115D_Bit11_Bypass := #t_ZSW_G115D_Word.%X11;
	    #o_Data.ZSW_G115D_Bit12_ContMotion := #t_ZSW_G115D_Word.%X12;
	    #o_Data.ZSW_G115D_Bit13_JogLeft := #t_ZSW_G115D_Word.%X13;
	    #o_Data.ZSW_G115D_Bit14_JogRight := #t_ZSW_G115D_Word.%X14;
	    #o_Data.ZSW_G115D_Bit15_Reserved := #t_ZSW_G115D_Word.%X15;
	    
	    #o_Data.ZSW2_G115D_Bit00_Memory_Card_In := #t_ZSW2_G115D_Word.%X0;
	    #o_Data.ZSW2_G115D_Bit01_Memory_Card_Active := #t_ZSW2_G115D_Word.%X1;
	    #o_Data.ZSW2_G115D_Bit02_Memory_Card_Siemens := #t_ZSW2_G115D_Word.%X2;
	    #o_Data.ZSW2_G115D_Bit03_Memory_Card_USB := #t_ZSW2_G115D_Word.%X3;
	    #o_Data.ZSW2_G115D_Bit04_Reserved := #t_ZSW2_G115D_Word.%X4;
	    #o_Data.ZSW2_G115D_Bit05_Reserved := #t_ZSW2_G115D_Word.%X5;
	    #o_Data.ZSW2_G115D_Bit06_Reserved := #t_ZSW2_G115D_Word.%X6;
	    #o_Data.ZSW2_G115D_Bit07_Reserved := #t_ZSW2_G115D_Word.%X7;
	    #o_Data.ZSW2_G115D_Bit08_Reserved := #t_ZSW2_G115D_Word.%X8;
	    #o_Data.ZSW2_G115D_Bit09_Reserved := #t_ZSW2_G115D_Word.%X9;
	    #o_Data.ZSW2_G115D_Bit10_Reserved := #t_ZSW2_G115D_Word.%X10;
	    #o_Data.ZSW2_G115D_Bit11_Reserved := #t_ZSW2_G115D_Word.%X11;
	    #o_Data.ZSW2_G115D_Bit12_Reserved := #t_ZSW2_G115D_Word.%X12;
	    #o_Data.ZSW2_G115D_Bit13_Reserved := #t_ZSW2_G115D_Word.%X13;
	    #o_Data.ZSW2_G115D_Bit14_Reserved := #t_ZSW2_G115D_Word.%X14;
	    #o_Data.ZSW2_G115D_Bit15_Reserved := #t_ZSW2_G115D_Word.%X15;
	END_REGION
END_FUNCTION

FUNCTION "FC_IFM_VFD_G115D_Out" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID : HW_SUBMODULE;
      i_Additional_HW_ID : HW_SUBMODULE;
      i_Data : "UDT_G115D_HW_Output";
   END_VAR

   VAR_OUTPUT 
      o_Telegram_Start_Address : Int;
      o_ActualValue_Start_Address : Int;
   END_VAR

   VAR_TEMP 
      t_STW1_Word : Word;
      t_STW_G115D_Word : Word;
      t_Value_Byte : Byte;
      t_Ret_Val_Int : Int;
      t_HW_RD_Inf_Rec_I_Address : UDInt;
      t_HW_RD_Inf_Rec_I_Len : UInt;
      t_HW_WR_Inf_Rec_O_Address : UDInt;
      t_HW_WR_Inf_Rec_O_Len : UInt;
   END_VAR


BEGIN
	REGION Telegram Module
	    #t_STW1_Word := 0;
	    
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Telegram_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_Telegram_Start_Address := UDINT_TO_INT(#t_HW_WR_Inf_Rec_O_Address);
	    
	    #t_STW1_Word.%X0 := #i_Data.STW1_Bit00_On;
	    #t_STW1_Word.%X1 := #i_Data.STW1_Bit01_Off2;
	    #t_STW1_Word.%X2 := #i_Data.STW1_Bit02_Off3;
	    #t_STW1_Word.%X3 := #i_Data.STW1_Bit03_Enable;
	    #t_STW1_Word.%X4 := #i_Data.STW1_Bit04_RampEnable;
	    #t_STW1_Word.%X5 := #i_Data.STW1_Bit05_RampContinue;
	    #t_STW1_Word.%X6 := #i_Data.STW1_Bit06_SetEnable;
	    #t_STW1_Word.%X7 := #i_Data.STW1_Bit07_Ack;
	    #t_STW1_Word.%X8 := #i_Data.STW1_Bit08_Reserved;
	    #t_STW1_Word.%X9 := #i_Data.STW1_Bit09_Reserved;
	    #t_STW1_Word.%X10 := #i_Data.STW1_Bit10_PLC;
	    #t_STW1_Word.%X11 := #i_Data.STW1_Bit11_Reverse;
	    #t_STW1_Word.%X12 := #i_Data.STW1_Bit12_Reserved;
	    #t_STW1_Word.%X13 := #i_Data.STW1_Bit13_MOP_Up;
	    #t_STW1_Word.%X14 := #i_Data.STW1_Bit14_MOP_Down;
	    #t_STW1_Word.%X15 := #i_Data.STW1_Bit15_Reserved;
	    //#t_STW1_Word := SWAP_WORD(#t_STW1_Word);
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_WR_Inf_Rec_O_Len = 4 THEN
	        POKE(area       := 16#82, // Output Area,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address),
	             value      := #t_STW1_Word);
	        
	        POKE(area       := 16#82, // Output Area,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 2,
	             value      := #i_Data.NSOLL_A);
	    END_IF;
	END_REGION
	
	REGION Actual Value Module
	    #t_STW_G115D_Word := 0;
	    
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Additional_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_ActualValue_Start_Address := UDINT_TO_INT(#t_HW_WR_Inf_Rec_O_Address);
	    
	    #t_STW_G115D_Word.%X0 := #i_Data.STW_G115D_Bit00_DO24;
	    #t_STW_G115D_Word.%X1 := #i_Data.STW_G115D_Bit01_DO25;
	    #t_STW_G115D_Word.%X2 := #i_Data.STW_G115D_Bit02_Disable_StopSlow_Sensor;
	    #t_STW_G115D_Word.%X3 := #i_Data.STW_G115D_Bit03_Reserved;
	    #t_STW_G115D_Word.%X4 := #i_Data.STW_G115D_Bit04_Reserved;
	    #t_STW_G115D_Word.%X5 := #i_Data.STW_G115D_Bit05_Reserved;
	    #t_STW_G115D_Word.%X6 := #i_Data.STW_G115D_Bit06_Reserved;
	    #t_STW_G115D_Word.%X7 := #i_Data.STW_G115D_Bit07_Reserved;
	    #t_STW_G115D_Word.%X8 := #i_Data.STW_G115D_Bit08_Reserved;
	    #t_STW_G115D_Word.%X9 := #i_Data.STW_G115D_Bit09_Reserved;
	    #t_STW_G115D_Word.%X10 := #i_Data.STW_G115D_Bit10_Reserved;
	    #t_STW_G115D_Word.%X11 := #i_Data.STW_G115D_Bit11_Reserved;
	    #t_STW_G115D_Word.%X12 := #i_Data.STW_G115D_Bit12_Reserved;
	    #t_STW_G115D_Word.%X13 := #i_Data.STW_G115D_Bit13_Reserved;
	    #t_STW_G115D_Word.%X14 := #i_Data.STW_G115D_Bit14_Reserved;
	    #t_STW_G115D_Word.%X15 := #i_Data.STW_G115D_Bit15_Reserved;
	    //#t_STW_G115D_Word := SWAP_WORD(#t_STW_G115D_Word);
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_WR_Inf_Rec_O_Len = 20 THEN
	        POKE(area       := 16#82, // Output Area,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address),
	             value      := #t_STW_G115D_Word);
	        
	        POKE(area       := 16#82, // Output Area,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 2,
	             value      := #i_Data.RampUpScaling);
	        
	        POKE(area       := 16#82, // Output Area,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 4,
	             value      := #i_Data.RampDownScaling);
	    END_IF;
	END_REGION
END_FUNCTION

FUNCTION "FC_IFM_VFD_S210_Out" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID : HW_SUBMODULE;
      i_Data : "UDT_S210_HW_Output";
   END_VAR

   VAR_OUTPUT 
      o_Telegram_Start_Address : Int;
      o_ActualValue_Start_Address : Int;
   END_VAR

   VAR_TEMP 
      t_STW1_Word : Word;
      t_POS_STW1_Word : Word;
      t_POS_STW2_Word : Word;
      t_STW2_Word : Word;
      t_Value_Byte : Byte;
      t_Ret_Val_Int : Int;
      t_HW_RD_Inf_Rec_I_Address : UDInt;
      t_HW_RD_Inf_Rec_I_Len : UInt;
      t_HW_WR_Inf_Rec_O_Address : UDInt;
      t_HW_WR_Inf_Rec_O_Len : UInt;
   END_VAR


BEGIN
	REGION Telegram Module
	    #t_STW1_Word := 0;
	    #t_POS_STW1_Word := 0;
	    #t_POS_STW2_Word := 0;
	    #t_STW2_Word := 0;
	    
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Telegram_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_Telegram_Start_Address := UDINT_TO_INT(#t_HW_WR_Inf_Rec_O_Address);
	    
	    // Pack STW1 bits
	    #t_STW1_Word.%X0 := #i_Data.STW1_Bit00_On;
	    #t_STW1_Word.%X1 := #i_Data.STW1_Bit01_Off2;
	    #t_STW1_Word.%X2 := #i_Data.STW1_Bit02_Off3;
	    #t_STW1_Word.%X3 := #i_Data.STW1_Bit03_Enable;
	    #t_STW1_Word.%X4 := #i_Data.STW1_Bit04_NotRejectTask;
	    #t_STW1_Word.%X5 := #i_Data.STW1_Bit05_NoIntermediateStop;
	    #t_STW1_Word.%X6 := #i_Data.STW1_Bit06_ActivateTask;
	    #t_STW1_Word.%X7 := #i_Data.STW1_Bit07_Ack;
	    #t_STW1_Word.%X8 := #i_Data.STW1_Bit08_Jog1;
	    #t_STW1_Word.%X9 := #i_Data.STW1_Bit09_Jog2;
	    #t_STW1_Word.%X10 := #i_Data.STW1_Bit10_PLC;
	    #t_STW1_Word.%X11 := #i_Data.STW1_Bit11_StartHoming;
	    #t_STW1_Word.%X12 := #i_Data.STW1_Bit12_Reserved;
	    #t_STW1_Word.%X13 := #i_Data.STW1_Bit13_ExtBlockChange;
	    #t_STW1_Word.%X14 := #i_Data.STW1_Bit14_Reserved;
	    #t_STW1_Word.%X15 := #i_Data.STW1_Bit15_Reserved;
	    
	    // Pack POS_STW1 bits
	    #t_POS_STW1_Word.%X0 := #i_Data.POS_STW1_Bit00_Traversing0;
	    #t_POS_STW1_Word.%X1 := #i_Data.POS_STW1_Bit01_Traversing1;
	    #t_POS_STW1_Word.%X2 := #i_Data.POS_STW1_Bit02_Traversing2;
	    #t_POS_STW1_Word.%X3 := #i_Data.POS_STW1_Bit03_Traversing3;
	    #t_POS_STW1_Word.%X4 := #i_Data.POS_STW1_Bit04_Traversing4;
	    #t_POS_STW1_Word.%X5 := #i_Data.POS_STW1_Bit05_Traversing5;
	    #t_POS_STW1_Word.%X6 := #i_Data.POS_STW1_Bit06_Reserved;
	    #t_POS_STW1_Word.%X7 := #i_Data.POS_STW1_Bit07_ReleaseBrake;
	    #t_POS_STW1_Word.%X8 := #i_Data.POS_STW1_Bit08_Absolute;
	    #t_POS_STW1_Word.%X9 := #i_Data.POS_STW1_Bit09_DirPos;
	    #t_POS_STW1_Word.%X10 := #i_Data.POS_STW1_Bit10_DirNeg;
	    #t_POS_STW1_Word.%X11 := #i_Data.POS_STW1_Bit11_Reserved;
	    #t_POS_STW1_Word.%X12 := #i_Data.POS_STW1_Bit12_Continuous;
	    #t_POS_STW1_Word.%X13 := #i_Data.POS_STW1_Bit13_Reserved;
	    #t_POS_STW1_Word.%X14 := #i_Data.POS_STW1_Bit14_SetupOrPositioning;
	    #t_POS_STW1_Word.%X15 := #i_Data.POS_STW1_Bit15_ActivateMDI;
	    
	    // Pack POS_STW2 bits
	    #t_POS_STW2_Word.%X0 := #i_Data.POS_STW2_Bit00_ActivateFollowUp;
	    #t_POS_STW2_Word.%X1 := #i_Data.POS_STW2_Bit01_SetRefPoint;
	    #t_POS_STW2_Word.%X2 := #i_Data.POS_STW2_Bit02_RefCam;
	    #t_POS_STW2_Word.%X3 := #i_Data.POS_STW2_Bit03_AdjustEncoder;
	    #t_POS_STW2_Word.%X4 := #i_Data.POS_STW2_Bit04_Reserved;
	    #t_POS_STW2_Word.%X5 := #i_Data.POS_STW2_Bit05_JogIncrementalOrVelocity;
	    #t_POS_STW2_Word.%X6 := #i_Data.POS_STW2_Bit06_Reserved;
	    #t_POS_STW2_Word.%X7 := #i_Data.POS_STW2_Bit07_Reserved;
	    #t_POS_STW2_Word.%X8 := #i_Data.POS_STW2_Bit08_RefType;
	    #t_POS_STW2_Word.%X9 := #i_Data.POS_STW2_Bit09_RefNegDir;
	    #t_POS_STW2_Word.%X10 := #i_Data.POS_STW2_Bit10_MeasProbe2;
	    #t_POS_STW2_Word.%X11 := #i_Data.POS_STW2_Bit11_MeasProbeEdge;
	    #t_POS_STW2_Word.%X12 := #i_Data.POS_STW2_Bit12_Reserved;
	    #t_POS_STW2_Word.%X13 := #i_Data.POS_STW2_Bit13_Reserved;
	    #t_POS_STW2_Word.%X14 := #i_Data.POS_STW2_Bit14_SWLimit;
	    #t_POS_STW2_Word.%X15 := #i_Data.POS_STW2_Bit15_StopCam;
	    
	    // Pack STW2 bits
	    #t_STW2_Word.%X0 := #i_Data.STW2_Bit00_Reserved;
	    #t_STW2_Word.%X1 := #i_Data.STW2_Bit01_Reserved;
	    #t_STW2_Word.%X2 := #i_Data.STW2_Bit02_Reserved;
	    #t_STW2_Word.%X3 := #i_Data.STW2_Bit03_Reserved;
	    #t_STW2_Word.%X4 := #i_Data.STW2_Bit04_Reserved;
	    #t_STW2_Word.%X5 := #i_Data.STW2_Bit05_Reserved;
	    #t_STW2_Word.%X6 := #i_Data.STW2_Bit06_Reserved;
	    #t_STW2_Word.%X7 := #i_Data.STW2_Bit07_Reserved;
	    #t_STW2_Word.%X8 := #i_Data.STW2_Bit08_Reserved;
	    #t_STW2_Word.%X9 := #i_Data.STW2_Bit09_Reserved;
	    #t_STW2_Word.%X10 := #i_Data.STW2_Bit10_Reserved;
	    #t_STW2_Word.%X11 := #i_Data.STW2_Bit11_Reserved;
	    #t_STW2_Word.%X12 := #i_Data.STW2_Bit12_Reserved;
	    #t_STW2_Word.%X13 := #i_Data.STW2_Bit13_Reserved;
	    #t_STW2_Word.%X14 := #i_Data.STW2_Bit14_Reserved;
	    #t_STW2_Word.%X15 := #i_Data.STW2_Bit15_Reserved;
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_WR_Inf_Rec_O_Len = 34 THEN
	        // PZD1: STW1
	        POKE(area       := 16#82, // Output Area
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address),
	             value      := #t_STW1_Word);
	        
	        // PZD2: POS_STW1
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 2,
	             value      := #t_POS_STW1_Word);
	        
	        // PZD3: POS_STW2
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 4,
	             value      := #t_POS_STW2_Word);
	        
	        // PZD4: STW2
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 6,
	             value      := #t_STW2_Word);
	        
	        // PZD5: Override (Int)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 8,
	             value      := INT_TO_WORD(#i_Data.Override));
	        
	        // PZD6-7: MDI_TARPOS (Real/Float32)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 10,
	             value      := REAL_TO_DWORD(#i_Data.MDI_TARPOS));
	        
	        // PZD8-9: MDI_VELOCITY (Real/Float32)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 14,
	             value      := REAL_TO_DWORD(#i_Data.MDI_VELOCITY));
	        
	        // PZD10-11: MDI_ACC (Real/Float32)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 18,
	             value      := REAL_TO_DWORD(#i_Data.MDI_ACC));
	        
	        // PZD12-13: MDI_DEC (Real/Float32)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 22,
	             value      := REAL_TO_DWORD(#i_Data.MDI_DEC));
	        
	        // PZD14-15: Reserved (Real/Float32)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 26,
	             value      := REAL_TO_DWORD(#i_Data.Reserved));
	        
	        // PZD16-17: REF_COORDINATE (Real/Float32)
	        POKE(area       := 16#82,
	             dbNumber   := 0,
	             byteOffset := UDINT_TO_DINT(#t_HW_WR_Inf_Rec_O_Address) + 30,
	             value      := REAL_TO_DWORD(#i_Data.REF_COORDINATE));
	    END_IF;
	END_REGION
END_FUNCTION

FUNCTION "FC_Delay_Off" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CMD_Start : Bool;
      i_CFG_Target : Int;
      i_Cycle_Count : Int;
   END_VAR

   VAR_OUTPUT 
      o_Delay_Finish : Bool;
   END_VAR

   VAR_IN_OUT 
      io_Setpoint : Int;
   END_VAR


BEGIN
	// Init time value
	IF #i_CMD_Start THEN
	    #io_Setpoint := #i_CFG_Target;
	END_IF;
	
	// Detect result
	#o_Delay_Finish := #i_CMD_Start OR (NOT #i_CMD_Start AND #io_Setpoint > 0);
	
	// Count time value
	IF NOT #i_CMD_Start THEN
	    #io_Setpoint := #io_Setpoint - #i_Cycle_Count;
	    IF #io_Setpoint < 0 THEN
	        #io_Setpoint := 0;
	    END_IF;
	END_IF;
END_FUNCTION

FUNCTION "FC_Delay_On" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CMD_Start : Bool;
      i_CFG_Target : Int;
      i_Cycle_Count : Int;
   END_VAR

   VAR_OUTPUT 
      o_Delay_Finish : Bool;
   END_VAR

   VAR_IN_OUT 
      io_Setpoint : Int;
   END_VAR


BEGIN
	// Init time value
	IF NOT #i_CMD_Start THEN
	    #io_Setpoint := 0;
	END_IF;
	
	// Detect result
	#o_Delay_Finish := #i_CMD_Start AND #io_Setpoint >= #i_CFG_Target;
	
	// Count time value
	IF #i_CMD_Start THEN
	    #io_Setpoint := #io_Setpoint + #i_Cycle_Count;
	    IF #io_Setpoint > #i_CFG_Target THEN
	        #io_Setpoint := #i_CFG_Target;
	    END_IF;
	END_IF;
END_FUNCTION

FUNCTION "FC_IFM_VFD_S210_In" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID : HW_SUBMODULE;
      i_Additional_HW_ID : HW_SUBMODULE;
   END_VAR

   VAR_OUTPUT 
      o_Telegram_Start_Address : Int;
      o_ActualValue_Start_Address : Int;
      o_Data : "UDT_S210_HW_Input";
   END_VAR

   VAR_TEMP 
      t_ZSW1_Word : Word;
      t_POS_ZSW1_Word : Word;
      t_POS_ZSW2_Word : Word;
      t_ZSW2_Word : Word;
      t_ZSW_S210_Word : Word;
      t_Value_Byte : Byte;
      t_Ret_Val_Int : Int;
      t_HW_RD_Inf_Rec_I_Address : UDInt;
      t_HW_RD_Inf_Rec_I_Len : UInt;
      t_HW_WR_Inf_Rec_O_Address : UDInt;
      t_HW_WR_Inf_Rec_O_Len : UInt;
      t_Word_Scale_Data : Word;
   END_VAR

   VAR CONSTANT 
      C_REF_FREQUENCY : Int := 6000;   // [rpm]
      C_REF_VOLTAGE : Int := 1000;   // [V]
      C_REF_CURRENT : Int := 10;   // [A]
      C_REF_TORQUE : Int := 100;   // [Nm]
      C_REF_POWER : Int := 31;   // [W]
      C_REF_TEMP : Int := 100;   // [°C]
   END_VAR


BEGIN
	REGION Telegram Module
	    #t_ZSW1_Word := 0;
	    #t_POS_ZSW1_Word := 0;
	    #t_POS_ZSW2_Word := 0;
	    #t_ZSW2_Word := 0;
	    
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Telegram_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_Telegram_Start_Address := UDINT_TO_INT(#t_HW_RD_Inf_Rec_I_Address);
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_RD_Inf_Rec_I_Len = 24 THEN
	        // PZD1: ZSW1 (Word)
	        #t_ZSW1_Word := PEEK_WORD(area := 16#81, // Input area
	                                  dbNumber := 0,
	                                  byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address));
	        
	        // PZD2: POS_ZSW1 (Word)
	        #t_POS_ZSW1_Word := PEEK_WORD(area := 16#81,
	                                      dbNumber := 0,
	                                      byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 2);
	        
	        // PZD3: POS_ZSW2 (Word)
	        #t_POS_ZSW2_Word := PEEK_WORD(area := 16#81,
	                                      dbNumber := 0,
	                                      byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 4);
	        
	        // PZD4: ZSW2 (Word)
	        #t_ZSW2_Word := PEEK_WORD(area := 16#81,
	                                  dbNumber := 0,
	                                  byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 6);
	        
	        // PZD5: Reserved (Int)
	        #o_Data.Reserved := 0;
	        
	        // PZD6-7: XIST (Real/Float32) - Position actual value
	        #o_Data.XIST := DWORD_TO_REAL(PEEK_DWORD(area := 16#81,
	                                                                               dbNumber := 0,
	                                                                               byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 10));
	        
	        // PZD8-9: VIST (Real/Float32) - Velocity actual value
	        #o_Data.VIST := DWORD_TO_REAL(PEEK_DWORD(area := 16#81,
	                                                                               dbNumber := 0,
	                                                                               byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 14));
	        
	        // PZD10: MELDW (Word)
	        #o_Data.MELDW_Bit00_PositioningAbsolute := FALSE; // MELDW reserved in telegram 112
	        
	        // PZD11: FaultCode (Word)
	        #o_Data.FaultCode := PEEK_WORD(area := 16#81,
	                                       dbNumber := 0,
	                                       byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 20);
	        
	        // PZD12: AlarmCode (Word)
	        #o_Data.AlarmCode := PEEK_WORD(area := 16#81,
	                                      dbNumber := 0,
	                                      byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 22);
	    ELSE
	        #o_Data.XIST := 0.0;
	        #o_Data.VIST := 0.0;
	        #o_Data.FaultCode := 0;
	        #o_Data.AlarmCode := 0;
	    END_IF;
	    
	    // Unpack ZSW1 bits
	    #o_Data.ZSW1_Bit00_ReadyOn := #t_ZSW1_Word.%X0;
	    #o_Data.ZSW1_Bit01_Ready := #t_ZSW1_Word.%X1;
	    #o_Data.ZSW1_Bit02_Enabled := #t_ZSW1_Word.%X2;
	    #o_Data.ZSW1_Bit03_Fault := #t_ZSW1_Word.%X3;
	    #o_Data.ZSW1_Bit04_Off2Inactive := #t_ZSW1_Word.%X4;
	    #o_Data.ZSW1_Bit05_Off3Inactive := #t_ZSW1_Word.%X5;
	    #o_Data.ZSW1_Bit06_Inhibit := #t_ZSW1_Word.%X6;
	    #o_Data.ZSW1_Bit07_Alarm := #t_ZSW1_Word.%X7;
	    #o_Data.ZSW1_Bit08_FollowingOK := #t_ZSW1_Word.%X8;
	    #o_Data.ZSW1_Bit09_Control := #t_ZSW1_Word.%X9;
	    #o_Data.ZSW1_Bit10_TargetReached := #t_ZSW1_Word.%X10;
	    #o_Data.ZSW1_Bit11_HomeSet := #t_ZSW1_Word.%X11;
	    #o_Data.ZSW1_Bit12_AckActive := #t_ZSW1_Word.%X12;
	    #o_Data.ZSW1_Bit13_SetpointFixed := #t_ZSW1_Word.%X13;
	    #o_Data.ZSW1_Bit14_AxisAccel := #t_ZSW1_Word.%X14;
	    #o_Data.ZSW1_Bit15_AxisDecel := #t_ZSW1_Word.%X15;
	    
	    // Unpack POS_ZSW1 bits
	    #o_Data.POS_ZSW1_Bit00_Active0 := #t_POS_ZSW1_Word.%X0;
	    #o_Data.POS_ZSW1_Bit01_Active1 := #t_POS_ZSW1_Word.%X1;
	    #o_Data.POS_ZSW1_Bit02_Active2 := #t_POS_ZSW1_Word.%X2;
	    #o_Data.POS_ZSW1_Bit03_Active3 := #t_POS_ZSW1_Word.%X3;
	    #o_Data.POS_ZSW1_Bit04_Active4 := #t_POS_ZSW1_Word.%X4;
	    #o_Data.POS_ZSW1_Bit05_Active5 := #t_POS_ZSW1_Word.%X5;
	    #o_Data.POS_ZSW1_Bit06_Reserved := #t_POS_ZSW1_Word.%X6;
	    #o_Data.POS_ZSW1_Bit07_ReleaseBrake := #t_POS_ZSW1_Word.%X7;
	    #o_Data.POS_ZSW1_Bit08_StopCamMinus := #t_POS_ZSW1_Word.%X8;
	    #o_Data.POS_ZSW1_Bit09_StopCamPlus := #t_POS_ZSW1_Word.%X9;
	    #o_Data.POS_ZSW1_Bit10_JogActive := #t_POS_ZSW1_Word.%X10;
	    #o_Data.POS_ZSW1_Bit11_RefApproach := #t_POS_ZSW1_Word.%X11;
	    #o_Data.POS_ZSW1_Bit12_FlyingHoming := #t_POS_ZSW1_Word.%X12;
	    #o_Data.POS_ZSW1_Bit13_Traversing := #t_POS_ZSW1_Word.%X13;
	    #o_Data.POS_ZSW1_Bit14_Setup := #t_POS_ZSW1_Word.%X14;
	    #o_Data.POS_ZSW1_Bit15_MDI := #t_POS_ZSW1_Word.%X15;
	    
	    // Unpack POS_ZSW2 bits
	    #o_Data.POS_ZSW2_Bit00_Tracking := #t_POS_ZSW2_Word.%X0;
	    #o_Data.POS_ZSW2_Bit01_VelLimit := #t_POS_ZSW2_Word.%X1;
	    #o_Data.POS_ZSW2_Bit02_TargetReached := #t_POS_ZSW2_Word.%X2;
	    #o_Data.POS_ZSW2_Bit03_PrintMark := #t_POS_ZSW2_Word.%X3;
	    #o_Data.POS_ZSW2_Bit04_Forward := #t_POS_ZSW2_Word.%X4;
	    #o_Data.POS_ZSW2_Bit05_Backward := #t_POS_ZSW2_Word.%X5;
	    #o_Data.POS_ZSW2_Bit06_SWLimitMinus := #t_POS_ZSW2_Word.%X6;
	    #o_Data.POS_ZSW2_Bit07_SWLimitPlus := #t_POS_ZSW2_Word.%X7;
	    #o_Data.POS_ZSW2_Bit08_Cam1 := #t_POS_ZSW2_Word.%X8;
	    #o_Data.POS_ZSW2_Bit09_Cam2 := #t_POS_ZSW2_Word.%X9;
	    #o_Data.POS_ZSW2_Bit10_Output1 := #t_POS_ZSW2_Word.%X10;
	    #o_Data.POS_ZSW2_Bit11_Output2 := #t_POS_ZSW2_Word.%X11;
	    #o_Data.POS_ZSW2_Bit12_FixedStop := #t_POS_ZSW2_Word.%X12;
	    #o_Data.POS_ZSW2_Bit13_Clamping := #t_POS_ZSW2_Word.%X13;
	    #o_Data.POS_ZSW2_Bit14_TravelFixed := #t_POS_ZSW2_Word.%X14;
	    #o_Data.POS_ZSW2_Bit15_TraversingCmd := #t_POS_ZSW2_Word.%X15;
	    
	    // Unpack ZSW2 bits
	    #o_Data.ZSW2_Bit00_Reserved := #t_ZSW2_Word.%X0;
	    #o_Data.ZSW2_Bit01_Reserved := #t_ZSW2_Word.%X1;
	    #o_Data.ZSW2_Bit02_Reserved := #t_ZSW2_Word.%X2;
	    #o_Data.ZSW2_Bit03_Reserved := #t_ZSW2_Word.%X3;
	    #o_Data.ZSW2_Bit04_Reserved := #t_ZSW2_Word.%X4;
	    #o_Data.ZSW2_Bit05_Reserved := #t_ZSW2_Word.%X5;
	    #o_Data.ZSW2_Bit06_Reserved := #t_ZSW2_Word.%X6;
	    #o_Data.ZSW2_Bit07_Reserved := #t_ZSW2_Word.%X7;
	    #o_Data.ZSW2_Bit08_Reserved := #t_ZSW2_Word.%X8;
	    #o_Data.ZSW2_Bit09_Reserved := #t_ZSW2_Word.%X9;
	    #o_Data.ZSW2_Bit10_Reserved := #t_ZSW2_Word.%X10;
	    #o_Data.ZSW2_Bit11_Reserved := #t_ZSW2_Word.%X11;
	    #o_Data.ZSW2_Bit12_Reserved := #t_ZSW2_Word.%X12;
	    #o_Data.ZSW2_Bit13_Reserved := #t_ZSW2_Word.%X13;
	    #o_Data.ZSW2_Bit14_Reserved := #t_ZSW2_Word.%X14;
	    #o_Data.ZSW2_Bit15_Reserved := #t_ZSW2_Word.%X15;
	END_REGION
	
	REGION Actual Value Module (Extended Data)
	    #t_ZSW_S210_Word := 0;
	    
	    #t_Ret_Val_Int := RD_ADDR(LADDR := #i_Additional_HW_ID,
	                              PIADDR => #t_HW_RD_Inf_Rec_I_Address,
	                              PICount => #t_HW_RD_Inf_Rec_I_Len,
	                              PQADDR => #t_HW_WR_Inf_Rec_O_Address,
	                              PQCount => #t_HW_WR_Inf_Rec_O_Len);
	    
	    #o_ActualValue_Start_Address := UDINT_TO_INT(#t_HW_RD_Inf_Rec_I_Address);
	    
	    IF #t_Ret_Val_Int = 0 AND #t_HW_RD_Inf_Rec_I_Len = 12 THEN
	        // Read ZSW_S210 (DI status word)
	        #t_ZSW_S210_Word := PEEK_WORD(area := 16#81, // Input area
	                                      dbNumber := 0,
	                                      byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address));
	        
	        // Read DC Link Voltage (Int)
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81,
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 2);
	        
	        #o_Data.DCLinkVoltage := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * #C_REF_VOLTAGE / 16#4000);
	        
	        // Read Actual Current (Int)
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81,
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 4);
	        
	        #o_Data.ActualCurrent := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * #C_REF_CURRENT * 10 / 16#4000);
	        
	        // Read Active Power (Int)
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81,
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 6);
	        
	        #o_Data.ActivePower := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * #C_REF_POWER / 16#4000);
	        
	        // Read Active Utilization (Int)
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81,
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 8);
	        
	        #o_Data.TorqueUtilization := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * 100 / 16#4000);
	        
	        // Read Motor Load Rate (Int)
	        #t_Word_Scale_Data := PEEK_WORD(area := 16#81,
	                                        dbNumber := 0,
	                                        byteOffset := UDINT_TO_DINT(#t_HW_RD_Inf_Rec_I_Address) + 10);
	        
	        #o_Data.MotorUtilization := DINT_TO_INT(WORD_TO_DINT(#t_Word_Scale_Data) * 100 / 16#4000);
	    ELSE
	        #o_Data.DCLinkVoltage := 0;
	        #o_Data.ActualCurrent := 0;
	        #o_Data.ActivePower := 0;
	        #o_Data.TorqueUtilization := 0;
	        #o_Data.MotorUtilization := 0;
	    END_IF;
	    
	    // Unpack ZSW_S210 bits (DI status)
	    #o_Data.ZSW_S210_Bit00_DI0 := #t_ZSW_S210_Word.%X0;
	    #o_Data.ZSW_S210_Bit01_DI1 := #t_ZSW_S210_Word.%X1;
	    #o_Data.ZSW_S210_Bit02_DI2 := #t_ZSW_S210_Word.%X2;
	    #o_Data.ZSW_S210_Bit03_DI3 := #t_ZSW_S210_Word.%X3;
	    #o_Data.ZSW_S210_Bit04_DI4 := #t_ZSW_S210_Word.%X4;
	    #o_Data.ZSW_S210_Bit05_Reserved := #t_ZSW_S210_Word.%X5;
	    #o_Data.ZSW_S210_Bit06_Reserved := #t_ZSW_S210_Word.%X6;
	    #o_Data.ZSW_S210_Bit07_Reserved := #t_ZSW_S210_Word.%X7;
	    #o_Data.ZSW_S210_Bit08_Reserved := #t_ZSW_S210_Word.%X8;
	    #o_Data.ZSW_S210_Bit09_Reserved := #t_ZSW_S210_Word.%X9;
	    #o_Data.ZSW_S210_Bit10_Reserved := #t_ZSW_S210_Word.%X10;
	    #o_Data.ZSW_S210_Bit11_Reserved := #t_ZSW_S210_Word.%X11;
	    #o_Data.ZSW_S210_Bit12_Reserved := #t_ZSW_S210_Word.%X12;
	    #o_Data.ZSW_S210_Bit13_Reserved := #t_ZSW_S210_Word.%X13;
	    #o_Data.ZSW_S210_Bit14_Reserved := #t_ZSW_S210_Word.%X14;
	    #o_Data.ZSW_S210_Bit15_Reserved := #t_ZSW_S210_Word.%X15;
	END_REGION
END_FUNCTION

TYPE "UDT_S210_SW_Output"
VERSION : 0.1
   STRUCT
      AxisEnabled : Bool;   // 驱动已使能
      AxisPosOk : Bool;   // 目标位置到达
      AxisSpFixed : Bool;   // 设定位置到达
      AxisRef : Bool;   // 已设置参考点
      AxisWarn : Bool;   // 驱动报警
      AxisError : Bool;   // 驱动故障
      Lockout : Bool;   // 禁止接通
      ActVelocity : Real;   // 实际速度
      ActPosition : Real;   // 当前位置
      ActMode : Int;   // 当前激活的运行模式
      EPosZSW1 : Word;   // POS ZSW1的状态
      EPosZSW2 : Word;   // POS ZSW2的状态
      AlarmCode : Word;   // 驱动器当前的报警代码
      FaultCode : Word;   // 驱动器当前的故障代码
      ZSW1 : Word;   // ZSW1的状态
      ZSW2 : Word;   // ZSW2的状态
      MELDW : Word;   // MELDW的状态
      Error : Bool;   // 1=存在错误
      Status : Word;   // 16#7002：无故障，正常运行
      DiagID : Word;   // 扩展的通信错误
   END_STRUCT;

END_TYPE

TYPE "UDT_S210_SW_Input"
VERSION : 0.1
   STRUCT
      Mode : Int;
      Enbale : Bool;
      CancelTraversing : Bool;
      IntermediateStop : Bool;
      Positive : Bool;
      Negative : Bool;
      Jog_Left : Bool;
      Jog_Right : Bool;
      FlyRef : Bool;
      AckError : Bool;
      ExecuteMode : Bool;
      Position : Real;
      Velocity : Real;
      OverV : Int;
      Acceleration : Real;
      Deceleration : Real;
      FixStopTorque : Real;
      RefCoordinate : Real;
      ConfigEPOS : DWord;
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_SINA_POS_TEL112"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.2
   VAR_INPUT 
      modePos : Int;   // Settings of the mode
      enableAxis : Bool;   // 1 = Enable the drive
      cancelTraversing : Bool := TRUE;   // 0 = Reject active traverse task
      intermediateStop : Bool := TRUE;   // 0 = Intermediate STOP of traverse command
      positive : Bool;   // 1 = Direction positive
      negative : Bool;   // 1 = Direction negative
      jog1 : Bool;   // 1 = Use jog 1 (direction / speed)
      jog2 : Bool;   // 1 = Use jog 2 (direction / speed)
      flyRef : Bool;   // 1 = Start flying reference function
      ackError : Bool;   // 1  = Acknowledge of errors
      executeMode : Bool;   // 0-->1 = Start the mode
      position : Real;   // Position of the MDI mode or setting of traversing block
      velocity : Real;   // MDI velocity
      overV : Int := 100;   // Override of  velocity in [%] --> 4000h=100%
      acceleration : Real;   // MDI acceleration
      deceleration : Real;   // MDI deceleration
      fixStopTorque : Real;   // torque setting for fix stop function (reserved)
      refCoordinate : Real;
      configEPOS : DWord := 16#0000_0003;   // binary programmed input to control all functions in the telegram without its own function block input
   END_VAR

   VAR_OUTPUT 
      axisEnabled : Bool;   // 1= Axis in operation
      axisPosOk : Bool;   // 1= Position setpoint reached
      axisSpFixed : Bool;   // 1= Setpoint fixed (Attention: Dependence on SINAMICS firmware)
      axisRef : Bool;   // 1= Reference point set
      axisWarn : Bool;   // 1= Axis alarm / warning present
      axisError : Bool;   // 1= Axis fault present
      lockOut : Bool;   // 1= Axis in lockout state
      actVelocity : Real;   // actual axis velocity
      actPosition : Real;   // actual axis position
      actMode : Int;   // Active EPos mode
      actWarn : Word;   // Actual number of warning
      actFault : Word;   // Actual number of error
      error : Bool;   // 1 = Error  (FB and Infeed)
      status : Word;   // Status output (7002 = FB in operation; 8xxx = error description  - read the manual)
      diagID : Word;   // Error codes of the cyclic system funtion blocks DPWR / DPRD_DAT (固定为0)
   END_VAR

   VAR_IN_OUT 
      InputData : "UDT_S210_HW_Input";   // 从驱动器接收的数据
      OutputData : "UDT_S210_HW_Output";   // 发送到驱动器的数据
   END_VAR

   VAR 
      sbOff1Edge : Bool := 0;   // Positive edge of starting or stopping the device
      sbOff1 : Bool := 0;   // Starting or stopping the device
      sbExecuteEdge : Bool := 0;   // Positive edge of activate traversing block
      sbExecute : Bool := 0;   // Activate traversing block
      sbRefTypEdge : Bool := 0;   // Positive edge of referencing type "flying reference"
      sbRefTyp : Bool := 0;   // Referencing type "flying reference"
      sbMdiStart : Bool := 0;   // Direct setpoint input / MDI - start
      sbMdiStartEdge : Bool := 0;   // Positive edge of direct setpoint input / MDI - start
      sbRefStart : Bool := 0;   // Referencing start
      sbJogInc : Bool := 0;   // Jogging incremental
      sbReady : Bool := 0;   // Ready to power up / to start
      sbIOp : Bool := 0;   // Ready to operate
      sbAccel : Bool := 0;   // Axis accelerating
      sbDecel : Bool := 0;   // Axis decelerating
      sbAlarm : Bool := 0;   // Alarm / Warnung present
      sbFault : Bool := 0;   // Fault present
      sbFWD : Bool := 0;   // Axis drives forwards
      sbBWD : Bool := 0;   // Axis drives backwards
      sbBusy : Bool := 0;   // Mode of operation is explained
      swStatus : Word := 16#0000;   // Mode of operation disturbance
      siExecuteCyc : Int := 0;   // Counter of runcycle of active traversing block
      siRefTypCyc : Int := 0;   // Counter of runcycle of referencing type "flying reference"
      siJogIncCyc : Int := 0;   // Counter of runcycle of jogging incremental
      siMdiStartCyc : Int := 0;   // Counter of runcycle of direct setpoint input / MDI - start
      siRefActRetry : Int := 0;   // Counter of retry of reference point approach active
      siModePos : Int := 0;   // Setting of mode
      siCycWait : Int := 5;   // Counter of cycle of waiting
      siRetryMax : Int := 30;   // Max. count of cycles of retry
      sbModePos : Bool := 0;   // Mode of setting okay
   END_VAR

   VAR CONSTANT 
      MODEPOSMAX : Int := 9;   // Max. count of mode
      TRAVERSEBLOCKMAXNO : Int := 32;   // Max. number of traversing block
   END_VAR


BEGIN
	//=============================================================================
	//SIEMENS AG
	//(c)Copyright 2023 All Rights Reserved
	//-----------------------------------------------------------------------------
	// Library: DriveLib
	// Tested with: -
	// Engineering: TIA Portal V18
	// Restrictions: -
	// Requirements: S7-1200 / S7-1500
	// Functionality: cyclic communication between a SINAMICS (Basic positioner)and a PLC
	//                If in HWConfig Std.TLG 112 is projected 17/12 PZD-words are exchanged
	//                in every bus cycle.
	//                The parametrisation of these words is described in the manual of the
	//                SINAMICS
	// Contactor: mc_gmc_mp_asia.cn@siemens.com
	// *****************************************************************************
	// Version:
	// V0.0: Created
	// V0.2: 重构 - 移除DPWR/DPRD，改用外部UDT (UDT_S210_HW_Output/Input)
	//=============================================================================
	
	// The input of the modePos should between 1 and the MODEPOSMAX
	IF #modePos > #MODEPOSMAX OR #modePos < 1 THEN
	    #sbModePos := FALSE;
	    #error := True;
	    #swStatus := 16#8202;
	ELSE
	    IF NOT #sbFWD AND NOT #sbBWD AND NOT #sbAccel AND NOT #sbDecel THEN
	        #sbModePos := TRUE;
	        #siModePos := #modePos;
	        IF #swStatus = 16#8202 THEN
	            #swStatus := 16#7002;
	            #error := False;
	        END_IF;
	    END_IF;
	END_IF;
	
	// Check the overrider setting
	IF (#overV < 0) OR (#overV > 199) THEN
	    #swStatus := 16#8203;
	    #error := True;
	ELSE
	    // Override映射到OutputData.Override (Int类型，0-16384对应0-100%)
	    #OutputData.Override := REAL_TO_INT(16384.0 * (INT_TO_REAL(#overV) / 100.0));
	END_IF;
	
	// Check the acceleration and deceleration setting
	IF #acceleration < 0.0 THEN
	    #swStatus := 16#8203;
	    #error := True;
	ELSE
	    #OutputData.MDI_ACC := #acceleration;
	END_IF;
	IF #deceleration < 0.0 THEN
	    #swStatus := 16#8203;
	    #error := True;
	ELSE
	    #OutputData.MDI_DEC := #deceleration;
	END_IF;
	IF NOT (#overV < 0) AND NOT (#overV > 199) AND NOT (#acceleration < 0.0) AND NOT (#deceleration < 0.0) THEN
	    IF #swStatus = 16#8203 THEN
	        #swStatus := 16#7002;
	        #error := FALSE;
	    END_IF;
	END_IF;
	
	// 位置、速度、参考坐标直接映射
	#OutputData.MDI_TARPOS := #position;
	#OutputData.MDI_VELOCITY := #velocity;
	#OutputData.REF_COORDINATE := #refCoordinate;
	
	// Enable the axis
	IF #enableAxis AND NOT #sbOff1Edge AND NOT #sbBusy AND #sbModePos THEN
	    #sbOff1 := True;
	END_IF;
	#sbOff1Edge := #enableAxis AND NOT #sbBusy;
	IF NOT #enableAxis THEN
	    #sbOff1 := False;
	END_IF;
	
	// Flying reference
	IF #flyRef AND NOT #sbRefTypEdge THEN
	    #sbRefTyp := True;
	END_IF;
	#sbRefTypEdge := #flyRef;
	IF NOT #flyRef THEN
	    #sbRefTyp := False;
	    #siRefTypCyc := 0;
	END_IF;
	
	// Execute the motion
	IF #executeMode AND NOT #sbExecuteEdge THEN
	    #sbExecute := True;
	    #siExecuteCyc := 0;
	ELSIF #actMode <> #modePos THEN
	    #sbExecute := FALSE;
	ELSIF #siExecuteCyc > (15 * #siCycWait) THEN
	    IF #modePos <> 4 THEN
	        #sbExecute := FALSE;
	    ELSE
	        // 使用InputData.ZSW1_Bit11_HomeSet替代sxRecvBuf.ZSW1.%X11
	        IF #InputData.ZSW1_Bit11_HomeSet OR NOT #executeMode THEN
	            #sbExecute := FALSE;
	        END_IF;
	    END_IF;
	ELSE
	    ;
	END_IF;
	IF #siExecuteCyc > 100 THEN
	    #siExecuteCyc := 0;
	ELSE
	    #siExecuteCyc := #siExecuteCyc + 1;
	END_IF;
	#sbExecuteEdge := #executeMode;
	
	// MDI Start边沿检测逻辑（基于EPosSTW1.%X15，即POS_STW1_Bit15_ActivateMDI）
	IF #OutputData.POS_STW1_Bit15_ActivateMDI AND NOT #sbMdiStartEdge THEN
	    #sbMdiStart := True;
	END_IF;
	#sbMdiStartEdge := #OutputData.POS_STW1_Bit15_ActivateMDI AND NOT #sbBusy;
	IF NOT #OutputData.POS_STW1_Bit15_ActivateMDI THEN
	    #sbMdiStart := False;
	    #siMdiStartCyc := 0;
	END_IF;
	
	// 基础STW1控制位映射
	#OutputData.STW1_Bit04_NotRejectTask := #cancelTraversing;
	#OutputData.STW1_Bit05_NoIntermediateStop := #intermediateStop;
	#OutputData.STW1_Bit07_Ack := #ackError;
	#OutputData.STW1_Bit01_Off2 := TRUE;  // 原.%X1
	#OutputData.STW1_Bit02_Off3 := TRUE;  // 原.%X2
	#OutputData.STW1_Bit03_Enable := TRUE; // 原.%X3
	#OutputData.STW1_Bit10_PLC := TRUE;    // 原.%X10 (Life bit)
	#OutputData.STW1_Bit12_Reserved := FALSE; // 原.%X12
	#OutputData.STW1_Bit14_Reserved := FALSE; // 原.%X14
	#OutputData.STW1_Bit15_Reserved := FALSE; // 原.%X15
	
	// If the parameter setting is correnct, then execute the positioning mode.
	// ModePos = 1, relative positioning
	IF (#siModePos = 1 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;           // 原STW1.%X0
	    #OutputData.STW1_Bit08_Jog1 := False;           // 原.%X8
	    #OutputData.STW1_Bit09_Jog2 := False;           // 原.%X9
	    #OutputData.STW1_Bit11_StartHoming := False;    // 原.%X11
	    
	    #OutputData.POS_STW1_Bit08_Absolute := False;    // 原EPosSTW1.%X8 (0=相对)
	    #OutputData.POS_STW1_Bit09_DirPos := False;      // 原.%X9
	    #OutputData.POS_STW1_Bit10_DirNeg := False;      // 原.%X10
	    #OutputData.POS_STW1_Bit14_SetupOrPositioning := False; // 原.%X14 (0=定位)
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False; // 原.%X15
	    
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;  // 原.%X1
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False; // 原.%X3
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False; // 原.%X5
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;    // 原.%X9
	    #OutputData.POS_STW2_Bit08_RefType := False;      // 原.%X8
	    
	    IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	        #OutputData.POS_STW1_Bit15_ActivateMDI := True;  // MDI激活
	        #OutputData.POS_STW1_Bit08_Absolute := False;    // 相对定位
	        IF #positive AND NOT #negative THEN
	            #OutputData.POS_STW1_Bit09_DirPos := True;
	            #OutputData.POS_STW1_Bit10_DirNeg := False;
	        ELSIF NOT #positive AND #negative THEN
	            #OutputData.POS_STW1_Bit09_DirPos := False;
	            #OutputData.POS_STW1_Bit10_DirNeg := True;
	        ELSE
	            #OutputData.POS_STW1_Bit09_DirPos := False;
	            #OutputData.POS_STW1_Bit10_DirNeg := False;
	        END_IF;
	        IF #sbMdiStart AND (#siMdiStartCyc < #siCycWait) THEN
	            #siMdiStartCyc := #siMdiStartCyc + 1;
	        ELSE
	            #OutputData.STW1_Bit06_ActivateTask := #sbExecute; // 原.%X6
	        END_IF;
	        IF #sbRefTyp THEN
	            #OutputData.POS_STW2_Bit08_RefType := True; // 飞参模式
	            IF (#siRefTypCyc = 0) THEN
	                #siRefTypCyc := #siRefTypCyc + 1;
	            ELSE
	                #OutputData.STW1_Bit11_StartHoming := True; // 开始回零
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ModePos = 2, absolute positioning
	ELSIF (#siModePos = 2 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    
	    #OutputData.POS_STW1_Bit08_Absolute := False;
	    #OutputData.POS_STW1_Bit09_DirPos := False;
	    #OutputData.POS_STW1_Bit10_DirNeg := False;
	    #OutputData.POS_STW1_Bit14_SetupOrPositioning := False;
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    
	    IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	        #OutputData.POS_STW1_Bit15_ActivateMDI := True;
	        #OutputData.POS_STW1_Bit08_Absolute := True;  // 绝对定位
	        IF #positive AND NOT #negative THEN
	            #OutputData.POS_STW1_Bit09_DirPos := True;
	            #OutputData.POS_STW1_Bit10_DirNeg := False;
	        ELSIF NOT #positive AND #negative THEN
	            #OutputData.POS_STW1_Bit09_DirPos := False;
	            #OutputData.POS_STW1_Bit10_DirNeg := True;
	        ELSE
	            #OutputData.POS_STW1_Bit09_DirPos := False;
	            #OutputData.POS_STW1_Bit10_DirNeg := False;
	        END_IF;
	        IF #sbMdiStart AND (#siMdiStartCyc < #siCycWait) THEN
	            #siMdiStartCyc := #siMdiStartCyc + 1;
	        ELSE
	            #OutputData.STW1_Bit06_ActivateTask := #sbExecute;
	        END_IF;
	        IF #sbRefTyp THEN
	            #OutputData.POS_STW2_Bit08_RefType := True;
	            IF (#siRefTypCyc = 0) THEN
	                #siRefTypCyc := #siRefTypCyc + 1;
	            ELSE
	                #OutputData.STW1_Bit11_StartHoming := True;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ModePos = 3, setup mode
	ELSIF (#siModePos = 3 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    
	    #OutputData.POS_STW1_Bit08_Absolute := False;
	    #OutputData.POS_STW1_Bit09_DirPos := False;
	    #OutputData.POS_STW1_Bit10_DirNeg := False;
	    #OutputData.POS_STW1_Bit14_SetupOrPositioning := False;
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    
	    IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	        #OutputData.POS_STW1_Bit15_ActivateMDI := True;
	        #OutputData.POS_STW1_Bit08_Absolute := True;
	        #OutputData.POS_STW1_Bit14_SetupOrPositioning := True; // Setup模式
	        IF #positive AND NOT #negative THEN
	            #OutputData.POS_STW1_Bit09_DirPos := True;
	            #OutputData.POS_STW1_Bit10_DirNeg := False;
	        ELSIF NOT #positive AND #negative THEN
	            #OutputData.POS_STW1_Bit09_DirPos := False;
	            #OutputData.POS_STW1_Bit10_DirNeg := True;
	        ELSE
	            #OutputData.POS_STW1_Bit09_DirPos := False;
	            #OutputData.POS_STW1_Bit10_DirNeg := False;
	        END_IF;
	        IF #sbMdiStart AND (#siMdiStartCyc < #siCycWait) THEN
	            #siMdiStartCyc := #siMdiStartCyc + 1;
	        ELSE
	            #OutputData.STW1_Bit06_ActivateTask := #sbExecute;
	        END_IF;
	        IF #sbRefTyp THEN
	            #OutputData.POS_STW2_Bit08_RefType := True;
	            IF (#siRefTypCyc = 0) THEN
	                #siRefTypCyc := #siRefTypCyc + 1;
	            ELSE
	                #OutputData.STW1_Bit11_StartHoming := True;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ModePos = 4, reference point approach
	ELSIF (#siModePos = 4 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    
	    IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	        #OutputData.STW1_Bit11_StartHoming := #sbExecute;
	        IF #positive AND NOT #negative THEN
	            #OutputData.POS_STW2_Bit09_RefNegDir := False; // 正方向
	        ELSIF NOT #positive AND #negative THEN
	            #OutputData.POS_STW2_Bit09_RefNegDir := True;  // 负方向
	        END_IF;
	    END_IF;
	    
	    // ModePos = 5, set reference point
	ELSIF (#siModePos = 5 AND #sbModePos) THEN
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    
	    IF NOT #sbFault THEN
	        #OutputData.POS_STW2_Bit01_SetRefPoint := #sbExecute; // 设置参考点
	    END_IF;
	    
	    // ModePos = 6, traversing block function
	ELSIF (#siModePos = 6 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    
	    #OutputData.POS_STW1_Bit08_Absolute := False;
	    #OutputData.POS_STW1_Bit09_DirPos := False;
	    #OutputData.POS_STW1_Bit10_DirNeg := False;
	    #OutputData.POS_STW1_Bit14_SetupOrPositioning := False;
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    
	    // 遍历块选择位清零
	    #OutputData.POS_STW1_Bit00_Traversing0 := False;
	    #OutputData.POS_STW1_Bit01_Traversing1 := False;
	    #OutputData.POS_STW1_Bit02_Traversing2 := False;
	    #OutputData.POS_STW1_Bit03_Traversing3 := False;
	    #OutputData.POS_STW1_Bit04_Traversing4 := False;
	    #OutputData.POS_STW1_Bit05_Traversing5 := False;
	    
	    IF (DINT_TO_INT(TRUNC(#position)) < 0) OR (DINT_TO_INT(TRUNC(#position)) > #TRAVERSEBLOCKMAXNO) THEN
	        #swStatus := 16#8204;
	        #error := True;
	    ELSE
	        IF #swStatus = 16#8204 THEN
	            #swStatus := 16#7002;
	            #error := False;
	        END_IF;
	        // 遍历块位选择 (Bit0-5)
	        IF (INT_TO_WORD(DINT_TO_INT(TRUNC(#position))) AND W#16#01) = W#16#01 THEN
	            #OutputData.POS_STW1_Bit00_Traversing0 := True;
	        END_IF;
	        IF (INT_TO_WORD(DINT_TO_INT(TRUNC(#position))) AND W#16#02) = W#16#02 THEN
	            #OutputData.POS_STW1_Bit01_Traversing1 := True;
	        END_IF;
	        IF (INT_TO_WORD(DINT_TO_INT(TRUNC(#position))) AND W#16#04) = W#16#04 THEN
	            #OutputData.POS_STW1_Bit02_Traversing2 := True;
	        END_IF;
	        IF (INT_TO_WORD(DINT_TO_INT(TRUNC(#position))) AND W#16#08) = W#16#08 THEN
	            #OutputData.POS_STW1_Bit03_Traversing3 := True;
	        END_IF;
	        IF (INT_TO_WORD(DINT_TO_INT(TRUNC(#position))) AND W#16#10) = W#16#10 THEN
	            #OutputData.POS_STW1_Bit04_Traversing4 := True;
	        END_IF;
	        IF (INT_TO_WORD(DINT_TO_INT(TRUNC(#position))) AND W#16#20) = W#16#20 THEN
	            #OutputData.POS_STW1_Bit05_Traversing5 := True;
	        END_IF;
	        
	        IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	            #OutputData.STW1_Bit06_ActivateTask := #sbExecute;
	            IF #sbRefTyp THEN
	                #OutputData.POS_STW2_Bit08_RefType := True;
	                IF (#siRefTypCyc = 0) THEN
	                    #siRefTypCyc := #siRefTypCyc + 1;
	                ELSE
	                    #OutputData.STW1_Bit11_StartHoming := True;
	                END_IF;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ModePos = 7, jog
	ELSIF (#siModePos = 7 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    
	    IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	        IF #jog1 AND NOT #jog2 THEN
	            #OutputData.STW1_Bit08_Jog1 := True;
	        END_IF;
	        IF #jog2 AND NOT #jog1 THEN
	            #OutputData.STW1_Bit09_Jog2 := True;
	        END_IF;
	        IF #sbRefTyp THEN
	            #OutputData.POS_STW2_Bit08_RefType := #flyRef;
	            IF (#siRefTypCyc = 0) THEN
	                #siRefTypCyc := #siRefTypCyc + 1;
	            ELSE
	                #OutputData.STW1_Bit11_StartHoming := True;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ModePos = 8, incremental jog
	ELSIF (#siModePos = 8 AND #sbModePos) THEN
	    #OutputData.STW1_Bit00_On := #sbOff1;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    
	    IF #sbOff1 AND #sbReady AND #sbIOp AND NOT #sbFault THEN
	        #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := True; // 增量模式
	        #sbJogInc := True;
	        IF #sbJogInc AND (#siJogIncCyc = 0) THEN
	            #siJogIncCyc := #siJogIncCyc + 1;
	        ELSE
	            IF #jog1 XOR #jog2 THEN
	                #OutputData.STW1_Bit08_Jog1 := #jog1;
	                #OutputData.STW1_Bit09_Jog2 := #jog2;
	            END_IF;
	        END_IF;
	        IF #sbRefTyp THEN
	            #OutputData.POS_STW2_Bit08_RefType := True;
	            IF (#siRefTypCyc = 0) THEN
	                #siRefTypCyc := #siRefTypCyc + 1;
	            ELSE
	                #OutputData.STW1_Bit11_StartHoming := True;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    // ModePos = 9 (Reserve/Encoder adjustment)
	ELSIF (#siModePos = 9 AND #sbModePos) THEN
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    
	    IF NOT #sbFault THEN
	        #OutputData.POS_STW2_Bit03_AdjustEncoder := #sbExecute; // 编码器调整
	    END_IF;
	    
	ELSE
	    // 默认状态/无效模式
	    #OutputData.STW1_Bit00_On := #enableAxis;
	    #OutputData.STW1_Bit04_NotRejectTask := False;
	    #OutputData.STW1_Bit06_ActivateTask := False;
	    #OutputData.POS_STW1_Bit15_ActivateMDI := False;
	    #OutputData.STW1_Bit08_Jog1 := False;
	    #OutputData.STW1_Bit09_Jog2 := False;
	    #OutputData.POS_STW1_Bit08_Absolute := False;
	    #OutputData.POS_STW1_Bit09_DirPos := False;
	    #OutputData.POS_STW1_Bit10_DirNeg := False;
	    #OutputData.POS_STW1_Bit12_Continuous := False;
	    #OutputData.POS_STW1_Bit14_SetupOrPositioning := False;
	    #OutputData.POS_STW2_Bit01_SetRefPoint := False;
	    #OutputData.POS_STW2_Bit08_RefType := False;
	    #OutputData.POS_STW2_Bit09_RefNegDir := False;
	    #OutputData.POS_STW2_Bit05_JogIncrementalOrVelocity := False;
	    #OutputData.POS_STW2_Bit03_AdjustEncoder := False;
	    #OutputData.STW1_Bit11_StartHoming := False;
	END_IF;
	
	// Configure the configEPOS to the telegram
	// 应用configEPOS映射（这些可能会覆盖上面的设置，根据原代码逻辑）
	#OutputData.STW1_Bit01_Off2 := #configEPOS.%X0;
	#OutputData.STW1_Bit02_Off3 := #configEPOS.%X1;
	#OutputData.STW1_Bit13_ExtBlockChange := #configEPOS.%X7;
	#OutputData.STW2_Bit08_Reserved := #configEPOS.%X30; // 注意：UDT中STW2保留，但原代码使用Bit8
	
	#OutputData.POS_STW1_Bit12_Continuous := #configEPOS.%X8;
	#OutputData.POS_STW2_Bit14_SWLimit := #configEPOS.%X2;
	#OutputData.POS_STW2_Bit15_StopCam := #configEPOS.%X3;
	#OutputData.POS_STW2_Bit11_MeasProbeEdge := #configEPOS.%X4;
	#OutputData.POS_STW2_Bit10_MeasProbe2 := #configEPOS.%X5;
	#OutputData.POS_STW2_Bit02_RefCam := #configEPOS.%X6;
	
	// 检查驱动器状态
	IF #InputData.ZSW1_Bit03_Fault THEN
	    #swStatus := 16#8401;
	    #error := True;
	ELSIF #InputData.ZSW1_Bit06_Inhibit THEN
	    #swStatus := 16#8402;
	    #error := True;
	ELSE
	    IF (#swStatus = 16#8401) OR (#swStatus = 16#8402) THEN
	        #swStatus := 16#7002;
	        #error := False;
	    END_IF;
	END_IF;
	
	// 飞参激活检测和重试逻辑（使用POS_ZSW1_Bit12_FlyingHoming）
	IF NOT #InputData.POS_ZSW1_Bit12_FlyingHoming AND #sbRefTyp AND #OutputData.STW1_Bit11_StartHoming THEN
	    IF #siRefActRetry < #siRetryMax THEN
	        #siRefActRetry := #siRefActRetry + 1;
	        #OutputData.STW1_Bit11_StartHoming := False;
	    ELSE
	        #swStatus := 16#8403;
	        #error := True;
	    END_IF;
	ELSE
	    IF #swStatus = 16#8403 THEN
	        #swStatus := 16#7002;
	        #error := False;
	    END_IF;
	    IF (#InputData.POS_ZSW1_Bit12_FlyingHoming AND #sbRefTyp AND #OutputData.STW1_Bit11_StartHoming) OR NOT #flyRef THEN
	        #siRefActRetry := 0;
	    END_IF;
	END_IF;
	
	// 诊断ID固定为0（无通信错误）
	#diagID := W#16#0000;
	
	// 处理接收数据 - 从InputData映射到内部变量和输出
	// 状态字ZSW1映射
	#sbReady := #InputData.ZSW1_Bit01_Ready;
	#axisEnabled := #InputData.ZSW1_Bit02_Enabled;
	#sbIOp := #InputData.ZSW1_Bit02_Enabled; // 同Bit02
	#axisError := #InputData.ZSW1_Bit03_Fault;
	#sbFault := #InputData.ZSW1_Bit03_Fault; // 同Bit03
	#axisWarn := #InputData.ZSW1_Bit07_Alarm;
	#sbAlarm := #InputData.ZSW1_Bit07_Alarm; // 同Bit07
	#axisPosOk := #InputData.ZSW1_Bit10_TargetReached;
	#axisRef := #InputData.ZSW1_Bit11_HomeSet;
	#axisSpFixed := #InputData.ZSW1_Bit13_SetpointFixed;
	#sbAccel := #InputData.ZSW1_Bit14_AxisAccel;
	#sbDecel := #InputData.ZSW1_Bit15_AxisDecel;
	#sbBusy := #InputData.ZSW1_Bit02_Enabled; // 使用Enabled作为Busy指示
	
	// 运动方向
	// #sbFWD := #InputData.POS_ZSW2_Bit04_Forward;
	// #sbBWD := #InputData.POS_ZSW2_Bit05_Backward;
	
	// 实际值
	#actVelocity := #InputData.VIST;
	#actPosition := #InputData.XIST;
	#actMode := #modePos;
	
	// 警告和故障代码
	#actWarn := #InputData.AlarmCode;
	#actFault := #InputData.FaultCode;
	#lockOut := #InputData.ZSW1_Bit06_Inhibit;
	
	// 输出赋值
	#status := #swStatus;
END_FUNCTION_BLOCK

FUNCTION "FC_Delay_On_Variant" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CMD_Start : Bool;
      i_CFG_Target : Variant;
      i_Cycle_Count : Int;
   END_VAR

   VAR_OUTPUT 
      o_Delay_Finish : Bool;
   END_VAR

   VAR_IN_OUT 
      io_Setpoint : Variant;
   END_VAR

   VAR_TEMP 
      t_Int : Struct
         Target : Int;
         Setpoint : Int;
      END_STRUCT;
      t_DInt : Struct
         Target : DInt;
         Setpoint : DInt;
      END_STRUCT;
      t_Type_Int_Used : Bool;
      t_Type_DInt_Used : Bool;
   END_VAR


BEGIN
	REGION NETWORK: Init Value
	    #o_Delay_Finish := FALSE;
	    #t_Type_Int_Used := FALSE;
	    #t_Type_DInt_Used := FALSE;
	END_REGION
	
	REGION NETWORK: Check Type
	    IF TypeOf(#i_CFG_Target) <> TypeOf(#io_Setpoint) THEN
	        RETURN;
	    END_IF;
	    
	    IF TypeOf(#i_CFG_Target) = Int THEN
	        VariantGet(SRC := #i_CFG_Target,
	                   DST => #t_Int.Target);
	        VariantGet(SRC := #io_Setpoint,
	                   DST => #t_Int.Setpoint);
	        #t_Type_Int_Used := TRUE;
	    ELSIF TypeOf(#i_CFG_Target) = DInt THEN
	        VariantGet(SRC := #i_CFG_Target,
	                   DST => #t_DInt.Target);
	        VariantGet(SRC := #io_Setpoint,
	                   DST => #t_DInt.Setpoint);
	        #t_Type_DInt_Used := TRUE;
	    ELSE
	        RETURN;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Init Timer
	    IF NOT #i_CMD_Start THEN
	        #t_Int.Setpoint := 0;
	        #t_DInt.Setpoint := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Detect result    
	    #o_Delay_Finish := #i_CMD_Start
	    AND ((#t_Type_Int_Used AND #t_Int.Setpoint >= #t_Int.Target)
	    OR (#t_Type_DInt_Used AND #t_DInt.Setpoint >= #t_DInt.Target));
	END_REGION
	
	REGION NETWORK: Count time value
	    IF #i_CMD_Start THEN
	        IF #t_Type_Int_Used THEN
	            #t_Int.Setpoint := #t_Int.Setpoint + #i_Cycle_Count;
	            IF #t_Int.Setpoint > #t_Int.Target THEN
	                #t_Int.Setpoint := #t_Int.Target;
	            END_IF;
	        ELSIF #t_Type_DInt_Used THEN
	            #t_DInt.Setpoint := #t_DInt.Setpoint + #i_Cycle_Count;
	            IF #t_DInt.Setpoint > #t_DInt.Target THEN
	                #t_DInt.Setpoint := #t_DInt.Target;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Write Setpoint
	    IF #t_Type_Int_Used THEN
	        VariantPut(SRC := #t_Int.Setpoint,
	                   DST := #io_Setpoint);
	    ELSIF #t_Type_DInt_Used THEN
	        VariantPut(SRC := #t_DInt.Setpoint,
	                   DST := #io_Setpoint);
	    END_IF;
	END_REGION
	
END_FUNCTION

FUNCTION "FC_Delay_On_Accumulator_Variant" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CMD_Start : Bool;
      i_Enable_Dly : Bool;
      i_CFG_Target : Variant;
      i_Cycle_Count : Int;
   END_VAR

   VAR_OUTPUT 
      o_Delay_Finish : Bool;
   END_VAR

   VAR_IN_OUT 
      io_Setpoint : Variant;
   END_VAR

   VAR_TEMP 
      t_Int : Struct
         Target : Int;
         Setpoint : Int;
      END_STRUCT;
      t_DInt : Struct
         Target : DInt;
         Setpoint : DInt;
      END_STRUCT;
      t_Type_Int_Used : Bool;
      t_Type_DInt_Used : Bool;
   END_VAR


BEGIN
	REGION NETWORK: Init Value
	    #o_Delay_Finish := FALSE;
	    #t_Type_Int_Used := FALSE;
	    #t_Type_DInt_Used := FALSE;
	END_REGION
	
	REGION NETWORK: Check Type
	    IF TypeOf(#i_CFG_Target) <> TypeOf(#io_Setpoint) THEN
	        RETURN;
	    END_IF;
	    
	    IF TypeOf(#i_CFG_Target) = Int THEN
	        VariantGet(SRC := #i_CFG_Target,
	                   DST => #t_Int.Target);
	        VariantGet(SRC := #io_Setpoint,
	                   DST => #t_Int.Setpoint);
	        #t_Type_Int_Used := TRUE;
	    ELSIF TypeOf(#i_CFG_Target) = DInt THEN
	        VariantGet(SRC := #i_CFG_Target,
	                   DST => #t_DInt.Target);
	        VariantGet(SRC := #io_Setpoint,
	                   DST => #t_DInt.Setpoint);
	        #t_Type_DInt_Used := TRUE;
	    ELSE
	        RETURN;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Init Timer
	    IF NOT #i_CMD_Start THEN
	        #t_Int.Setpoint := 0;
	        #t_DInt.Setpoint := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Detect result    
	    #o_Delay_Finish := #i_CMD_Start
	    AND ((#t_Type_Int_Used AND #t_Int.Setpoint >= #t_Int.Target)
	    OR (#t_Type_DInt_Used AND #t_DInt.Setpoint >= #t_DInt.Target));
	END_REGION
	
	REGION NETWORK: Count time value
	    IF #i_CMD_Start THEN
	        IF #t_Type_Int_Used THEN
	            IF #i_Enable_Dly THEN
	                #t_Int.Setpoint := #t_Int.Setpoint + #i_Cycle_Count;
	            END_IF;
	            IF #t_Int.Setpoint > #t_Int.Target THEN
	                #t_Int.Setpoint := #t_Int.Target;
	            END_IF;
	        ELSIF #t_Type_DInt_Used THEN
	            IF #i_Enable_Dly THEN
	                #t_DInt.Setpoint := #t_DInt.Setpoint + #i_Cycle_Count;
	            END_IF;
	            IF #t_DInt.Setpoint > #t_DInt.Target THEN
	                #t_DInt.Setpoint := #t_DInt.Target;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Write Setpoint
	    IF #t_Type_Int_Used THEN
	        VariantPut(SRC := #t_Int.Setpoint,
	                   DST := #io_Setpoint);
	    ELSIF #t_Type_DInt_Used THEN
	        VariantPut(SRC := #t_DInt.Setpoint,
	                   DST := #io_Setpoint);
	    END_IF;
	END_REGION
END_FUNCTION

TYPE "UDT_Global"
TITLE = UDT_Global
VERSION : 0.1
//General runtime variable
//# Block Info
//- Title:            UDT_Global
//- Comment/Function: General runtime variable
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      AlwaysOff : Bool;   // FALSE
      AlwaysOn : Bool;   // TRUE
      PLC_Is_Simulated : Bool;   // Indicates that simulated PLC is used
      PLC_1200 : Bool;   // PLC is 1200 series
      PLC_1500 : Bool;   // PLC is 1500 series
      PLC_NoFailsafe : Bool;   // PLC donot support failsafe
      OS_First_Scan : Bool;   // TRUE during 1st. scan after Restart
      OS_New_Year : Bool;   // One-Shot each year
      OS_New_Month : Bool;   // One-Shot each month
      OS_New_Week : Bool;   // One-Shot each week
      OS_New_Day : Bool;   // One-Shot each day
      OS_New_Hour : Bool;   // One-Shot each hour
      OS_New_Minute : Bool;   // One-Shot each minute
      OS_New_Second : Bool;   // One-Shot each second
      Clock_10Hz : Bool;   // 0.05s on, 0.05s off
      Clock_5Hz : Bool;   // 0.01s on, 0.01s off
      Clock_2_5Hz : Bool;   // 0.125s on, 0.125s off
      Clock_2Hz : Bool;   // 0.25s on, 0.25s off
      Clock_1_25Hz : Bool;   // 0.4s on, 0.4s off
      Clock_1Hz : Bool;   // 0.5s on, 0.5s off
      Clock_0_625Hz : Bool;   // 0.8s on, 0.8s off
      Clock_0_5Hz : Bool;   // 1s on, 1s off
      OneShot_0_05sec : Bool;   // One-Shot each 0.05 sec
      OneShot_0_1sec : Bool;   // One-Shot each 0.1 sec
      OneShot_0_2sec : Bool;   // One-Shot each 0.2sec
      OneShot_0_25sec : Bool;   // One-Shot each 0.25 sec
      OneShot_0_5sec : Bool;   // One-Shot each 0.5 sec
      OneShot_0_8sec : Bool;   // One-Shot each 0.8 sec
      OneShot_1sec : Bool;   // One-Shot each 1 sec
      OneShot_2sec : Bool;   // One-Shot each 2 sec
      OB_Prev_Cycle_Time : Int;   // [ms] Passed time in previous PLC cycle
      OB_Average_Cycle_Time : Int;   // [ms] Average passed time in previous PLC cycle
      OB_Min_Cycle_Time : Int := 9999;   // [ms] The minimum passed time in previous PLC cycle
      OB_Max_Cycle_Time : Int;   // [ms] The maximum passed time in previous PLC cycle
      Common_Setting : "UDT_Commen_Setting";
   END_STRUCT;

END_TYPE

