TYPE "UDT_Base_Conveyor_Setting"
TITLE = UDT_Sett_Base_Conveyor
VERSION : 0.1
//Setting of base tranpsort control
//# Block Info
//- Title:            UDT_Sett_Base_Conveyor
//- Comment/Function: Setting of base tranpsort control
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      Delay_Dieback : DInt := 50;   // [mm] Delay from end to stop in dieback
      Delay_Startup : DInt := 100;   // [mm] Delay restart after dieback
      Delay_Waiting_Item : DInt;   // [mm] Delay for receive item from upstream
      Delay_Finish_Handover : DInt;   // [mm] Delay handover after items exit the END PEC
      Delay_Energysave : DInt := 5000;   // [mm] Delay running after clearing
      Delay_Cascade_Startup : DInt := 100;   // [mm] Cascade delay 0: Startup immediately
      Delay_Cascade_Shutdown : DInt := -1;   // [ms] Cascade delay -1: disable function 0: Shutdown immediately
      Slave_Mode : Bool;   // TRUE = Make this section a slave
      Enable_DieForward : Bool;   // TRUE = Halt conveyor if upstream handover occurs error
   END_STRUCT;

END_TYPE

