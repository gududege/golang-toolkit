TYPE "UDT_S210_HW_Output"
VERSION : 0.1
   STRUCT
      STW1_Bit00_On : Bool;   // 0: ON/OFF1 command (0->1: ON)
      STW1_Bit01_Off2 : Bool;   // 1: OFF2 command (0: active, coast stop)
      STW1_Bit02_Off3 : Bool;   // 2: OFF3 command (0: active, quick stop)
      STW1_Bit03_Enable : Bool;   // 3: Operation enable
      STW1_Bit04_NotRejectTask : Bool;   // 4: Not reject traversing task 
      STW1_Bit05_NoIntermediateStop : Bool;   // 5: Intermediate stop (0: active)
      STW1_Bit06_ActivateTask : Bool;   // 6: Activate traversing task (0->1: start)
      STW1_Bit07_Ack : Bool;   // 7: Acknowledge faults (0->1: acknowledge)
      STW1_Bit08_Jog1 : Bool;   // 8: Jog 1 signal source
      STW1_Bit09_Jog2 : Bool;   // 9: Jog 2 signal source
      STW1_Bit10_PLC : Bool;   // 10: Control by PLC (must be 1)
      STW1_Bit11_StartHoming : Bool;   // 11: Start homing (0â†’1: start)
      STW1_Bit12_Reserved : Bool;   // 12: Reserved
      STW1_Bit13_ExtBlockChange : Bool;   // 13: External block change
      STW1_Bit14_Reserved : Bool;   // 14: Reserved
      STW1_Bit15_Reserved : Bool;   // 15: Reserved
      POS_STW1_Bit00_Traversing0 : Bool;   // 0: Traversing clock selection, bit 0
      POS_STW1_Bit01_Traversing1 : Bool;   // 1: Traversing clock selection, bit 1
      POS_STW1_Bit02_Traversing2 : Bool;   // 2: Traversing clock selection, bit 2
      POS_STW1_Bit03_Traversing3 : Bool;   // 3: Traversing clock selection, bit 3
      POS_STW1_Bit04_Traversing4 : Bool;   // 4: Traversing clock selection, bit 4
      POS_STW1_Bit05_Traversing5 : Bool;   // 5: Traversing clock selection, bit 5
      POS_STW1_Bit06_Reserved : Bool;   // 6: Reserved
      POS_STW1_Bit07_ReleaseBrake : Bool;   // 7: The converter opens a connected holding brake
      POS_STW1_Bit08_Absolute : Bool;   // 8: Absolute positioning is selected (1: absolute, 0: relative)
      POS_STW1_Bit09_DirPos : Bool;   // 9: MDI direction selection, positive
      POS_STW1_Bit10_DirNeg : Bool;   // 10: MDI direction selection, negative
      POS_STW1_Bit11_Reserved : Bool;   // 11: Reserved
      POS_STW1_Bit12_Continuous : Bool;   // 12: Continuous transfer (1: continuous setpoint acceptance)
      POS_STW1_Bit13_Reserved : Bool;   // 13: Reserved
      POS_STW1_Bit14_SetupOrPositioning : Bool;   // 14: Toggling the axis operating mode (1: Set up, 0: Positioning)  
      POS_STW1_Bit15_ActivateMDI : Bool;   // 15: The converter receives its position setpoint from an 
      POS_STW2_Bit00_ActivateFollowUp : Bool;   // 0: Continuously corrects the position setpoint to 
      POS_STW2_Bit01_SetRefPoint : Bool;   // 1: Set reference point (0->1: set)
      POS_STW2_Bit02_RefCam : Bool;   // 2: Reference cam active
      POS_STW2_Bit03_AdjustEncoder : Bool;   // 3: Encoder adjustment (0->1: adjust)
      POS_STW2_Bit04_Reserved : Bool;   // 4: Reserved
      POS_STW2_Bit05_JogIncrementalOrVelocity : Bool;   // 5: Jogging mode (1: incremental, 0: velocity)
      POS_STW2_Bit06_Reserved : Bool;   // 6: Reserved
      POS_STW2_Bit07_Reserved : Bool;   // 7: Reserved
      POS_STW2_Bit08_RefType : Bool;   // 8: Referencing type selection (1: flying homing 0: homing approach)
      POS_STW2_Bit09_RefNegDir : Bool;   // 9: Start search for reference direction (1: negative dir, 0: positive dir)
      POS_STW2_Bit10_MeasProbe2 : Bool;   // 10: Measuring probe 2 is activated
      POS_STW2_Bit11_MeasProbeEdge : Bool;   // 11: Falling edge of measuring probe
      POS_STW2_Bit12_Reserved : Bool;   // 12: Reserved
      POS_STW2_Bit13_Reserved : Bool;   // 13: Reserved
      POS_STW2_Bit14_SWLimit : Bool;   // 14: Software limit switch activation
      POS_STW2_Bit15_StopCam : Bool;   // 15: STOP cam active
      STW2_Bit00_Reserved : Bool;   // 0: Reserved
      STW2_Bit01_Reserved : Bool;   // 1: Reserved
      STW2_Bit02_Reserved : Bool;   // 2: Reserved
      STW2_Bit03_Reserved : Bool;   // 3: Reserved
      STW2_Bit04_Reserved : Bool;   // 4: Reserved
      STW2_Bit05_Reserved : Bool;   // 5: Reserved
      STW2_Bit06_Reserved : Bool;   // 6: Reserved
      STW2_Bit07_Reserved : Bool;   // 7: Reserved
      STW2_Bit08_Reserved : Bool;   // 8: Reserved
      STW2_Bit09_Reserved : Bool;   // 9: Reserved
      STW2_Bit10_Reserved : Bool;   // 10: Reserved
      STW2_Bit11_Reserved : Bool;   // 11: Reserved
      STW2_Bit12_Reserved : Bool;   // 12: Reserved
      STW2_Bit13_Reserved : Bool;   // 13: Reserved
      STW2_Bit14_Reserved : Bool;   // 14: Reserved
      STW2_Bit15_Reserved : Bool;   // 15: Reserved
      Override : Int;   // Velocity override [0-4000h = 0-16384 = 0-100%]
      MDI_TARPOS : Real;   // MDI target position
      MDI_VELOCITY : Real;   // MDI velocity
      MDI_ACC : Real;   // MDI acceleration override
      MDI_DEC : Real;   // MDI deceleration override
      Reserved : Real;   // Reserved for future use
      REF_COORDINATE : Real;   // EPOS home position signal
   END_STRUCT;

END_TYPE

TYPE "UDT_S210_HW_Input"
VERSION : 0.1
   STRUCT
      ZSW1_Bit00_ReadyOn : Bool;   // 0: Ready for switching on
      ZSW1_Bit01_Ready : Bool;   // 1: Ready for operation
      ZSW1_Bit02_Enabled : Bool;   // 2: Operation enabled
      ZSW1_Bit03_Fault : Bool;   // 3: Fault present (1: fault)
      ZSW1_Bit04_Off2Inactive : Bool;   // 4: OFF2 inactive (0: active)
      ZSW1_Bit05_Off3Inactive : Bool;   // 5: OFF3 inactive (0: active)
      ZSW1_Bit06_Inhibit : Bool;   // 6: Switching on inhibited
      ZSW1_Bit07_Alarm : Bool;   // 7: Alarm present (1: alarm)
      ZSW1_Bit08_FollowingOK : Bool;   // 8: Following error within tolerance
      ZSW1_Bit09_Control : Bool;   // 9: Control requested
      ZSW1_Bit10_TargetReached : Bool;   // 10: Target position reached
      ZSW1_Bit11_HomeSet : Bool;   // 11: Home position set
      ZSW1_Bit12_AckActive : Bool;   // 12: Acknowledgement traversing block activated
      ZSW1_Bit13_SetpointFixed : Bool;   // 13: Setpoint fixed
      ZSW1_Bit14_AxisAccel : Bool;   // 14: Axis accelerated
      ZSW1_Bit15_AxisDecel : Bool;   // 15: Axis decelerated
      POS_ZSW1_Bit00_Active0 : Bool;   // 0: Active traversing block, bit 0
      POS_ZSW1_Bit01_Active1 : Bool;   // 1: Active traversing block, bit 1
      POS_ZSW1_Bit02_Active2 : Bool;   // 2: Active traversing block, bit 2
      POS_ZSW1_Bit03_Active3 : Bool;   // 3: Active traversing block, bit 3
      POS_ZSW1_Bit04_Active4 : Bool;   // 4: Active traversing block, bit 4
      POS_ZSW1_Bit05_Active5 : Bool;   // 5: Active traversing block, bit 5
      POS_ZSW1_Bit06_Reserved : Bool;   // 6: Reserved
      POS_ZSW1_Bit07_ReleaseBrake : Bool;   // 7: The converter opens the holding brake
      POS_ZSW1_Bit08_StopCamMinus : Bool;   // 8: STOP cam minus active
      POS_ZSW1_Bit09_StopCamPlus : Bool;   // 9: STOP cam plus active
      POS_ZSW1_Bit10_JogActive : Bool;   // 10: Jogging active (r2669.0)
      POS_ZSW1_Bit11_RefApproach : Bool;   // 11: Reference point approach active (r2669.1)
      POS_ZSW1_Bit12_FlyingHoming : Bool;   // 12: Homes when passing the reference cam
      POS_ZSW1_Bit13_Traversing : Bool;   // 13: Traversing block active (r2669.2)
      POS_ZSW1_Bit14_Setup : Bool;   // 14: Setup active (r2669.4)
      POS_ZSW1_Bit15_MDI : Bool;   // 15: MDI active
      POS_ZSW2_Bit00_Tracking : Bool;   // 0: Tracking mode active
      POS_ZSW2_Bit01_VelLimit : Bool;   // 1: Velocity limiting active
      POS_ZSW2_Bit02_TargetReached : Bool;   // 2: Target position reached (r2683.3)
      POS_ZSW2_Bit03_PrintMark : Bool;   // 3: Printing mark outside outer window
      POS_ZSW2_Bit04_Forward : Bool;   // 4: Axis moves forward
      POS_ZSW2_Bit05_Backward : Bool;   // 5: Axis moves backward
      POS_ZSW2_Bit06_SWLimitMinus : Bool;   // 6: Software limit switch minus reached
      POS_ZSW2_Bit07_SWLimitPlus : Bool;   // 7: Software limit switch plus reached
      POS_ZSW2_Bit08_Cam1 : Bool;   // 8: Position actual value <= cam switching position 1
      POS_ZSW2_Bit09_Cam2 : Bool;   // 9: Position actual value <= cam switching position 2
      POS_ZSW2_Bit10_Output1 : Bool;   // 10: Direct output 1 via traversing block
      POS_ZSW2_Bit11_Output2 : Bool;   // 11: Direct output 2 via traversing block
      POS_ZSW2_Bit12_FixedStop : Bool;   // 12: Fixed stop reached
      POS_ZSW2_Bit13_Clamping : Bool;   // 13: Fixed stop clamping torque reached
      POS_ZSW2_Bit14_TravelFixed : Bool;   // 14: Travel to fixed stop active
      POS_ZSW2_Bit15_TraversingCmd : Bool;   // 15: Traversing command active
      ZSW2_Bit00_Reserved : Bool;   // 0: Reserved
      ZSW2_Bit01_Reserved : Bool;   // 1: Reserved
      ZSW2_Bit02_Reserved : Bool;   // 2: Reserved
      ZSW2_Bit03_Reserved : Bool;   // 3: Reserved
      ZSW2_Bit04_Reserved : Bool;   // 4: Reserved
      ZSW2_Bit05_Reserved : Bool;   // 5: Reserved
      ZSW2_Bit06_Reserved : Bool;   // 6: Reserved
      ZSW2_Bit07_Reserved : Bool;   // 7: Reserved
      ZSW2_Bit08_Reserved : Bool;   // 8: Reserved
      ZSW2_Bit09_Reserved : Bool;   // 9: Reserved
      ZSW2_Bit10_Reserved : Bool;   // 10: Reserved
      ZSW2_Bit11_Reserved : Bool;   // 11: Reserved
      ZSW2_Bit12_Reserved : Bool;   // 12: Reserved
      ZSW2_Bit13_Reserved : Bool;   // 13: Reserved
      ZSW2_Bit14_Reserved : Bool;   // 14: Reserved
      ZSW2_Bit15_Reserved : Bool;   // 15: Reserved 
      Reserved : Int;   // Reserved
      XIST : Real;   // Position actual value
      VIST : Real;   // Velocity actual value
      MELDW_Bit00_PositioningAbsolute : Bool;   // 0: Positioning mode (1: absolute, 0: relative)
      MELDW_Bit01_AbsolutePositiveDir : Bool;   // 1: Absolute positioning for rotary axis in the positive direction
      MELDW_Bit02_AbsoluteNegativeDir : Bool;   // 2: Absolute positioning for rotary axes in negative direction
      MELDW_Bit03_Reserved : Bool;   // 3: Reserved
      MELDW_Bit04_Reserved : Bool;   // 4: Reserved
      MELDW_Bit05_Reserved : Bool;   // 5: Reserved
      MELDW_Bit06_Reserved : Bool;   // 6: Reserved
      MELDW_Bit07_Reserved : Bool;   // 7: Reserved
      MELDW_Bit08_Reserved : Bool;   // 8: Reserved
      MELDW_Bit09_Reserved : Bool;   // 9: Reserved
      MELDW_Bit10_Reserved : Bool;   // 10: Reserved
      MELDW_Bit11_Reserved : Bool;   // 11: Reserved
      MELDW_Bit12_Reserved : Bool;   // 12: Reserved
      MELDW_Bit13_Reserved : Bool;   // 13: Reserved
      MELDW_Bit14_Reserved : Bool;   // 14: Reserved
      MELDW_Bit15_Reserved : Bool;   // 15: Reserved
      FaultCode : Word;   // Fault code (0: no fault)
      AlarmCode : Word;   // Alarm code (0: no alarm)
      ZSW_S210_Bit00_DI0 : Bool;   // 0: Digital input 0 status
      ZSW_S210_Bit01_DI1 : Bool;   // 1: Digital input 1 status
      ZSW_S210_Bit02_DI2 : Bool;   // 2: Digital input 2 status
      ZSW_S210_Bit03_DI3 : Bool;   // 3: Digital input 3 status
      ZSW_S210_Bit04_DI4 : Bool;   // 4: Digital input 4 status
      ZSW_S210_Bit05_Reserved : Bool;   // 5: Reserved
      ZSW_S210_Bit06_Reserved : Bool;   // 6: Reserved
      ZSW_S210_Bit07_Reserved : Bool;   // 7: Reserved
      ZSW_S210_Bit08_Reserved : Bool;   // 8: Reserved
      ZSW_S210_Bit09_Reserved : Bool;   // 9: Reserved
      ZSW_S210_Bit10_Reserved : Bool;   // 10: Reserved
      ZSW_S210_Bit11_Reserved : Bool;   // 11: Reserved
      ZSW_S210_Bit12_Reserved : Bool;   // 12: Reserved
      ZSW_S210_Bit13_Reserved : Bool;   // 13: Reserved
      ZSW_S210_Bit14_Reserved : Bool;   // 14: Reserved
      ZSW_S210_Bit15_Reserved : Bool;   // 15: Reserved
      DCLinkVoltage : Int;   // DC link voltage [V]
      ActualCurrent : Int;   // Actual current [0.1A]
      ActivePower : Int;   // Active power [W]
      TorqueUtilization : Int;   // Torque utilization [%]
