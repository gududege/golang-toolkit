TYPE "UDT_G115D_HW_Output"
VERSION : 0.1
   STRUCT
      STW1_Bit00_On : Bool;   // 0: ON/OFF1 command (0->1: ON)
      STW1_Bit01_Off2 : Bool;   // 1: No OFF2 command (0: active, coast stop)
      STW1_Bit02_Off3 : Bool;   // 2: No OFF3 command (0: active, quick stop)
      STW1_Bit03_Enable : Bool;   // 3: Operation enable
      STW1_Bit04_RampEnable : Bool;   // 4: Ramp-function generator enable
      STW1_Bit05_RampContinue : Bool;   // 5: Continue ramp-function generator
      STW1_Bit06_SetEnable : Bool;   // 6: Setpoint enable
      STW1_Bit07_Ack : Bool;   // 7: Acknowledge faults (0->1: acknowledge)
      STW1_Bit08_Reserved : Bool;   // 8: Reserved
      STW1_Bit09_Reserved : Bool;   // 9: Reserved
      STW1_Bit10_PLC : Bool;   // 10: Control by PLC (must be 1)
      STW1_Bit11_Reverse : Bool;   // 11: Reverse (1: reverse direction)
      STW1_Bit12_Reserved : Bool;   // 12: Reserved
      STW1_Bit13_MOP_Up : Bool;   // 13: Motorized potentiometer, raise
      STW1_Bit14_MOP_Down : Bool;   // 14: Motorized potentiometer, lower
      STW1_Bit15_Reserved : Bool;   // 15: Reserved Speed setpoint (NSOLL_A)
      NSOLL_A : Int;   // Speed setpoint (-16384 to +16384)
      STW_G115D_Bit00_DO24 : Bool;   // 0: DO 24 control
      STW_G115D_Bit01_DO25 : Bool;   // 1: DO 25 control
      STW_G115D_Bit02_Disable_StopSlow_Sensor : Bool;   // 2: Stop-Slow bypass
      STW_G115D_Bit03_Reserved : Bool;   // 3: Reserved
      STW_G115D_Bit04_Reserved : Bool;   // 4: Reserved
      STW_G115D_Bit05_Reserved : Bool;   // 5: Reserved
      STW_G115D_Bit06_Reserved : Bool;   // 6: Reserved
      STW_G115D_Bit07_Reserved : Bool;   // 7: Reserved
      STW_G115D_Bit08_Reserved : Bool;   // 8: Reserved
      STW_G115D_Bit09_Reserved : Bool;   // 9: Reserved
      STW_G115D_Bit10_Reserved : Bool;   // 10: Reserved
      STW_G115D_Bit11_Reserved : Bool;   // 11: Reserved
      STW_G115D_Bit12_Reserved : Bool;   // 12: Reserved
      STW_G115D_Bit13_Reserved : Bool;   // 13: Reserved
      STW_G115D_Bit14_Reserved : Bool;   // 14: Reserved
      STW_G115D_Bit15_Reserved : Bool;   // 15: Reserved
      RampUpScaling : Int;   // Ramp-up time scaling (0-200% = 0-32767)
      RampDownScaling : Int;   // Ramp-down time scaling (0-200% = 0-32767)
   END_STRUCT;

END_TYPE

