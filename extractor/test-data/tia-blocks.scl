      Servo_Array { S7_SetPoint := 'False'} : Array[1..9] of "UDT_SWS_Servo_Command";
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_HW_MultiControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_IO_Available : Bool;
      i_Safety_OK : Bool := TRUE;
      i_CMD_Reset : Bool;
      i_CMD_Clear_Stat : Bool;
      i_HW_Setting : "UDT_MultiControl_Setting";
      i_CFG_Motor_Switch_Time : Int := 500;
      i_CMD_Select_Speed : Int := 1;
      i_CMD_Motor_Run : Bool;
      i_CMD_Motor_Reverse : Bool;
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Reset : Bool;
      o_Req_Halt : Bool;
      o_ER_Motor_1_Fault : Bool;
      o_ER_Motor_2_Fault : Bool;
      o_ER_Motor_3_Fault : Bool;
      o_ER_Motor_4_Fault : Bool;
      o_Speed_Selected : Int;
      o_Diagnostics : "UDT_MultiControl_HW_Diagnostics";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_MultiControl_Interface : "UDT_MultiControl_HW_Interface";
   END_VAR

   VAR RETAIN
      s_Copy : Struct
         Clear_Stat : Bool;
         MTR_Run : Bool;
         MTR_Reverse : Bool;
      END_STRUCT;
      s_Motor_Switch_Action_Delay : Int;
      s_Timer_Reset_Delay : Int;
      s_Avg_Actual_Speed : Int;
      s_Motor_Run : Bool;
      s_Switch_In_Progress : Bool;
      s_Stopped_Elapsed : Bool;
      s_CMD_Reset : Bool;
   END_VAR

   VAR_TEMP 
      t_GeoAddr {InstructionName := 'GEOADDR'; LibVersion := '1.0'} : GEOADDR;
      t_IO_Available : Bool;
      t_Ret_Val_Int : Int;
      t_Speed_Setpoint : Int;
      t_Direction : Int;
      t_Motor_Count : Int;
      t_RD1_Actual_Speed : Int;
      t_RD2_Actual_Speed : Int;
      t_RD3_Actual_Speed : Int;
      t_RD4_Actual_Speed : Int;
   END_VAR

   VAR CONSTANT 
      C_RESET_DELAY_TIME : Int := 200;
   END_VAR


BEGIN
	REGION NETOWRK: Initial
	    #o_Ready_To_Reset := FALSE;
	    #t_Motor_Count := 0;
	    #t_RD1_Actual_Speed := 0;
	    #t_RD2_Actual_Speed := 0;
	    #t_RD3_Actual_Speed := 0;
	    #t_RD4_Actual_Speed := 0;
	END_REGION
	
	REGION NETWORK: IO Available
	    #t_IO_Available := #i_IO_Available;
	END_REGION
	
	REGION NETWORK: Motor switch delay
	    IF #i_CMD_Motor_Reverse XOR #s_Copy.MTR_Reverse THEN
	        #s_Switch_In_Progress := TRUE;
	        #o_Diagnostics.Motor_Direction_Switch_Count += 1;
	    END_IF;
	    
	    "FC_Delay_On"(i_CMD_Start    := #s_Motor_Run,
	                  i_CFG_Target   := #i_CFG_Motor_Switch_Time,
	                  i_Cycle_Count  := #io_Global.OB_Prev_Cycle_Time,
	                  o_Delay_Finish => #s_Stopped_Elapsed,
	                  io_Setpoint    := #s_Motor_Switch_Action_Delay);
	    
	    IF NOT #s_Stopped_Elapsed THEN
	        #s_Switch_In_Progress := FALSE;
	    END_IF;
	    #o_Req_Halt := #s_Switch_In_Progress;
	END_REGION
	
	REGION NETWORK: Reset Pulse
	    "FC_Delay_Off"(i_CMD_Start    := #i_CMD_Reset AND #t_IO_Available,
	                   i_CFG_Target   := #C_RESET_DELAY_TIME,
	                   i_Cycle_Count  := #io_Global.OB_Prev_Cycle_Time,
	                   o_Delay_Finish => #s_CMD_Reset,
	                   io_Setpoint    := #s_Timer_Reset_Delay);
	END_REGION
	
	REGION NETWORK: Choose Speedsetpoint
	    IF #i_CMD_Select_Speed = 0 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed1;
	    ELSIF #i_CMD_Select_Speed = 1 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed2;
	    ELSIF #i_CMD_Select_Speed = 2 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed3;
	    ELSIF #i_CMD_Select_Speed = 3 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed4;
	    ELSE
	        #o_Speed_Selected := #i_HW_Setting.Speed1;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Motor Run    
	    #s_Motor_Run := #i_CMD_Motor_Run AND #t_IO_Available AND NOT #s_Switch_In_Progress;
	    
	    IF #i_CMD_Motor_Reverse XOR #i_HW_Setting.ReverseDirection THEN
	        #t_Direction := -1;
	    ELSE
	        #t_Direction := 1;
	    END_IF;
	    
	    IF #i_HW_Setting.RD1_Motor_Number > 0 THEN
	        #t_Motor_Count := #t_Motor_Count + 1;
	        IF #s_Motor_Run THEN
	            #io_MultiControl_Interface.Output.MotorSpeed_RD1 := DINT_TO_SINT(#t_Direction * INT_TO_DINT(#o_Speed_Selected) * 100 / INT_TO_DINT(#i_HW_Setting.RefSpeed));
	        ELSE
	            #io_MultiControl_Interface.Output.MotorSpeed_RD1 := 0;
	        END_IF;
	        #t_RD1_Actual_Speed := DINT_TO_INT((SINT_TO_DINT(#io_MultiControl_Interface.Input.MotorSpeed_RD1) * INT_TO_DINT(#i_HW_Setting.RefSpeed) / 100));
	    END_IF;
	    
	    IF #i_HW_Setting.RD2_Motor_Number > 0 THEN
	        #t_Motor_Count := #t_Motor_Count + 1;
	        IF #s_Motor_Run THEN
	            #io_MultiControl_Interface.Output.MotorSpeed_RD2 := DINT_TO_SINT(#t_Direction * INT_TO_DINT(#o_Speed_Selected) * 100 / INT_TO_DINT(#i_HW_Setting.RefSpeed));
	            #t_Motor_Count := #t_Motor_Count + 1;
	        ELSE
	            #io_MultiControl_Interface.Output.MotorSpeed_RD2 := 0;
	        END_IF;
	        #t_RD2_Actual_Speed := DINT_TO_INT((SINT_TO_DINT(#io_MultiControl_Interface.Input.MotorSpeed_RD2) * INT_TO_DINT(#i_HW_Setting.RefSpeed) / 100));
	    END_IF;
	    
	    IF #i_HW_Setting.RD3_Motor_Number > 0 THEN
	        #t_Motor_Count := #t_Motor_Count + 1;
	        IF #s_Motor_Run THEN
	            #io_MultiControl_Interface.Output.MotorSpeed_RD3 := DINT_TO_SINT(#t_Direction * INT_TO_DINT(#o_Speed_Selected) * 100 / INT_TO_DINT(#i_HW_Setting.RefSpeed));
	            #t_Motor_Count := #t_Motor_Count + 1;
	        ELSE
	            #io_MultiControl_Interface.Output.MotorSpeed_RD3 := 0;
	        END_IF;
	        #t_RD3_Actual_Speed := DINT_TO_INT((SINT_TO_DINT(#io_MultiControl_Interface.Input.MotorSpeed_RD3) * INT_TO_DINT(#i_HW_Setting.RefSpeed) / 100));
	    END_IF;
	    
	    IF #i_HW_Setting.RD4_Motor_Number > 0 THEN
	        #t_Motor_Count := #t_Motor_Count + 1;
	        IF #s_Motor_Run THEN
	            #io_MultiControl_Interface.Output.MotorSpeed_RD4 := DINT_TO_SINT(#t_Direction * INT_TO_DINT(#o_Speed_Selected) * 100 / INT_TO_DINT(#i_HW_Setting.RefSpeed));
	        ELSE
	            #io_MultiControl_Interface.Output.MotorSpeed_RD4 := 0;
	        END_IF;
	        #t_RD4_Actual_Speed := DINT_TO_INT((SINT_TO_DINT(#io_MultiControl_Interface.Input.MotorSpeed_RD4) * INT_TO_DINT(#i_HW_Setting.RefSpeed) / 100));
	    END_IF;
	    
	    #s_Avg_Actual_Speed := (#t_RD1_Actual_Speed + #t_RD2_Actual_Speed + #t_RD3_Actual_Speed + #t_RD4_Actual_Speed) / #t_Motor_Count;
	END_REGION
	
	REGION NETWORK: Motor Status
	    IF #i_CMD_Reset OR NOT #t_IO_Available OR NOT #i_Safety_OK THEN
	        #o_ER_Motor_1_Fault := FALSE;
	        #o_ER_Motor_2_Fault := FALSE;
	        #o_ER_Motor_3_Fault := FALSE;
	        #o_ER_Motor_4_Fault := FALSE;
	    END_IF;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.RD1_Motor_Number > 0 AND #io_MultiControl_Interface.Input.MotorErr_RD1
	    THEN
	        #o_ER_Motor_1_Fault := TRUE;
	    END_IF;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.RD2_Motor_Number > 0 AND #io_MultiControl_Interface.Input.MotorErr_RD2
	    THEN
	        #o_ER_Motor_2_Fault := TRUE;
	    END_IF;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.RD3_Motor_Number > 0 AND #io_MultiControl_Interface.Input.MotorErr_RD3
	    THEN
	        #o_ER_Motor_3_Fault := TRUE;
	    END_IF;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.RD4_Motor_Number > 0 AND #io_MultiControl_Interface.Input.MotorErr_RD4
	    THEN
	        #o_ER_Motor_4_Fault := TRUE;
	    END_IF;
	    
	    IF
	        (#o_ER_Motor_1_Fault AND NOT #io_MultiControl_Interface.Input.MotorErr_RD1)
	        OR (#o_ER_Motor_2_Fault AND NOT #io_MultiControl_Interface.Input.MotorErr_RD2)
	        OR (#o_ER_Motor_3_Fault AND NOT #io_MultiControl_Interface.Input.MotorErr_RD3)
	        OR (#o_ER_Motor_4_Fault AND NOT #io_MultiControl_Interface.Input.MotorErr_RD4)
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Diagnostics and Statistics
	    #o_Diagnostics.RD1_Run_Command := #s_Motor_Run AND #io_MultiControl_Interface.Output.MotorSpeed_RD1 <> 0;
	    #o_Diagnostics.RD2_Run_Command := #s_Motor_Run AND #io_MultiControl_Interface.Output.MotorSpeed_RD2 <> 0;
	    #o_Diagnostics.RD3_Run_Command := #s_Motor_Run AND #io_MultiControl_Interface.Output.MotorSpeed_RD3 <> 0;
	    #o_Diagnostics.RD4_Run_Command := #s_Motor_Run AND #io_MultiControl_Interface.Output.MotorSpeed_RD4 <> 0;
	    #o_Diagnostics.RD1_Actual_Speed := #t_RD1_Actual_Speed;
	    #o_Diagnostics.RD2_Actual_Speed := #t_RD2_Actual_Speed;
	    #o_Diagnostics.RD3_Actual_Speed := #t_RD3_Actual_Speed;
	    #o_Diagnostics.RD4_Actual_Speed := #t_RD4_Actual_Speed;
	    #o_Diagnostics.Control_Voltage := #io_MultiControl_Interface.Input.Voltage_Control;
	    #o_Diagnostics.Motor_Voltage := #io_MultiControl_Interface.Input.Voltage_Motor;
	    #o_Diagnostics.Temperature := #io_MultiControl_Interface.Input.Temperature;
	    #o_Diagnostics.RD1_Actual_Current := #io_MultiControl_Interface.Input.MotorCurrent_RD1;
	    #o_Diagnostics.RD2_Actual_Current := #io_MultiControl_Interface.Input.MotorCurrent_RD2;
	    #o_Diagnostics.RD3_Actual_Current := #io_MultiControl_Interface.Input.MotorCurrent_RD3;
	    #o_Diagnostics.RD4_Actual_Current := #io_MultiControl_Interface.Input.MotorCurrent_RD4;
	    
	    
	    
	    
	    IF #s_Motor_Run AND NOT #s_Copy.MTR_Run THEN
	        #o_Diagnostics.Motor_Start_Stop_Count += 1;
	    END_IF;
	    
	    IF #s_Motor_Run AND #io_Global.OS_New_Second THEN
	        #o_Diagnostics.Motor_Started_Time += 1;
	    END_IF;
	    
	    IF #i_CMD_Clear_Stat AND NOT #s_Copy.Clear_Stat THEN
	        #o_Diagnostics.Motor_Started_Time := 0;
	        #o_Diagnostics.Motor_Start_Stop_Count := 0;
	        #o_Diagnostics.Motor_Direction_Switch_Count := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Storage Previous State
	    #s_Copy.MTR_Run := #s_Motor_Run;
	    #s_Copy.MTR_Reverse := #i_CMD_Motor_Reverse;
	    #s_Copy.Clear_Stat := #i_CMD_Clear_Stat;
	END_REGION
	
END_FUNCTION_BLOCK

