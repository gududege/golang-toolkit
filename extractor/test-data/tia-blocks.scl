FUNCTION_BLOCK "FB_HW_VFD_G115D"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : HW_SUBMODULE;
      i_Additional_HW_ID { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : HW_SUBMODULE;
      i_Enable : Bool;
      i_IO_Available : Bool;
      i_Safety_OK : Bool := TRUE;
      i_CMD_Reset : Bool;
      i_CMD_Clear_Stat : Bool;
      i_HW_Setting : "UDT_G115D_Setting";
      i_CFG_Motor_Switch_Time : Int := 500;
      i_CMD_Select_Speed : Int := 1;
      i_CMD_Motor_Run : Bool;
      i_CMD_Motor_Reverse : Bool;
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Reset : Bool;
      o_Req_Halt : Bool;
      o_ER_PN_Not_Present : Bool;
      o_ER_PN_Error : Bool;
      o_ER_Motor_Fault : Bool;
      o_WN_Motor_Alarm : Bool;
      o_ER_STO_Active : Bool;
      o_WN_No_MemoryCard : Bool;
      o_ST_Motor_Running : Bool;
      o_FaultCode : Word;
      o_AlarmCode : Word;
      o_Speed_Selected : Int;
   END_VAR
   VAR_OUTPUT 
      o_Diagnostics : "UDT_G115D_HW_Diagnostics";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_G115D_Interface : "UDT_G115D_HW_Interface";
   END_VAR

   VAR 
      s_FB_SINA_SPEED_TEL1 { S7_SetPoint := 'False'} : "FB_SINA_SPEED_TEL1";
   END_VAR
   VAR RETAIN
      s_Copy : Struct
         Clear_Stat : Bool;
         MTR_Run : Bool;
         MTR_Reverse : Bool;
      END_STRUCT;
      s_Motor_Switch_Action_Delay : Int;
      s_Timer_Reset_Delay : Int;
      s_HW_ConfigAxis : Word := 16#003F;
      s_HW_Actual_Speed : Int;
      s_Motor_Run : Bool;
      s_Switch_In_Progress : Bool;
      s_Stopped_Elapsed : Bool;
      s_CMD_Reset : Bool;
      s_HW_Enabled : Bool;
      s_HW_Lockout : Bool;
      s_HW_Fault : Bool;
      s_HW_Alarm : Bool;
   END_VAR

   VAR_TEMP 
      t_GeoAddr {InstructionName := 'GEOADDR'; LibVersion := '1.0'} : GEOADDR;
      t_Ret_Val_Int : Int;
      t_Start_Address : Int;
      t_Speed_Setpoint : Int;
      t_IO_Available : Bool;
      t_Enable_Axis : Bool;
   END_VAR

   VAR CONSTANT 
      C_RESET_DELAY_TIME : Int := 200;
   END_VAR


BEGIN
	REGION NETOWRK: Initial
	    #o_Ready_To_Reset := FALSE;
	END_REGION
	
	REGION NETOWRK: Diagnose PN Status
	    #t_Ret_Val_Int := LOG2GEO(LADDR := #i_Telegram_HW_ID, GEOADDR := #t_GeoAddr);
	    IF #i_CMD_Reset OR NOT #i_IO_Available THEN
	        #o_ER_PN_Not_Present := FALSE;
	        #o_ER_PN_Error := FALSE;
	    END_IF;
	    IF #i_IO_Available AND (#t_Ret_Val_Int <> 0 OR "DB_Diagnostics".PNIO_System_100.Device_Not_Present[#t_GeoAddr.STATION]) THEN
	        #o_ER_PN_Not_Present := TRUE;
	    END_IF;
	    IF #i_IO_Available AND "DB_Diagnostics".PNIO_System_100.Device_Error[#t_GeoAddr.STATION] THEN
	        #o_ER_PN_Error := TRUE;
	    END_IF;
	    IF
	        #o_ER_PN_Not_Present AND NOT (#t_Ret_Val_Int <> 0 OR "DB_Diagnostics".PNIO_System_100.Device_Not_Present[#t_GeoAddr.STATION])
	        //OR (#o_ER_PN_Error AND NOT "DB_Diagnostics".PNIO_System_100.Device_Error[#t_GeoAddr.STATION])
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    #t_IO_Available := #i_IO_Available AND NOT #o_ER_PN_Not_Present;
	END_REGION
	
	REGION NETWORK: Read IO
	    "FC_IFM_VFD_G115D_In"(i_Telegram_HW_ID            := #i_Telegram_HW_ID,
	                          i_Additional_HW_ID          := #i_Additional_HW_ID,
	                          o_Telegram_Start_Address    => #t_Start_Address,
	                          o_ActualValue_Start_Address => #t_Start_Address,
	                          o_Data                      => #io_G115D_Interface.Input);
	END_REGION
	
	REGION NETOWRK: Motor switch delay
	    IF #i_CMD_Motor_Reverse XOR #s_Copy.MTR_Reverse THEN
	        #s_Switch_In_Progress := TRUE;
	        #o_Diagnostics.Motor_Direction_Switch_Count += 1;
	    END_IF;
	    
	    "FC_Delay_On"(i_CMD_Start     := #s_Motor_Run,
	                  i_CFG_Target    := #i_CFG_Motor_Switch_Time,
	                  i_Cycle_Count   := #io_Global.OB_Prev_Cycle_Time,
	                  o_Delay_Finish => #s_Stopped_Elapsed,
	                  io_Setpoint     := #s_Motor_Switch_Action_Delay);
	    
	    IF NOT #s_Stopped_Elapsed THEN
	        #s_Switch_In_Progress := FALSE;
	    END_IF;
	    #o_Req_Halt := #s_Switch_In_Progress;
	END_REGION
	
	REGION NETOWRK: Reset Pulse
	    "FC_Delay_Off"(i_CMD_Start     := #i_CMD_Reset AND #t_IO_Available,
	                   i_CFG_Target    := #C_RESET_DELAY_TIME,
	                   i_Cycle_Count   := #io_Global.OB_Prev_Cycle_Time,
	                   o_Delay_Finish => #s_CMD_Reset,
	                   io_Setpoint     := #s_Timer_Reset_Delay);
	END_REGION
	
	REGION NETOWRK: Choose Speedsetpoint
	    IF #i_CMD_Select_Speed = 0 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed1;
	    ELSIF #i_CMD_Select_Speed = 1 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed2;
	    ELSIF #i_CMD_Select_Speed = 2 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed3;
	    ELSIF #i_CMD_Select_Speed = 3 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed4;
	    ELSE
	        #o_Speed_Selected := #i_HW_Setting.Speed1;
	    END_IF;
	END_REGION
	
	REGION NETOWRK: 1# Telegram    
	    #s_Motor_Run := #i_CMD_Motor_Run AND #t_IO_Available AND NOT #o_ER_Motor_Fault AND NOT #o_ER_STO_Active AND NOT #s_Switch_In_Progress;
	    
	    #s_HW_ConfigAxis := 16#003F;
	    #s_HW_ConfigAxis.%X3 := #i_Safety_OK;
	    #s_HW_ConfigAxis.%X6 := #i_HW_Setting.ReverseDirection XOR #i_CMD_Motor_Reverse;
	    
	    IF #i_HW_Setting.Magnetization_Delay <= 0 THEN
	        IF #s_Motor_Run THEN
	            #t_Speed_Setpoint := #o_Speed_Selected;
	        ELSE
	            #t_Speed_Setpoint := 0;
	        END_IF;
	        #t_Enable_Axis := #i_Enable AND NOT #o_ER_Motor_Fault AND NOT #o_ER_STO_Active;
	    ELSE
	        #t_Enable_Axis := #s_Motor_Run;
	        #t_Speed_Setpoint := #o_Speed_Selected;
	    END_IF;
	    
	    #s_FB_SINA_SPEED_TEL1(EnableAxis      := #t_Enable_Axis,
	                          AckError        := #s_CMD_Reset,
	                          SpeedSetpoint   := #t_Speed_Setpoint,
	                          RefSpeed        := #i_HW_Setting.RefSpeed,
	                          Acceleration    := #i_HW_Setting.Acceleration,
	                          Deceleration    := #i_HW_Setting.Deceleration,
	                          RefRampTime     := #i_HW_Setting.RefRampTime,
	                          ConfigAxis      := #s_HW_ConfigAxis,
	                          AxisEnabled     => #s_HW_Enabled,
	                          Lockout         => #s_HW_Lockout,
	                          Fault           => #s_HW_Fault,
	                          Alarm           => #s_HW_Alarm,
	                          ActualSpeed     => #s_HW_Actual_Speed,
	                          FaultCode       => #o_FaultCode,
	                          AlarmCode       => #o_AlarmCode,
	                          io_HW_Interface := #io_G115D_Interface);
	END_REGION
	
	REGION NETOWRK: Motor Status
	    #o_ST_Motor_Running := #t_Enable_Axis AND #s_HW_Actual_Speed <> 0;
	    
	    IF #s_CMD_Reset OR NOT #t_IO_Available OR NOT #i_Safety_OK THEN
	        #o_ER_Motor_Fault := FALSE;
	        #o_ER_STO_Active := FALSE;
	    END_IF;
	    
	    IF #t_IO_Available AND #i_Safety_OK AND (#s_HW_Fault OR #s_HW_Lockout) THEN
	        #o_ER_Motor_Fault := TRUE;
	    END_IF;
	    
	    IF #o_ER_Motor_Fault AND NOT (#s_HW_Fault OR #s_HW_Lockout) THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    
	    #o_WN_Motor_Alarm :=  #t_IO_Available AND #i_Safety_OK AND #s_HW_Alarm;
	    #o_WN_No_MemoryCard := #t_IO_Available AND NOT #io_G115D_Interface.Input.ZSW2_G115D_Bit00_Memory_Card_In;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.STOUsed
	        AND (NOT #io_G115D_Interface.Input.ZSW_G115D_Bit02_DI2
	        OR NOT #io_G115D_Interface.Input.ZSW_G115D_Bit03_DI3
	        OR #io_G115D_Interface.Input.ZSW_G115D_Bit06_STOActive)
	    THEN
	        #o_ER_STO_Active := TRUE;
	    END_IF;
	    
	    IF
	        #o_ER_STO_Active
	        AND NOT (NOT #io_G115D_Interface.Input.ZSW_G115D_Bit02_DI2
	        OR NOT #io_G115D_Interface.Input.ZSW_G115D_Bit03_DI3
	        OR #io_G115D_Interface.Input.ZSW_G115D_Bit06_STOActive)
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Write IO
	    "FC_IFM_VFD_G115D_Out"(i_Telegram_HW_ID            := #i_Telegram_HW_ID,
	                           i_Additional_HW_ID          := #i_Additional_HW_ID,
	                           i_Data                      := #io_G115D_Interface.Output,
	                           o_Telegram_Start_Address    => #t_Start_Address,
	                           o_ActualValue_Start_Address => #t_Start_Address);
	END_REGION
	
	REGION NETOWRK: Diagnostics and Statistical
	    #o_Diagnostics.Run_Command := #t_Enable_Axis AND #t_Speed_Setpoint <> 0;
	    #o_Diagnostics.Brake_Open := #io_G115D_Interface.Input.ZSW1_Bit12_Brake;
	    #o_Diagnostics.DI0 := #io_G115D_Interface.Input.ZSW_G115D_Bit00_DI0;
	    #o_Diagnostics.DI1 := #io_G115D_Interface.Input.ZSW_G115D_Bit01_DI1;
	    #o_Diagnostics.DI2 := #io_G115D_Interface.Input.ZSW_G115D_Bit02_DI2;
	    #o_Diagnostics.DI3 := #io_G115D_Interface.Input.ZSW_G115D_Bit03_DI3;
	    #o_Diagnostics.DIO24 := #io_G115D_Interface.Input.ZSW_G115D_Bit04_DIO24 OR #io_G115D_Interface.Output.STW_G115D_Bit00_DO24;
	    #o_Diagnostics.DIO25 := #io_G115D_Interface.Input.ZSW_G115D_Bit05_DIO25 OR #io_G115D_Interface.Output.STW_G115D_Bit01_DO25;
	    #o_Diagnostics.Memory_Card_In := #io_G115D_Interface.Input.ZSW2_G115D_Bit00_Memory_Card_In;
	    #o_Diagnostics.Memory_Card_Active := #io_G115D_Interface.Input.ZSW2_G115D_Bit01_Memory_Card_Active;
	    #o_Diagnostics.PN_Port1_Down := FALSE;
	    #o_Diagnostics.PN_Port2_Down := FALSE;
	    #o_Diagnostics.Actual_Speed := #s_HW_Actual_Speed;
	    #o_Diagnostics.DCLink_Voltage := #io_G115D_Interface.Input.DCLinkVoltage;
	    #o_Diagnostics.Actual_Current := #io_G115D_Interface.Input.ActualCurrent;
	    #o_Diagnostics.Active_Power := #io_G115D_Interface.Input.ActivePower;
	    
	    IF #o_ST_Motor_Running AND NOT #s_Copy.MTR_Run THEN
	        #o_Diagnostics.Motor_Start_Stop_Count += 1;
	    END_IF;
	    
	    IF #o_ST_Motor_Running AND #io_Global.OS_New_Second THEN
	        #o_Diagnostics.Motor_Started_Time += 1;
	    END_IF;
	    
	    IF #i_CMD_Clear_Stat AND NOT #s_Copy.Clear_Stat THEN
	        #o_Diagnostics.Motor_Started_Time := 0;
	        #o_Diagnostics.Motor_Start_Stop_Count := 0;
	        #o_Diagnostics.Motor_Direction_Switch_Count := 0;
	    END_IF;
	END_REGION
	
	REGION NETOWRK: Storage Previous State
	    #s_Copy.MTR_Run := #o_ST_Motor_Running;
	    #s_Copy.MTR_Reverse := #i_CMD_Motor_Reverse;
	    #s_Copy.Clear_Stat := #i_CMD_Clear_Stat;
	END_REGION
	
END_FUNCTION_BLOCK

