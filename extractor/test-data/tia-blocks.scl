      ER_CB_F1113_Trip_GC03_Interroll : Bool;
      ER_CB_F1114_Trip_GC03_SDC01 : Bool;
      ER_CB_F1115_Trip_GC03_SDC02 : Bool;
      ER_CB_F1121_Trip_GC04_Inveter : Bool;
      ER_CB_F1122_Trip_AC05 : Bool;
      ER_CB_F1123_Trip_Reversed : Bool;
      ER_CB_F1131_Trip_GC05_Inveter : Bool;
      ER_CB_F1132_Trip_GC05_Interroll : Bool;
      ER_CB_F1133_Trip_GC06_Inveter : Bool;
      ER_CB_F1134_Trip_GC06_Interroll : Bool;
      ER_CB_F1141_Trip_GC07_Inveter : Bool;
      ER_CB_F1142_Trip_GC07_Interroll : Bool;
      ER_CB_F1151_Trip_GC03_Inveter_Group2 : Bool;
      ER_CB_F1152_Trip_Reversed : Bool;
      ER_CB_F1153_Trip_Reversed : Bool;
      ER_CB_F1154_Trip_Reversed : Bool;
      ER_CB_F1155_Trip_EH01 : Bool;
      ER_CB_F1156_Trip_EH02 : Bool;
      ER_CB_F1157_Trip_EH03 : Bool;
      ER_CB_F1161_Trip_Fan : Bool;
      ER_CB_F1171_Trip_Socket : Bool;
      ER_KM_1641_Trip_GC01_Interroll : Bool;
      ER_KM_1642_Trip_GC01_Interroll : Bool;
      ER_KM_1643_Trip_Reversed : Bool;
      ER_KM_1644_Trip_Reversed : Bool;
      ER_KM_1645_Trip_GC03_Interroll : Bool;
      ER_KM_1646_Trip_GC03_Interroll : Bool;
      ER_KM_1647_Trip_Reversed : Bool;
      ER_KM_1648_Trip_Reversed : Bool;
      ER_KM_1651_Trip_GC05_Interroll : Bool;
      ER_KM_1652_Trip_GC05_Interroll : Bool;
      ER_KM_1653_Trip_GC05_Interroll : Bool;
      ER_KM_1654_Trip_GC05_Interroll : Bool;
      ER_KM_1655_Trip_GC05_Interroll : Bool;
      ER_KM_1656_Trip_GC05_Interroll : Bool;
      Spare_11_7 : Bool;
      Spare_12_0 : Bool;
      Spare_12_1 : Bool;
      Spare_12_2 : Bool;
      Spare_12_3 : Bool;
      Spare_12_4 : Bool;
      Spare_12_5 : Bool;
      Spare_12_6 : Bool;
      Spare_12_7 : Bool;
      Spare_13_0 : Bool;
      Spare_13_1 : Bool;
      Spare_13_2 : Bool;
      Spare_13_3 : Bool;
      Spare_13_4 : Bool;
      Spare_13_5 : Bool;
      Spare_13_6 : Bool;
      Spare_13_7 : Bool;
   END_STRUCT;

END_TYPE

