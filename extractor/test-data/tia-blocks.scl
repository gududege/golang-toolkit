	                                 o_ER_Home_Position_Missing => #s_Servo_Status[8].ER_Home_Position_Missed,
	                                 o_ST_Act_Position          => #s_Servo_Status[8].ST_Act_Position,
	                                 o_AlarmCode                 => #s_Servo_Status[8].AlarmCode,
	                                 o_FaultCode                => #s_Servo_Status[8].ErrorCode,
	                                 io_Global                  := #io_Global,
	                                 io_S210_Interface          := #io_Interface.Servo8);
	    END_REGION
	    
	    REGION U481 Servo
	        #s_U481_FB_SWS_EQP_Servo(i_Telegram_HW_ID           := #i_U481_Telegram_HW_ID,
	                                 i_Additional_HW_ID         := #i_U481_Additional_HW_ID,
	                                 i_IO_Available             := #io_System_Control.IO_Available,
	                                 i_Safety_OK                := #io_System_Control.Safety_OK,
	                                 i_CMD_Reset                := #io_System_Control.OS_Reset,
	                                 i_CMD_Maintenance_Mode     := #io_Command.Man_Mode_Servo,
	                                 i_CMD_Disable_Axis         := #io_Command.Servo_Array[9].Man_Disable_Axis,
	                                 i_CMD_Home                 := #io_Command.Servo_Array[9].Man_Home,
	                                 i_CMD_Jog_Left             := #io_Command.Servo_Array[9].Man_Jog_Left,
	                                 i_CMD_Jog_Right            := #io_Command.Servo_Array[9].Man_Jog_Right,
	                                 i_CMD_Save                 := #io_Command.Servo_Array[9].Man_Save_Parameter,
	                                 i_CMD_Straight             := #s_Servo_Array_Command[9].CMD_Straight,
	                                 i_CMD_Divert_Left          := #s_Servo_Array_Command[9].CMD_Left,
	                                 i_CMD_Divert_Right         := #s_Servo_Array_Command[9].CMD_Right,
	                                 i_HW_Setting               := #i_Setting.Hardware.Servo_U481,
	                                 o_Ready_To_Reset           => #s_Servo_Ready_To_Reset[9],
	                                 o_ER_PN_Not_Present        => #s_Servo_Status[9].ER_PN_NotPresent,
	                                 o_ER_PN_Error              => #s_Servo_Status[9].ER_PN_Error,
	                                 o_ST_Axis_Enabled          => #s_Servo_Status[9].ST_Axis_Enabled,
	                                 o_ST_Position_Reached      => #s_Servo_Status[9].ST_Axis_Position_Reached,
	                                 o_OL_Maintenance_Mode      => #s_Servo_Status[9].OL_Maintenance_Mode,
	                                 o_ER_STO_Active            => #s_Servo_Status[9].ER_STO_Active,
	                                 o_WN_Motor_Alarm           => #s_Servo_Status[9].WN_Servo_Warn,
	                                 o_ER_Motor_Fault           => #s_Servo_Status[9].ER_Servo_Fault,
	                                 o_ER_Home_Position_Missing => #s_Servo_Status[9].ER_Home_Position_Missed,
	                                 o_ST_Act_Position          => #s_Servo_Status[9].ST_Act_Position,
	                                 o_AlarmCode                 => #s_Servo_Status[9].AlarmCode,
	                                 o_FaultCode                => #s_Servo_Status[9].ErrorCode,
	                                 io_Global                  := #io_Global,
	                                 io_S210_Interface          := #io_Interface.Servo9);
	    END_REGION
	END_REGION
	
	REGION NETWORK: Combine System Feedback Status
	    #io_System_Control.Ready_To_Reset := #s_Servo_Ready_To_Reset[1]
	    OR #s_Servo_Ready_To_Reset[2]
	    OR #s_Servo_Ready_To_Reset[3]
	    OR #s_Servo_Ready_To_Reset[4]
	    OR #s_Servo_Ready_To_Reset[5]
	    OR #s_Servo_Ready_To_Reset[6]
	    OR #s_Servo_Ready_To_Reset[7]
	    OR #s_Servo_Ready_To_Reset[8]
	    OR #s_Servo_Ready_To_Reset[9];
	END_REGION
	
	REGION Status Output
	    
	    #o_Status.Roller_Module_1 := #s_Roller_Module_Status[1];
	    #o_Status.Roller_Module_2 := #s_Roller_Module_Status[2];
	    #o_Status.Roller_Module_3 := #s_Roller_Module_Status[3];
	    #o_Status.Roller_Module_4 := #s_Roller_Module_Status[4];
	    #o_Status.Roller_Module_5 := #s_Roller_Module_Status[5];
	    #o_Status.Roller_Module_6 := #s_Roller_Module_Status[6];
	    #o_Status.Roller_Module_7 := #s_Roller_Module_Status[7];
	    #o_Status.Roller_Module_8 := #s_Roller_Module_Status[8];
	    #o_Status.Roller_Module_9 := #s_Roller_Module_Status[9];
	    
	    #o_Status.Servo_1 := #s_Servo_Status[1];
	    #o_Status.Servo_2 := #s_Servo_Status[2];
	    #o_Status.Servo_3 := #s_Servo_Status[3];
	    #o_Status.Servo_4 := #s_Servo_Status[4];
	    #o_Status.Servo_5 := #s_Servo_Status[5];
	    #o_Status.Servo_6 := #s_Servo_Status[6];
	    #o_Status.Servo_7 := #s_Servo_Status[7];
	    #o_Status.Servo_8 := #s_Servo_Status[8];
	    #o_Status.Servo_9 := #s_Servo_Status[9];
	    
	    #o_General_Status.Safety_Stop := NOT #io_System_Control.Safety_OK;
	    #o_General_Status.Off_Line := #io_Command.Man_Mode_Servo OR #io_Command.Man_Mode;
	    #o_General_Status.Manual := #io_Command.Manual_Mode;
	    #o_General_Status.Error := #o_Status.ER_Modbus_Gateway_Initialize_Fault
	    OR #o_Status.ER_Modbus_Gateway_Communication_Fault
	    OR #s_Servo_Status[1].ER_PN_NotPresent
	    OR #s_Servo_Status[2].ER_PN_NotPresent
	    OR #s_Servo_Status[3].ER_PN_NotPresent
	    OR #s_Servo_Status[4].ER_PN_NotPresent
	    OR #s_Servo_Status[5].ER_PN_NotPresent
	    OR #s_Servo_Status[6].ER_PN_NotPresent
	    OR #s_Servo_Status[7].ER_PN_NotPresent
	    OR #s_Servo_Status[8].ER_PN_NotPresent
	    OR #s_Servo_Status[9].ER_PN_NotPresent
	    OR #s_Servo_Status[1].ER_Servo_Fault
	    OR #s_Servo_Status[2].ER_Servo_Fault
	    OR #s_Servo_Status[3].ER_Servo_Fault
	    OR #s_Servo_Status[4].ER_Servo_Fault
	    OR #s_Servo_Status[5].ER_Servo_Fault
	    OR #s_Servo_Status[6].ER_Servo_Fault
	    OR #s_Servo_Status[7].ER_Servo_Fault
	    OR #s_Servo_Status[8].ER_Servo_Fault
	    OR #s_Servo_Status[9].ER_Servo_Fault
	    OR #s_Servo_Status[1].ER_Home_Position_Missed
	    OR #s_Servo_Status[2].ER_Home_Position_Missed
	    OR #s_Servo_Status[3].ER_Home_Position_Missed
	    OR #s_Servo_Status[4].ER_Home_Position_Missed
	    OR #s_Servo_Status[5].ER_Home_Position_Missed
	    OR #s_Servo_Status[6].ER_Home_Position_Missed
	    OR #s_Servo_Status[7].ER_Home_Position_Missed
	    OR #s_Servo_Status[8].ER_Home_Position_Missed
	    OR #s_Servo_Status[9].ER_Home_Position_Missed
	    OR #s_Servo_Status[1].ER_STO_Active
	    OR #s_Servo_Status[2].ER_STO_Active
	    OR #s_Servo_Status[3].ER_STO_Active
	    OR #s_Servo_Status[4].ER_STO_Active
	    OR #s_Servo_Status[5].ER_STO_Active
	    OR #s_Servo_Status[6].ER_STO_Active
	    OR #s_Servo_Status[7].ER_STO_Active
	    OR #s_Servo_Status[8].ER_STO_Active
	    OR #s_Servo_Status[9].ER_STO_Active;
	    
	    #o_General_Status.Warning := #s_Servo_Status[1].WN_Servo_Warn
	    OR #s_Servo_Status[2].WN_Servo_Warn
	    OR #s_Servo_Status[3].WN_Servo_Warn
	    OR #s_Servo_Status[4].WN_Servo_Warn
	    OR #s_Servo_Status[5].WN_Servo_Warn
	    OR #s_Servo_Status[6].WN_Servo_Warn
	    OR #s_Servo_Status[7].WN_Servo_Warn
	    OR #s_Servo_Status[8].WN_Servo_Warn
	    OR #s_Servo_Status[9].WN_Servo_Warn
	    OR #s_Roller_Module_Status[1].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[1].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[1].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[1].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[2].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[2].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[2].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[2].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[3].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[3].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[3].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[3].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[4].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[4].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[4].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[4].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[5].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[5].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[5].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[5].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[6].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[6].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[6].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[6].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[7].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[7].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[7].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[7].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[8].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[8].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[8].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[8].WN_Motor_NotHealthy
	    OR #s_Roller_Module_Status[9].WN_Modbus_Com_Error
	    OR #s_Roller_Module_Status[9].WN_Motor_Blockage
	    OR #s_Roller_Module_Status[9].WN_Motor_NotConnected
	    OR #s_Roller_Module_Status[9].WN_Motor_NotHealthy;
	END_REGION
	
END_FUNCTION_BLOCK

