TYPE "UDT_PEC_Position_Setting"
TITLE = UDT_Sett_PEC
VERSION : 0.1
//Setting of photo electric cell
//# Block Info
//- Title:            UDT_Sett_PEC
//- Comment/Function: Setting of photo electric cell
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      Blockage_Length : DInt := 3000;   // [mm] Delay for detecting a PEC blockage during the running
      Delay_On : DInt := 50;   // [mm] Delay on leading edge of product (flap filter)
      Delay_Off : DInt := 50;   // [mm] Delay off trailing edge of product (flap filter)
      Shifting_Offset : DInt;   // [mm] Shift offset of PE signal
      Handover_Offset : DInt;   // [mm] Distance between PE and the end of section
      Detect_PEC_OnStopped : Bool := TRUE;   // TRUE = Enable delay timer even the section is not running
      Reset_Block_PEC_Oc : Bool;   // TRUE = Allow reset of blockage error with PEC still covered
      Item_On : Bool;   // TRUE = When detect item the input signal should be true FALSE= When detect item the input signal should be false
   END_STRUCT;

END_TYPE

