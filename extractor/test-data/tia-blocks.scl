FUNCTION_BLOCK "FB_Conv_MultiControl"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_IO_PEC_Position : Bool;
      i_IO_PEC_Trigger : Bool;
      i_Setting : "UDT_Conv_MultiControl_Setting";
      i_External_Request : "UDT_External_Request";
      i_Command : "UDT_Conv_MultiControl_Command";
   END_VAR

   VAR_OUTPUT RETAIN
      o_Status : "UDT_Conv_MultiControl_Status";
      o_General_Status : "UDT_General_Status";
      o_Diagnostics : "UDT_Conv_MultiControl_Diagnostics";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_System_Control : "UDT_System_Control";
      io_MultiControl_U01_IO : "UDT_MultiControl_HW_Interface";
      io_MultiControl_U02_IO : "UDT_MultiControl_HW_Interface";
      io_MultiControl_U03_IO : "UDT_MultiControl_HW_Interface";
      io_MultiControl_U04_IO : "UDT_MultiControl_HW_Interface";
      io_FIF_Upstream : "UDT_Flow_Interface";
      io_FIF : "UDT_Flow_Interface";
      io_FIF_Downstream : "UDT_Flow_Interface";
   END_VAR

   VAR 
      s_FB_Displacement_AccDec : "FB_Displacement_AccDec";
      s_FB_EQP_PEC_Position : "FB_EQP_PEC_Position";
      s_FB_EQP_PEC_Trigger : "FB_EQP_PEC_Trigger";
      s_FB_EQP_Transport : "FB_EQP_Transport";
      s_FB_HW_MultiControl_U01 : "FB_HW_MultiControl";
      s_FB_HW_MultiControl_U02 : "FB_HW_MultiControl";
      s_FB_HW_MultiControl_U03 : "FB_HW_MultiControl";
      s_FB_HW_MultiControl_U04 : "FB_HW_MultiControl";
   END_VAR
   VAR RETAIN
      s_Cnt_PEC_Items { S7_SetPoint := 'True'} : Int;
      s_Speed_Select : Int;
      s_SW_Actual_Speed : Int;
      s_HW_U01_Actual_Speed : Int;
      s_HW_U02_Actual_Speed : Int;
      s_HW_U03_Actual_Speed : Int;
      s_HW_U04_Actual_Speed : Int;
      s_CMD_PEC_Preset_Latch : Bool;
      s_CMD_Motor : Bool;
      s_CMD_Motor_Reverse : Bool;
      s_HW_U01_Req_Halt : Bool;
      s_HW_U02_Req_Halt : Bool;
      s_HW_U03_Req_Halt : Bool;
      s_HW_U04_Req_Halt : Bool;
      s_PE_Position_Latch : Bool;
      s_PE_Trigger_Latch : Bool;
      s_Ext_Req_Stop : Bool;
      s_Ext_Req_Halt : Bool;
      s_Ext_Req_Disable_Send : Bool;
      s_Ext_Req_Disable_Recv : Bool;
      s_Ext_Req_Rest_ESave : Bool;
      s_Ext_Req_Clear_Data : Bool;
      s_SW_Motor_OnSpeed : Bool;
      s_HW_Motor_Running : Bool;
   END_VAR

   VAR_TEMP 
      t_PEC_Position_Items : UDInt;
      t_PEC_Trigger_Items : UDInt;
      t_PEC_Position_Ready_To_Reset : Bool;
      t_PEC_Trigger_Ready_To_Reset : Bool;
      t_HW_VFD_U01_Ready_To_Reset : Bool;
      t_HW_VFD_U02_Ready_To_Reset : Bool;
      t_HW_VFD_U03_Ready_To_Reset : Bool;
      t_HW_VFD_U04_Ready_To_Reset : Bool;
      t_ER_Motor_U01_Fault : Bool;
      t_ER_Motor_U02_Fault : Bool;
      t_ER_Motor_U03_Fault : Bool;
      t_ER_Motor_U04_Fault : Bool;
      t_ER_Motor_Fault : Array[1..16] of Bool;
   END_VAR


BEGIN
	REGION NETWORK: Initial
	    
	    FILL_BLK(IN    := FALSE,
	             COUNT := 16,
	             OUT   => #t_ER_Motor_Fault[1]);
	    
	END_REGION
	
	REGION NETWORK AA: Conveyor Cycle Displacement
	    #s_FB_Displacement_AccDec(i_Conveyor_Speed   := #io_FIF.Speed,
	                              i_Accelaration     := #i_Setting.Hardware_U01.Acceleration,
	                              i_Decelaration     := #i_Setting.Hardware_U01.Deceleration,
	                              i_Prev_Cycle_Time  := #io_Global.OB_Prev_Cycle_Time,
	                              i_PPI_Displacement := 0,
	                              i_Section_Run      := #io_FIF.Motor_Run,
	                              o_Motor_On_Speed   => #o_General_Status.Motor_On_Speed,
	                              o_Motor_Stopped    => #io_FIF.Motor_Stopped,
	                              o_Actual_Speed     => #s_SW_Actual_Speed,
	                              o_Displacement     => #io_FIF.Displacement);
	    
	    #o_General_Status.Motor_Stopped := #io_FIF.Motor_Stopped;
	END_REGION
	
	REGION NETWORK BA: Equipment layer - PEC
	    #s_FB_EQP_PEC_Position(i_IO_Available             := #io_System_Control.IO_Available,
	                           i_CMD_Reset                := #io_System_Control.OS_Reset_Jam,
	                           i_CMD_Clear_Stat           := #io_System_Control.OS_Clear_Statistics,
	                           i_CFG_Blockage_Length      := #i_Setting.PE1.Blockage_Length,
	                           i_CFG_Delay_On             := #i_Setting.PE1.Delay_On,
	                           i_CFG_Delay_Off            := #i_Setting.PE1.Delay_Off,
	                           i_CFG_Shifting_Offset      := #i_Setting.PE1.Shifting_Offset,
	                           i_CFG_Handover_Offset      := #i_Setting.PE1.Handover_Offset,
	                           i_CFG_Detect_PEC_OnStopped := #i_Setting.PE1.Detect_PEC_OnStopped,
	                           i_CFG_Reset_Block_PEC_Oc   := #i_Setting.PE1.Reset_Block_PEC_Oc,
	                           i_CFG_Item_On              := #i_Setting.PE1.Item_On,
	                           i_CMD_Preset_Latch         := #s_CMD_PEC_Preset_Latch,
	                           i_CMD_Clear_Data           := #s_Ext_Req_Clear_Data,
	                           i_Cycle_Count              := #io_FIF.Displacement,
	                           i_IO_PEC                   := #i_IO_PEC_Position,
	                           i_Section_Running          := NOT #io_FIF.Motor_Stopped,
	                           o_Ready_To_Reset           => #t_PEC_Position_Ready_To_Reset,
	                           o_ER_PEC_Blockage          => #o_Status.ER_PE1_Blockage,
	                           o_PEC_Filter               => #s_PE_Position_Latch,
	                           o_Handover                 => #io_FIF.Handover,
	                           o_Cnt_Buffer_Used          => #s_Cnt_PEC_Items,
	                           o_Stat_Items               => #t_PEC_Position_Items);
	    
	    #s_FB_EQP_PEC_Trigger(i_IO_Available             := #io_System_Control.IO_Available,
	                          i_CMD_Reset                := #io_System_Control.OS_Reset_Jam,
	                          i_CMD_Clear_Stat           := #io_System_Control.OS_Clear_Statistics,
	                          i_CFG_Blockage_Length      := #i_Setting.PE2.Blockage_Length,
	                          i_CFG_Delay_On             := #i_Setting.PE2.Delay_On,
	                          i_CFG_Delay_Off            := #i_Setting.PE2.Delay_Off,
	                          i_CFG_Detect_PEC_OnStopped := #i_Setting.PE2.Detect_PEC_OnStopped,
	                          i_CFG_Reset_Block_PEC_Oc   := #i_Setting.PE2.Reset_Block_PEC_Oc,
	                          i_CFG_Item_On              := #i_Setting.PE2.Item_On,
	                          i_CMD_Preset_Latch         := false,
	                          i_Cycle_Count              := #io_FIF.Displacement,
	                          i_IO_PEC                   := #i_IO_PEC_Trigger,
	                          i_Section_Running          := NOT #io_FIF.Motor_Stopped,
	                          o_Ready_To_Reset           => #t_PEC_Trigger_Ready_To_Reset,
	                          o_ER_PEC_Blockage          => #o_Status.ER_PE2_Blockage,
	                          o_PEC_Filter               => #s_PE_Trigger_Latch,
	                          o_Stat_Items               => #t_PEC_Trigger_Items);
	    
	    #io_FIF.PECTrigger_Latch := #s_PE_Trigger_Latch;
	END_REGION
	
	REGION NETWORK CA: Conditions to basic control
	    // Condition to request stop
	    #s_Ext_Req_Stop := #o_Status.ER_Motor_1_Fault
	    OR #o_Status.ER_Motor_2_Fault
	    OR #o_Status.ER_Motor_3_Fault
	    OR #o_Status.ER_Motor_4_Fault
	    OR #o_Status.ER_Motor_5_Fault
	    OR #o_Status.ER_Motor_6_Fault
	    OR #o_Status.ER_Motor_7_Fault
	    OR #o_Status.ER_Motor_8_Fault
	    OR #o_Status.ER_Motor_9_Fault
	    OR #o_Status.ER_Motor_10_Fault
	    OR #o_Status.ER_Motor_11_Fault
	    OR #o_Status.ER_Motor_12_Fault
	    OR #o_Status.ER_Motor_13_Fault
	    OR #o_Status.ER_Motor_14_Fault
	    OR #o_Status.ER_Motor_15_Fault
	    OR #o_Status.ER_Motor_16_Fault
	    OR #i_External_Request.Request_Stop;
	    
	    // Condition to request halt
	    #s_Ext_Req_Halt := #s_HW_U01_Req_Halt
	    OR #s_HW_U02_Req_Halt
	    OR #s_HW_U03_Req_Halt
	    OR #s_HW_U04_Req_Halt
	    OR #i_External_Request.Request_Halt
	    OR #i_Command.Man_Mode
	    OR #o_Status.ER_PE1_Blockage
	    OR #o_Status.ER_PE2_Blockage;
	    
	    // Condition to request disable send
	    #s_Ext_Req_Disable_Send := #i_External_Request.Request_Disable_Send;
	    
	    // Condition to request disable receive
	    #s_Ext_Req_Disable_Recv := #i_External_Request.Request_Disable_Receive OR #i_Command.Man_Mode;
	    
	    // Condition to request reset engergy saving
	    #s_Ext_Req_Rest_ESave := #i_External_Request.Request_Reset_EnergySave OR #io_Global.Common_Setting.Disable_Energy_Saving OR #i_Command.Cmd_Reset_ESave OR #s_FB_EQP_PEC_Position.s_PEC_Filter;
	    
	    // Condition to request clear flow interface data
	    #s_Ext_Req_Clear_Data := #i_External_Request.Request_Clear_Data OR (#i_Command.Man_Clear AND #i_Command.Man_Mode);
	END_REGION
	
	REGION NETWORK DA: Equipment Layer - Basic
	    #s_FB_EQP_Transport(i_Enable                 := #io_System_Control.Enable,
	                        i_IO_Available           := #io_System_Control.IO_Available,
	                        i_Safety_OK              := #io_System_Control.Safety_OK,
	                        i_CMD_Reset              := #io_System_Control.OS_Reset,
	                        i_CMD_Start              := #io_System_Control.OS_Start,
	                        i_CMD_Controlled_Stop    := #io_System_Control.Controlled_Stop,
	                        i_End_PEC_Latch          := #s_PE_Position_Latch,
	                        i_Manual_Run             := #i_Command.Man_Run AND #i_Command.Man_Mode,
	                        i_CFG_Slave_Conveyor     := #i_Setting.Base_Conveyor.Slave_Mode,
	                        i_CFG_Enable_DieForward  := #i_Setting.Base_Conveyor.Enable_DieForward,
	                        i_Delay_Waiting_Item     := #i_Setting.Base_Conveyor.Delay_Waiting_Item,
	                        i_Delay_Dieback          := #i_Setting.Base_Conveyor.Delay_Dieback,
	                        i_Delay_Startup          := #i_Setting.Base_Conveyor.Delay_Startup,
	                        i_Delay_Finish_Handover  := #i_Setting.Base_Conveyor.Delay_Finish_Handover,
	                        i_Delay_Energysave       := #i_Setting.Base_Conveyor.Delay_Energysave,
	                        i_Delay_Cascade_Startup  := #i_Setting.Base_Conveyor.Delay_Cascade_Startup,
	                        i_Delay_Cascade_Shutdown := #i_Setting.Base_Conveyor.Delay_Cascade_Shutdown,
	                        i_Delay_Motor_Startup    := 0,
	                        i_Minimum_Gap            := #i_Setting.Flow_Control.Minimum_Gap,
	                        i_Minimum_Head_To_Head   := #i_Setting.Flow_Control.Minimum_Head_To_Head,
	                        i_Ext_Req_Stop           := #s_Ext_Req_Stop,
	                        i_Ext_Req_Halt           := #s_Ext_Req_Halt,
	                        i_Ext_Req_Dis_Send       := #s_Ext_Req_Disable_Send,
	                        i_Ext_Req_Dis_Recv       := #s_Ext_Req_Disable_Recv,
	                        i_Ext_Req_Rst_ESave      := #s_Ext_Req_Rest_ESave,
	                        i_Ext_Req_Clear_Data     := #s_Ext_Req_Clear_Data,
	                        o_Ready_To_Start         => #io_System_Control.Ready_To_Start,
	                        o_ST_Safety_Stop         => #o_General_Status.Safety_Stop,
	                        o_ST_Items               => #o_General_Status.Items,
	                        o_ST_Die_Back            => #o_General_Status.Die_Back,
	                        o_ST_Motor_Running       => #o_General_Status.Motor_Running,
	                        o_ST_Started             => #o_General_Status.Started,
	                        o_ST_Energy_Saving       => #o_General_Status.Energy_Saving,
	                        o_MTR_Run                => #s_CMD_Motor,
	                        io_Global                := #io_Global,
	                        io_FIF_Upstream          := #io_FIF_Upstream,
	                        io_FIF                   := #io_FIF,
	                        io_FIF_Downstream        := #io_FIF_Downstream);
	END_REGION
	
	REGION NETWORK EA: Hardware Layer - Interroll MultiControl 1
	    #s_Speed_Select := #i_External_Request.Request_Speed;
	    
	    #s_FB_HW_MultiControl_U01(i_IO_Available            := #io_System_Control.IO_Available,
	                              i_Safety_OK               := #io_System_Control.Safety_OK,
	                              i_CMD_Reset               := #io_System_Control.OS_Reset,
	                              i_CMD_Clear_Stat          := #io_System_Control.OS_Clear_Statistics,
	                              i_HW_Setting              := #i_Setting.Hardware_U01,
	                              i_CFG_Motor_Switch_Time   := 500,
	                              i_CMD_Select_Speed        := #s_Speed_Select,
	                              i_CMD_Motor_Run           := #s_CMD_Motor,
	                              i_CMD_Motor_Reverse       := #s_CMD_Motor_Reverse,
	                              o_Ready_To_Reset          => #t_HW_VFD_U01_Ready_To_Reset,
	                              o_Req_Halt                => #s_HW_U01_Req_Halt,
	                              o_ER_Motor_1_Fault        => #t_ER_Motor_U01_Fault,
	                              o_ER_Motor_2_Fault        => #t_ER_Motor_U02_Fault,
	                              o_ER_Motor_3_Fault        => #t_ER_Motor_U03_Fault,
	                              o_ER_Motor_4_Fault        => #t_ER_Motor_U04_Fault,
	                              o_Speed_Selected          => #io_FIF.Speed,
	                              o_Diagnostics             => #o_Diagnostics.Hardware_U01,
	                              io_Global                 := #io_Global,
	                              io_MultiControl_Interface := #io_MultiControl_U01_IO);
	    
	    IF #i_Setting.Hardware_U01.RD1_Motor_Number > 0 AND #i_Setting.Hardware_U01.RD1_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U01.RD1_Motor_Number] := #t_ER_Motor_U01_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U01.RD2_Motor_Number > 0 AND #i_Setting.Hardware_U01.RD2_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U01.RD2_Motor_Number] := #t_ER_Motor_U02_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U01.RD3_Motor_Number > 0 AND #i_Setting.Hardware_U01.RD3_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U01.RD3_Motor_Number] := #t_ER_Motor_U03_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U01.RD4_Motor_Number > 0 AND #i_Setting.Hardware_U01.RD4_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U01.RD4_Motor_Number] := #t_ER_Motor_U04_Fault;
	    END_IF;
	END_REGION
	
	REGION NETWORK EB: Hardware Layer - Interroll MultiControl 2
	    #s_Speed_Select := #i_External_Request.Request_Speed;
	    
	    #s_FB_HW_MultiControl_U02(i_IO_Available            := #io_System_Control.IO_Available,
	                              i_Safety_OK               := #io_System_Control.Safety_OK,
	                              i_CMD_Reset               := #io_System_Control.OS_Reset,
	                              i_CMD_Clear_Stat          := #io_System_Control.OS_Clear_Statistics,
	                              i_HW_Setting              := #i_Setting.Hardware_U02,
	                              i_CFG_Motor_Switch_Time   := 500,
	                              i_CMD_Select_Speed        := #s_Speed_Select,
	                              i_CMD_Motor_Run           := #s_CMD_Motor,
	                              i_CMD_Motor_Reverse       := #s_CMD_Motor_Reverse,
	                              o_Ready_To_Reset          => #t_HW_VFD_U02_Ready_To_Reset,
	                              o_Req_Halt                => #s_HW_U02_Req_Halt,
	                              o_ER_Motor_1_Fault        => #t_ER_Motor_U01_Fault,
	                              o_ER_Motor_2_Fault        => #t_ER_Motor_U02_Fault,
	                              o_ER_Motor_3_Fault        => #t_ER_Motor_U03_Fault,
	                              o_ER_Motor_4_Fault        => #t_ER_Motor_U04_Fault,
	                              o_Diagnostics             => #o_Diagnostics.Hardware_U02,
	                              io_Global                 := #io_Global,
	                              io_MultiControl_Interface := #io_MultiControl_U02_IO);
	    
	    IF #i_Setting.Hardware_U02.RD1_Motor_Number > 0 AND #i_Setting.Hardware_U02.RD1_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U02.RD1_Motor_Number] := #t_ER_Motor_U01_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U02.RD2_Motor_Number > 0 AND #i_Setting.Hardware_U02.RD2_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U02.RD2_Motor_Number] := #t_ER_Motor_U02_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U02.RD3_Motor_Number > 0 AND #i_Setting.Hardware_U02.RD3_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U02.RD3_Motor_Number] := #t_ER_Motor_U03_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U02.RD4_Motor_Number > 0 AND #i_Setting.Hardware_U02.RD4_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U02.RD4_Motor_Number] := #t_ER_Motor_U04_Fault;
	    END_IF;
	END_REGION
	
	REGION NETWORK EA: Hardware Layer - Interroll MultiControl 3  
	    #s_Speed_Select := #i_External_Request.Request_Speed;
	    
	    #s_FB_HW_MultiControl_U03(i_IO_Available            := #io_System_Control.IO_Available,
	                              i_Safety_OK               := #io_System_Control.Safety_OK,
	                              i_CMD_Reset               := #io_System_Control.OS_Reset,
	                              i_CMD_Clear_Stat          := #io_System_Control.OS_Clear_Statistics,
	                              i_HW_Setting              := #i_Setting.Hardware_U03,
	                              i_CFG_Motor_Switch_Time   := 500,
	                              i_CMD_Select_Speed        := #s_Speed_Select,
	                              i_CMD_Motor_Run           := #s_CMD_Motor,
	                              i_CMD_Motor_Reverse       := #s_CMD_Motor_Reverse,
	                              o_Ready_To_Reset          => #t_HW_VFD_U03_Ready_To_Reset,
	                              o_Req_Halt                => #s_HW_U03_Req_Halt,
	                              o_ER_Motor_1_Fault        => #t_ER_Motor_U01_Fault,
	                              o_ER_Motor_2_Fault        => #t_ER_Motor_U02_Fault,
	                              o_ER_Motor_3_Fault        => #t_ER_Motor_U03_Fault,
	                              o_ER_Motor_4_Fault        => #t_ER_Motor_U04_Fault,
	                              o_Diagnostics             => #o_Diagnostics.Hardware_U03,
	                              io_Global                 := #io_Global,
	                              io_MultiControl_Interface := #io_MultiControl_U03_IO);
	    
	    IF #i_Setting.Hardware_U03.RD1_Motor_Number > 0 AND #i_Setting.Hardware_U03.RD1_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U03.RD1_Motor_Number] := #t_ER_Motor_U01_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U03.RD2_Motor_Number > 0 AND #i_Setting.Hardware_U03.RD2_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U03.RD2_Motor_Number] := #t_ER_Motor_U02_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U03.RD3_Motor_Number > 0 AND #i_Setting.Hardware_U03.RD3_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U03.RD3_Motor_Number] := #t_ER_Motor_U03_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U03.RD4_Motor_Number > 0 AND #i_Setting.Hardware_U03.RD4_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U03.RD4_Motor_Number] := #t_ER_Motor_U04_Fault;
	    END_IF;
	END_REGION
	
	REGION NETWORK EA: Hardware Layer - Interroll MultiControl 4
	    #s_Speed_Select := #i_External_Request.Request_Speed;
	    
	    #s_FB_HW_MultiControl_U04(i_IO_Available            := #io_System_Control.IO_Available,
	                              i_Safety_OK               := #io_System_Control.Safety_OK,
	                              i_CMD_Reset               := #io_System_Control.OS_Reset,
	                              i_CMD_Clear_Stat          := #io_System_Control.OS_Clear_Statistics,
	                              i_HW_Setting              := #i_Setting.Hardware_U04,
	                              i_CFG_Motor_Switch_Time   := 500,
	                              i_CMD_Select_Speed        := #s_Speed_Select,
	                              i_CMD_Motor_Run           := #s_CMD_Motor,
	                              i_CMD_Motor_Reverse       := #s_CMD_Motor_Reverse,
	                              o_Ready_To_Reset          => #t_HW_VFD_U04_Ready_To_Reset,
	                              o_Req_Halt                => #s_HW_U04_Req_Halt,
	                              o_ER_Motor_1_Fault        => #t_ER_Motor_U01_Fault,
	                              o_ER_Motor_2_Fault        => #t_ER_Motor_U02_Fault,
	                              o_ER_Motor_3_Fault        => #t_ER_Motor_U03_Fault,
	                              o_ER_Motor_4_Fault        => #t_ER_Motor_U04_Fault,
	                              o_Diagnostics             => #o_Diagnostics.Hardware_U04,
	                              io_Global                 := #io_Global,
	                              io_MultiControl_Interface := #io_MultiControl_U04_IO);
	    
	    IF #i_Setting.Hardware_U04.RD1_Motor_Number > 0 AND #i_Setting.Hardware_U04.RD1_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U04.RD1_Motor_Number] := #t_ER_Motor_U01_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U04.RD2_Motor_Number > 0 AND #i_Setting.Hardware_U04.RD2_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U04.RD2_Motor_Number] := #t_ER_Motor_U02_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U04.RD3_Motor_Number > 0 AND #i_Setting.Hardware_U04.RD3_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U04.RD3_Motor_Number] := #t_ER_Motor_U03_Fault;
	    END_IF;
	    
	    IF #i_Setting.Hardware_U04.RD4_Motor_Number > 0 AND #i_Setting.Hardware_U04.RD4_Motor_Number <= 16 THEN
	        #t_ER_Motor_Fault[#i_Setting.Hardware_U04.RD4_Motor_Number] := #t_ER_Motor_U04_Fault;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Copy Motor Alarm to Status
	    
	    #o_Status.ER_Motor_1_Fault := #t_ER_Motor_Fault[1];
	    #o_Status.ER_Motor_2_Fault := #t_ER_Motor_Fault[2];
	    #o_Status.ER_Motor_3_Fault := #t_ER_Motor_Fault[3];
	    #o_Status.ER_Motor_4_Fault := #t_ER_Motor_Fault[4];
	    #o_Status.ER_Motor_5_Fault := #t_ER_Motor_Fault[5];
	    #o_Status.ER_Motor_6_Fault := #t_ER_Motor_Fault[6];
	    #o_Status.ER_Motor_7_Fault := #t_ER_Motor_Fault[7];
	    #o_Status.ER_Motor_8_Fault := #t_ER_Motor_Fault[8];
	    #o_Status.ER_Motor_9_Fault := #t_ER_Motor_Fault[9];
	    #o_Status.ER_Motor_10_Fault := #t_ER_Motor_Fault[10];
	    #o_Status.ER_Motor_11_Fault := #t_ER_Motor_Fault[11];
	    #o_Status.ER_Motor_12_Fault := #t_ER_Motor_Fault[12];
	    #o_Status.ER_Motor_13_Fault := #t_ER_Motor_Fault[13];
	    #o_Status.ER_Motor_14_Fault := #t_ER_Motor_Fault[14];
	    #o_Status.ER_Motor_15_Fault := #t_ER_Motor_Fault[15];
	    #o_Status.ER_Motor_16_Fault := #t_ER_Motor_Fault[16];
	    
	END_REGION
	
	REGION NETWORK: Diagnositcs
	    #o_Diagnostics.RTS := #io_FIF.RTS;
	    #o_Diagnostics.TIP := #io_FIF.TIP;
	    #o_Diagnostics.Downstream_RTR := #io_FIF_Downstream.RTR;
	    #o_Diagnostics.Displacement := #io_FIF.Displacement;
	    #o_Diagnostics.Items_Count := MAX_UDINT(IN1 := #t_PEC_Position_Items, IN2 := #t_PEC_Trigger_Items);
	END_REGION
	
	REGION NETWORK FA: Make Generate Status
	    #o_Status.OL_Maintenance_Mode := #i_Command.Man_Mode;
	    
	    #o_General_Status.Safety_Stop := NOT #io_System_Control.Safety_OK;
	    #o_General_Status.Off_Line := #o_Status.OL_Maintenance_Mode;
	    #o_General_Status.Manual := FALSE;
	    #o_General_Status.Error := #o_Status.ER_Motor_1_Fault
	    OR #o_Status.ER_Motor_2_Fault
	    OR #o_Status.ER_Motor_3_Fault
	    OR #o_Status.ER_Motor_4_Fault
	    OR #o_Status.ER_Motor_5_Fault
	    OR #o_Status.ER_Motor_6_Fault
	    OR #o_Status.ER_Motor_7_Fault
	    OR #o_Status.ER_Motor_8_Fault
	    OR #o_Status.ER_Motor_9_Fault
	    OR #o_Status.ER_Motor_10_Fault
	    OR #o_Status.ER_Motor_11_Fault
	    OR #o_Status.ER_Motor_12_Fault
	    OR #o_Status.ER_Motor_13_Fault
	    OR #o_Status.ER_Motor_14_Fault
	    OR #o_Status.ER_Motor_15_Fault
	    OR #o_Status.ER_Motor_16_Fault;
	    #o_General_Status.Jam := #o_Status.ER_PE1_Blockage OR #o_Status.ER_PE2_Blockage;
	END_REGION
	
	REGION NETWORK EA: System Feedback State
	    #io_System_Control.Ready_To_Reset := #t_PEC_Position_Ready_To_Reset
	    OR #t_PEC_Trigger_Ready_To_Reset
	    OR #t_HW_VFD_U01_Ready_To_Reset
	    OR #t_HW_VFD_U02_Ready_To_Reset
	    OR #t_HW_VFD_U03_Ready_To_Reset
	    OR #t_HW_VFD_U04_Ready_To_Reset;
	END_REGION
END_FUNCTION_BLOCK

TYPE "UDT_GL2S_IO"
VERSION : 0.1
   STRUCT
      IsCleared : Bool;
   END_STRUCT;

END_TYPE

TYPE "UDT_Conv_Triple_G115D_Status"
VERSION : 0.1
   STRUCT
      OL_Maintenance_Mode : Bool;   // Maintenance mode on
      ER_PE1_Blockage : Bool;   // PE1 blockage
      ER_PE2_Blockage : Bool;   // PE2 blockage
      ER_U01_VFD_PN_NotPresent : Bool;   // VFD 1# not present on profinet network
      ER_U01_VFD_PN_Error : Bool;   // VFD 1# has error profinet network
      ER_U01_VFD_Fault : Bool;   // VFD 1# has error
      WN_U01_VFD_Alarm : Bool;   // VFD 1# has an warning
      ER_U01_VFD_STO_Active : Bool;   // VFD 1# STO is active
      WN_U01_No_MemoryCard : Bool;   // Memory card is missing
      ER_U02_VFD_PN_NotPresent : Bool;   // VFD 2# not present on profinet network
      ER_U02_VFD_PN_Error : Bool;   // VFD 2# has error profinet network
      ER_U02_VFD_Fault : Bool;   // VFD 2# has error
      WN_U02_VFD_Alarm : Bool;   // VFD 2# has an warning
      ER_U02_VFD_STO_Active : Bool;   // VFD 2# STO is active
      WN_U02_No_MemoryCard : Bool;   // Memory card is missing
      ER_U03_VFD_PN_NotPresent : Bool;   // VFD 3# not present on profinet network
      ER_U03_VFD_PN_Error : Bool;   // VFD 3# has error profinet network
      ER_U03_VFD_Fault : Bool;   // VFD 3# has error
      WN_U03_VFD_Alarm : Bool;   // VFD 3# has an warning
      ER_U03_VFD_STO_Active : Bool;   // VFD 3# STO is active
      WN_U03_No_MemoryCard : Bool;   // Memory card is missing
      Spare_2_5 : Bool;   // Spare_2_5
      Spare_2_6 : Bool;   // Spare_2_6
      Spare_2_7 : Bool;   // Spare_2_7
      Spare_3_0 : Bool;   // Spare_3_0
      Spare_3_1 : Bool;   // Spare_3_1
      Spare_3_2 : Bool;   // Spare_3_2
      Spare_3_3 : Bool;   // Spare_3_3
      Spare_3_4 : Bool;   // Spare_3_4
      Spare_3_5 : Bool;   // Spare_3_5
      Spare_3_6 : Bool;   // Spare_3_6
      Spare_3_7 : Bool;   // Spare_3_7
      U01_FaultCode : Word;   // VFD 1# fault code
      U01_AlarmCode : Word;   // VFD 1# alarm code
      U02_FaultCode : Word;   // VFD 2# fault code
      U02_AlarmCode : Word;   // VFD 2# alarm code
      U03_FaultCode : Word;   // VFD 3# fault code
      U03_AlarmCode : Word;   // VFD 3# alarm code
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_Conv_SWS"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_New_Item_Present : Bool;
      i_CMD_Divert_Left : Bool;
      i_CMD_Divert_Straight : Bool;
      i_CMD_Divert_Right : Bool;
      i_Setting : "UDT_Conv_SWS_Setting";
      i_External_Request : "UDT_External_Request";
      i_U401_Additional_HW_ID : HW_SUBMODULE;
      i_U401_Telegram_HW_ID : HW_SUBMODULE;
      i_U411_Additional_HW_ID : HW_SUBMODULE;
      i_U411_Telegram_HW_ID : HW_SUBMODULE;
      i_U421_Additional_HW_ID : HW_SUBMODULE;
      i_U421_Telegram_HW_ID : HW_SUBMODULE;
      i_U431_Additional_HW_ID : HW_SUBMODULE;
      i_U431_Telegram_HW_ID : HW_SUBMODULE;
      i_U441_Additional_HW_ID : HW_SUBMODULE;
      i_U441_Telegram_HW_ID : HW_SUBMODULE;
      i_U451_Additional_HW_ID : HW_SUBMODULE;
      i_U451_Telegram_HW_ID : HW_SUBMODULE;
      i_U461_Additional_HW_ID : HW_SUBMODULE;
      i_U461_Telegram_HW_ID : HW_SUBMODULE;
      i_U471_Additional_HW_ID : HW_SUBMODULE;
      i_U471_Telegram_HW_ID : HW_SUBMODULE;
      i_U481_Additional_HW_ID : HW_SUBMODULE;
      i_U481_Telegram_HW_ID : HW_SUBMODULE;
      i_Roller_Gateway_Input_HW_ID : HW_ANY;
      i_Roller_Gateway_Output_HW_ID : HW_ANY;
   END_VAR

   VAR_OUTPUT 
      o_Status : "UDT_Conv_SWS_Status";
      o_General_Status : "UDT_General_Status";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_System_Control : "UDT_System_Control";
      io_Interface : "UDT_SWS_Interface";
      io_Gateway_Interface : "UDT_NT100_Interface";
      io_Command : "UDT_Conv_SWS_Command";
      io_FIF_Upstream : "UDT_Flow_Interface";
      io_FIF : "UDT_Flow_Interface";
      io_FIF_Downstream : "UDT_Flow_Interface";
   END_VAR

   VAR 
      s_FB_Displacement_AccDec : "FB_Displacement_AccDec";
      s_FB_SWS_Roller_Interface : "FB_HW_SWS_Roller_Interface";
      s_FB_EQP_Transport : "FB_EQP_Transport";
      s_Trigger_FB_EQP_PEC_Position : "FB_EQP_PEC_Position";
      s_FB_SWS_Array_Control : "FB_SWS_Array_Control";
      s_U401_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U411_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U421_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U431_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U441_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U451_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U461_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U471_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_U481_FB_SWS_EQP_Servo { S7_SetPoint := 'False'} : "FB_HW_SWS_S210";
      s_Servo_Array_Command : Array[1..#C_ARRAY_COUNT] of Struct
         CMD_Straight : Bool;
         CMD_Left : Bool;
         CMD_Right : Bool;
      END_STRUCT;
      s_Servo_Status { S7_SetPoint := 'False'} : Array[1..#C_ARRAY_COUNT] of "UDT_SWS_Servo_Status";
      s_Roller_Module_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..9] of "UDT_SWS_Roller_Module_Status";
      s_Servo_Ready_To_Reset : Array[1..#C_ARRAY_COUNT] of Bool;
   END_VAR
   VAR RETAIN
      s_SW_Actual_Speed { S7_SetPoint := 'True'} : Int;
      s_CMD_Roller_Run : Bool;
      s_Ext_Req_Stop : Bool;
      s_Ext_Req_Halt : Bool;
      s_Ext_Req_Disable_Send : Bool;
      s_Ext_Req_Disable_Recv : Bool;
      s_Ext_Req_Rest_ESave : Bool;
      s_Ext_Req_Clear_Data : Bool;
   END_VAR

   VAR_TEMP 
      t_GeoAddr {InstructionName := 'GEOADDR'; LibVersion := '1.0'} : GEOADDR;
      t_Ret_Val_Int : Int;   // Temp: Return Value Int
      t_Delayed_Item_Trigger : Bool;
   END_VAR

   VAR CONSTANT 
      C_ARRAY_COUNT : UInt := 9;
   END_VAR


BEGIN
	REGION Conveyor Cycle Displacement
	    #io_FIF.Speed := #i_Setting.Hardware.Roller.Speed_Straight;
	    
	    #s_FB_Displacement_AccDec(i_Conveyor_Speed   := #io_FIF.Speed,
	                              i_Accelaration     := #i_Setting.Hardware.Roller.Acceleration,
	                              i_Decelaration     := #i_Setting.Hardware.Roller.Deceleration,
	                              i_Prev_Cycle_Time  := #io_Global.OB_Prev_Cycle_Time,
	                              i_PPI_Displacement := 0,
	                              i_Section_Run      := #io_FIF.Motor_Run,
	                              o_Motor_On_Speed   => #o_General_Status.Motor_On_Speed,
	                              o_Motor_Stopped    => #io_FIF.Motor_Stopped,
	                              o_Actual_Speed     => #s_SW_Actual_Speed,
	                              o_Displacement     => #io_FIF.Displacement);
	    
	    #o_General_Status.Motor_Stopped := #io_FIF.Motor_Stopped;
	END_REGION
	
	REGION Roller Hardware Interface
	    #s_FB_SWS_Roller_Interface(i_CFG_HW_Port                := #i_Roller_Gateway_Input_HW_ID,
	                               i_IO_Available               := #io_System_Control.IO_Available,
	                               i_OB_First_Scan              := #io_Global.OS_First_Scan,
	                               i_CMD_Reset                  := #io_System_Control.OS_Reset,
	                               i_CFG_Status_Interval        := #i_Setting.Roller_Interface.Status_Interval,
	                               i_CFG_Num_Of_Comm_Error      := #i_Setting.Roller_Interface.Num_Of_Comm_Error,
	                               i_Sett_Roller_Hardware       := #i_Setting.Hardware.Roller,
	                               i_Roller_Running             := #io_FIF.Motor_Run,
	                               o_ER_Modbus_Initialize_Fault => #o_Status.ER_Modbus_Gateway_Initialize_Fault,
	                               o_ER_Modbus_Com_Error        => #o_Status.ER_Modbus_Gateway_Communication_Fault,
	                               o_Modules_Status             => #s_Roller_Module_Status);
	
	END_REGION
	
	REGION Conditions to basic control
	    // Condition to request stop
	    #s_Ext_Req_Stop := #s_Servo_Status[1].ER_PN_NotPresent
	    OR #s_Servo_Status[2].ER_PN_NotPresent
	    OR #s_Servo_Status[3].ER_PN_NotPresent
	    OR #s_Servo_Status[4].ER_PN_NotPresent
	    OR #s_Servo_Status[5].ER_PN_NotPresent
	    OR #s_Servo_Status[6].ER_PN_NotPresent
	    OR #s_Servo_Status[7].ER_PN_NotPresent
	    OR #s_Servo_Status[8].ER_PN_NotPresent
	    OR #s_Servo_Status[9].ER_PN_NotPresent
	    OR #s_Servo_Status[1].ER_Servo_Fault
	    OR #s_Servo_Status[2].ER_Servo_Fault
	    OR #s_Servo_Status[3].ER_Servo_Fault
	    OR #s_Servo_Status[4].ER_Servo_Fault
	    OR #s_Servo_Status[5].ER_Servo_Fault
	    OR #s_Servo_Status[6].ER_Servo_Fault
	    OR #s_Servo_Status[7].ER_Servo_Fault
	    OR #s_Servo_Status[8].ER_Servo_Fault
	    OR #s_Servo_Status[9].ER_Servo_Fault
	    OR #s_Servo_Status[1].ER_Home_Position_Missed
	    OR #s_Servo_Status[2].ER_Home_Position_Missed
	    OR #s_Servo_Status[3].ER_Home_Position_Missed
	    OR #s_Servo_Status[4].ER_Home_Position_Missed
	    OR #s_Servo_Status[5].ER_Home_Position_Missed
	    OR #s_Servo_Status[6].ER_Home_Position_Missed
	    OR #s_Servo_Status[7].ER_Home_Position_Missed
	    OR #s_Servo_Status[8].ER_Home_Position_Missed
	    OR #s_Servo_Status[9].ER_Home_Position_Missed
	    OR #s_Servo_Status[1].ER_STO_Active
	    OR #s_Servo_Status[2].ER_STO_Active
	    OR #s_Servo_Status[3].ER_STO_Active
	    OR #s_Servo_Status[4].ER_STO_Active
	    OR #s_Servo_Status[5].ER_STO_Active
	    OR #s_Servo_Status[6].ER_STO_Active
	    OR #s_Servo_Status[7].ER_STO_Active
	    OR #s_Servo_Status[8].ER_STO_Active
	    OR #s_Servo_Status[9].ER_STO_Active
	    OR #i_External_Request.Request_Stop;
	    
	    // Condition to request halt
	    #s_Ext_Req_Halt := #i_External_Request.Request_Halt OR #io_Command.Man_Mode;
	    
	    // Condition to request disable send
	    #s_Ext_Req_Disable_Send := #i_External_Request.Request_Disable_Send;
	    
	    // Condition to request disable receive
	    #s_Ext_Req_Disable_Recv := #i_External_Request.Request_Disable_Receive OR #io_Command.Man_Mode;
	    
	    // Condition to request reset engergy saving
	    #s_Ext_Req_Rest_ESave := #i_External_Request.Request_Reset_EnergySave OR #io_Global.Common_Setting.Disable_Energy_Saving OR #io_Command.Cmd_Reset_ESave;
	    
	    // Condition to request clear flow interface data
	    #s_Ext_Req_Clear_Data := #i_External_Request.Request_Clear_Data OR (#io_Command.Man_Clear AND #io_Command.Man_Mode);
	END_REGION
	
	REGION Roller Equipment Control
	    
	    #s_FB_EQP_Transport(i_Enable                := #io_System_Control.Enable,
	                        i_IO_Available          := #io_System_Control.IO_Available,
	                        i_Safety_OK             := #io_System_Control.Safety_OK,
	                        i_CMD_Reset             := #io_System_Control.OS_Reset,
	                        i_CMD_Start             := #io_System_Control.OS_Start,
	                        i_CMD_Controlled_Stop   := #io_System_Control.Controlled_Stop,
	                        i_End_PEC_Latch         := FALSE,
	                        i_Manual_Run            := #io_Command.Man_Run AND #io_Command.Man_Mode,
	                        i_CFG_Slave_Conveyor    := #i_Setting.Base_Conveyor.Slave_Mode,
	                        i_CFG_Enable_DieForward := #i_Setting.Base_Conveyor.Enable_DieForward,
	                        i_Delay_Waiting_Item    := #i_Setting.Base_Conveyor.Delay_Waiting_Item,
