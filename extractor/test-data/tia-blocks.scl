FUNCTION_BLOCK "FB_Digital_Signal"
TITLE = FB_Digital_Signal
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : 'Jay Liu'
VERSION : 0.1
//Filter digital signal with delay on and delay off
//
//[DESCRIPTION]
//Filter digital signal with delay on and delay off
//
//[BLOCK_INFO_HEADER]
//-------------------------------------------------------------------------------
// Title:            FB_Digital_Signal
// Comment/Function: Filter digital signal with delay on and delay off
// Library/Family:   APS
// Author:           Jay Liu
// Tested with:      ---
// Engineering:      TIA Portal V20
// Restrictions:     ---
// Requirements:     ---
//-------------------------------------------------------------------------------
// Change log table:
// Version  | Date       | Author                 | Description                  
//----------|------------|------------------------|------------------------------
// 01.00.00 | 2026-01-22 | Jay Liu                | First released version       
   VAR_INPUT RETAIN
      i_Signal : Bool;   // Input signal
      i_CMD_Preset : Bool;   // Command for preset filterd signal
      i_CFG_Dealy_On : DInt;   // Delay on raising edge of signal
      i_CFG_Dealy_Off : DInt;   // Delay off trailing edge of signal
      i_Cycle_Count : DInt;   // Cycle step
   END_VAR

   VAR_OUTPUT RETAIN
      o_Signal_Filtered : Bool;   // Filtered Signal
      o_Signal_Raising_Edge : Bool;   // Raising edge of filterd signal
      o_Signal_Trailing_Edge : Bool;   // Trailing edge of filterd signal
   END_VAR

   VAR RETAIN
      s_Signal_Filtered : Bool;   // Filtered Signal
      s_Copy_Signal : Bool;   // Previous state of input signal
      s_Copy_Signal_Filtered : Bool;   // Previous state of filterd signal
      s_Count_Filter : DInt;   // Count of filter
   END_VAR


BEGIN
	// Monitor change event
	IF #i_Signal XOR #s_Signal_Filtered THEN
	    IF #i_Signal AND NOT #s_Copy_Signal THEN
	        #s_Count_Filter := #i_CFG_Dealy_On;
	    END_IF;
	    
	    IF NOT #i_Signal AND #s_Copy_Signal THEN
	        #s_Count_Filter := #i_CFG_Dealy_Off;
	    END_IF;
	    
	    IF #i_CMD_Preset THEN
	        #s_Count_Filter := 0;
	    END_IF;
	END_IF;
	
	// Timer
	IF #i_Signal XOR #s_Signal_Filtered THEN
	    #s_Count_Filter := #s_Count_Filter - #i_Cycle_Count;
	    IF #s_Count_Filter < 0 THEN
	        #s_Count_Filter := 0;
	    END_IF;
	END_IF;
	
	IF #s_Count_Filter <= 0 THEN
	    #s_Signal_Filtered := #i_Signal;
	END_IF;
	
	// Output
	#o_Signal_Filtered := #s_Signal_Filtered;
	#o_Signal_Raising_Edge := #s_Signal_Filtered AND NOT #s_Copy_Signal_Filtered;
	#o_Signal_Trailing_Edge := NOT #s_Signal_Filtered AND #s_Copy_Signal_Filtered;
	#s_Copy_Signal_Filtered := #s_Signal_Filtered;
	#s_Copy_Signal := #i_Signal;
END_FUNCTION_BLOCK

TYPE "UDT_S210_HW_Interface"
VERSION : 0.1
   STRUCT
      Input { S7_SetPoint := 'False'} : "UDT_S210_HW_Input";
      Output { S7_SetPoint := 'False'} : "UDT_S210_HW_Output";
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_SWS_Array_Control"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CMD_Roller_Run : Bool;
      i_CMD_Straight : Bool;
      i_CMD_Divert_Left : Bool;
      i_CMD_Divert_Right : Bool;
      i_CMD_Manual_Mode : Bool;
      i_CMD_Fixed_Straight : Bool;
      i_CMD_Fixed_Left : Bool;
      i_CMD_Fixed_Right : Bool;
      i_CMD_Fixed_Ratio : Bool;
      i_New_Item_Present : Bool;
      i_Cycle_Count : Int;
      i_Setting : "UDT_SWS_Divert_Setting";
      i_Servos_Status : Array[1..#C_ARRAY_COUNT] of "UDT_SWS_Servo_Status";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_Array_Command : Array[1..#C_ARRAY_COUNT] of Struct
         CMD_Straight : Bool;
         CMD_Left : Bool;
         CMD_Right : Bool;
      END_STRUCT;
      io_Roller_IO_Interface : "UDT_SWS_Roller_IO";
   END_VAR

   VAR 
      s_CMD_Straight : Bool;
      s_CMD_Left : Bool;
      s_CMD_Right : Bool;
      s_Mode_Fixed_Ratio : Bool;
      s_Mode_Auto : Bool;
      s_Copy_CMD_Straight : Bool;
      s_Copy_CMD_Left : Bool;
      s_Copy_CMD_Right : Bool;
      s_Copy_Mode_Fixed_Ratio : Bool;
      s_Copy_Mode_Auto : Bool;
      s_Copy_New_Item_Present : Bool;
      s_OS_New_Item_Present : Bool;
      s_Cnt_Item_Straight : Int;
      s_Cnt_Item_Left : Int;
      s_Cnt_Item_Right : Int;
      s_Array_Control : Array[1..#C_ARRAY_COUNT] of Struct
         Delay_Time : Int;
         Count_Delay_Time : Int;
         Run_Dwn_Delay { S7_SetPoint := 'True'} : Bool;
      END_STRUCT;
   END_VAR

   VAR_TEMP 
      t_Index : UInt;
      t_Announce_Downstream : Bool;
   END_VAR

   VAR CONSTANT 
      C_ARRAY_COUNT : UInt := 9;
   END_VAR


BEGIN
	REGION Build Configuration
	    #s_Array_Control[1].Delay_Time := #i_Setting.Group2_Action_Delay;
	    #s_Array_Control[2].Delay_Time := #i_Setting.Group3_Action_Delay;
	    #s_Array_Control[3].Delay_Time := #i_Setting.Group4_Action_Delay;
	    #s_Array_Control[4].Delay_Time := #i_Setting.Group5_Action_Delay;
	    #s_Array_Control[5].Delay_Time := #i_Setting.Group6_Action_Delay;
	    #s_Array_Control[6].Delay_Time := #i_Setting.Group7_Action_Delay;
	    #s_Array_Control[7].Delay_Time := #i_Setting.Group8_Action_Delay;
	    #s_Array_Control[8].Delay_Time := #i_Setting.Group9_Action_Delay;
	END_REGION
	
	REGION Handle Command
	    #s_CMD_Straight := (#i_CMD_Straight AND NOT #i_CMD_Divert_Left AND NOT #i_CMD_Divert_Right AND NOT #i_CMD_Manual_Mode)
	    OR (#i_CMD_Fixed_Straight AND NOT #i_CMD_Fixed_Left AND NOT #i_CMD_Fixed_Right AND #i_CMD_Manual_Mode);
	    
	    #s_CMD_Left := (NOT #i_CMD_Straight AND #i_CMD_Divert_Left AND NOT #i_CMD_Divert_Right AND NOT #i_CMD_Manual_Mode)
	    OR (NOT #i_CMD_Fixed_Straight AND #i_CMD_Fixed_Left AND NOT #i_CMD_Fixed_Right AND #i_CMD_Manual_Mode);
	    
	    #s_CMD_Right := (NOT #i_CMD_Straight AND NOT #i_CMD_Divert_Left AND #i_CMD_Divert_Right AND NOT #i_CMD_Manual_Mode)
	    OR (NOT #i_CMD_Fixed_Straight AND NOT #i_CMD_Fixed_Left AND #i_CMD_Fixed_Right AND #i_CMD_Manual_Mode);
	    
	    #s_Mode_Fixed_Ratio := #i_CMD_Fixed_Ratio AND #i_CMD_Manual_Mode;
	END_REGION
	
	REGION Fixed Ratio Mode
	    #s_OS_New_Item_Present := #i_New_Item_Present AND NOT #s_Copy_New_Item_Present;
	    IF #s_Mode_Fixed_Ratio THEN
	
	        IF #s_Cnt_Item_Straight <= 0 AND #s_Cnt_Item_Left <= 0 AND #s_Cnt_Item_Right <= 0 THEN
	            #s_Cnt_Item_Straight := #i_Setting.Fixed_Ratio_Staight;
	            #s_Cnt_Item_Left := #i_Setting.Fixed_Ratio_Left;
	            #s_Cnt_Item_Right := #i_Setting.Fixed_Ratio_Right;
	        END_IF;
	        
	        IF #s_OS_New_Item_Present THEN
	            IF #s_Cnt_Item_Left > 0 THEN
	                #s_Array_Control[1].Run_Dwn_Delay := TRUE;
	                #io_Array_Command[1].CMD_Straight := FALSE;
	                #io_Array_Command[1].CMD_Left := TRUE;
	                #io_Array_Command[1].CMD_Right := FALSE;
	                #s_Array_Control[1].Count_Delay_Time := 0;
	                #s_Cnt_Item_Left -= 1;
	            ELSIF #s_Cnt_Item_Straight > 0 THEN
	                #s_Array_Control[1].Run_Dwn_Delay := TRUE;
	                #io_Array_Command[1].CMD_Straight := TRUE;
	                #io_Array_Command[1].CMD_Left := FALSE;
	                #io_Array_Command[1].CMD_Right := FALSE;
	                #s_Array_Control[1].Count_Delay_Time := 0;
	                #s_Cnt_Item_Straight -= 1;
	            ELSIF #s_Cnt_Item_Right > 0 THEN
	                #s_Array_Control[1].Run_Dwn_Delay := TRUE;
	                #io_Array_Command[1].CMD_Straight := FALSE;
	                #io_Array_Command[1].CMD_Left := FALSE;
	                #io_Array_Command[1].CMD_Right := TRUE;
	                #s_Array_Control[1].Count_Delay_Time := 0;
	                #s_Cnt_Item_Right -= 1;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION Divert Command
	    IF #s_CMD_Straight AND NOT #s_Copy_CMD_Straight THEN
	        #s_Array_Control[1].Run_Dwn_Delay := TRUE;
	        #io_Array_Command[1].CMD_Straight := TRUE;
	        #io_Array_Command[1].CMD_Left := FALSE;
	        #io_Array_Command[1].CMD_Right := FALSE;
	        #s_Array_Control[1].Count_Delay_Time := 0;
	    END_IF;
	    
	    IF #s_CMD_Left AND NOT #s_Copy_CMD_Left THEN
	        #s_Array_Control[1].Run_Dwn_Delay := TRUE;
	        #io_Array_Command[1].CMD_Straight := FALSE;
	        #io_Array_Command[1].CMD_Left := TRUE;
	        #io_Array_Command[1].CMD_Right := FALSE;
	        #s_Array_Control[1].Count_Delay_Time := 0;
	    END_IF;
	    
	    IF #s_CMD_Right AND NOT #s_Copy_CMD_Right THEN
	        #s_Array_Control[1].Run_Dwn_Delay := TRUE;
	        #io_Array_Command[1].CMD_Straight := FALSE;
	        #io_Array_Command[1].CMD_Left := FALSE;
	        #io_Array_Command[1].CMD_Right := TRUE;
	        #s_Array_Control[1].Count_Delay_Time := 0;
	    END_IF;
	END_REGION
	
	FOR #t_Index := 1 TO #C_ARRAY_COUNT DO
	    "FC_Delay_On_Accumulator"(i_CMD_Start    := #s_Array_Control[#t_Index].Run_Dwn_Delay,
	                              i_Enable_Dly   := #i_CMD_Roller_Run,
	                              i_CFG_Target   := #s_Array_Control[#t_Index].Delay_Time,
	                              i_Cycle_Count  := #i_Cycle_Count,
	                              o_Delay_Finish => #t_Announce_Downstream,
	                              io_Setpoint    := #s_Array_Control[#t_Index].Count_Delay_Time);
	    
	    IF #t_Index < #C_ARRAY_COUNT AND #t_Announce_Downstream THEN
	        #s_Array_Control[#t_Index].Run_Dwn_Delay := FALSE;
	        #s_Array_Control[#t_Index + 1].Run_Dwn_Delay := TRUE;
	        #io_Array_Command[#t_Index + 1].CMD_Straight := #io_Array_Command[#t_Index].CMD_Straight;
	        #io_Array_Command[#t_Index + 1].CMD_Left := #io_Array_Command[#t_Index].CMD_Left;
	        #io_Array_Command[#t_Index + 1].CMD_Right := #io_Array_Command[#t_Index].CMD_Right;
	    END_IF;
	END_FOR;
	
	REGION Control Roller Speed
	    #io_Roller_IO_Interface.Output.Array1_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[1].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array1_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[1].CMD_Left OR #io_Array_Command[1].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array2_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[2].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array2_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[2].CMD_Left OR #io_Array_Command[2].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array3_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[3].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array3_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[3].CMD_Left OR #io_Array_Command[3].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array4_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[4].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array4_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[4].CMD_Left OR #io_Array_Command[4].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array5_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[5].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array5_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[5].CMD_Left OR #io_Array_Command[5].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array6_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[6].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array6_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[6].CMD_Left OR #io_Array_Command[6].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array7_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[7].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array7_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[7].CMD_Left OR #io_Array_Command[7].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array8_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[8].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array8_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[8].CMD_Left OR #io_Array_Command[8].CMD_Right);
	    #io_Roller_IO_Interface.Output.Array9_Speed1 := #i_CMD_Roller_Run AND NOT #io_Array_Command[9].CMD_Left;
	    #io_Roller_IO_Interface.Output.Array9_Speed2 := #i_CMD_Roller_Run AND (#io_Array_Command[9].CMD_Left OR #io_Array_Command[9].CMD_Right);
	END_REGION
	
	REGION Storage Previous State
	    #s_Copy_CMD_Straight := #s_CMD_Straight;
	    #s_Copy_CMD_Left := #s_CMD_Left;
	    #s_Copy_CMD_Right := #s_CMD_Right;
	    #s_Copy_Mode_Fixed_Ratio := #s_Mode_Fixed_Ratio;
	    #s_Copy_Mode_Auto := #s_Mode_Auto;
	    #s_Copy_New_Item_Present := #i_New_Item_Present;
	END_REGION
	
END_FUNCTION_BLOCK

TYPE "UDT_Conv_S210_Command"
VERSION : 0.1
   STRUCT
      Man_Mode : Bool := false;   // Maintenance mode on
      Man_Clear : Bool := false;   // Maintenance - Clear data
      Man_Run : Bool := false;   // Maintenance - Run motor
      Man_DisableAxis : Bool;   // Maintenance - Disable axis
      Cmd_Reset_ESave : Bool := false;   // Command - Reset energy save
      Cmd_Bypass_Fault : Bool := false;   // Command - Bypass all fault
      Spare_0_6 : Bool := false;   // Spare_0_6
      Spare_0_7 : Bool := false;   // Spare_0_7
      Spare_1_0 : Bool := false;   // Spare_1_0
      Spare_1_1 : Bool := false;   // Spare_1_1
      Spare_1_2 : Bool := false;   // Spare_1_2
      Spare_1_3 : Bool := false;   // Spare_1_3
      Spare_1_4 : Bool := false;   // Spare_1_4
      Spare_1_5 : Bool := false;   // Spare_1_5
      Spare_1_6 : Bool := false;   // Spare_1_6
      Spare_1_7 : Bool := false;   // Spare_1_7
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_HW_SWS_S210"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID : HW_SUBMODULE;
      i_Additional_HW_ID { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : HW_SUBMODULE;
      i_IO_Available : Bool;
      i_Safety_OK : Bool := TRUE;
      i_CMD_Reset : Bool;
      i_CMD_Maintenance_Mode : Bool;
      i_CMD_Disable_Axis : Bool;
      i_CMD_Home : Bool;
      i_CMD_Jog_Left : Bool;
      i_CMD_Jog_Right : Bool;
      i_CMD_Save : Bool;
      i_CMD_Straight : Bool;
      i_CMD_Divert_Left : Bool;
      i_CMD_Divert_Right : Bool;
      i_HW_Setting : "UDT_SWS_Servo_Setting";
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Reset : Bool;
      o_ER_PN_Not_Present : Bool;
      o_ER_PN_Error : Bool;
      o_ST_Axis_Enabled : Bool;
      o_ST_Position_Reached : Bool;
      o_OL_Maintenance_Mode : Bool;
      o_ER_Motor_Fault : Bool;
      o_ER_Home_Position_Missing : Bool;
      o_ER_STO_Active : Bool;
      o_WN_Motor_Alarm : Bool;
      o_ST_Act_Position : Real;
      o_AlarmCode : Word;
      o_FaultCode : Word;
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_S210_Interface : "UDT_S210_HW_Interface";
   END_VAR

   VAR 
      s_FB_SINA_POS_TEL112 : "FB_SINA_POS_TEL112";
      s_FB_SINA_Save_Parameter : "FB_SINA_Save_Parameter";
   END_VAR
   VAR RETAIN
      s_SW_In { S7_SetPoint := 'False'} : "UDT_S210_SW_Input";
      s_SW_Out { S7_SetPoint := 'False'} : "UDT_S210_SW_Output";
      s_Actual_Value : Struct
         ZSW_S210_Bit08_Reserved : Bool;
         ZSW_S210_Bit09_Reserved : Bool;
         ZSW_S210_Bit10_Reserved : Bool;
         ZSW_S210_Bit11_Reserved : Bool;
         ZSW_S210_Bit12_Reserved : Bool;
         ZSW_S210_Bit13_Reserved : Bool;
         ZSW_S210_Bit14_Reserved : Bool;
         ZSW_S210_Bit15_Reserved : Bool;
         ZSW_S210_Bit00_DI0 : Bool;
         ZSW_S210_Bit01_DI1 : Bool;
         ZSW_S210_Bit02_DI2 : Bool;
         ZSW_S210_Bit03_DI3 : Bool;
         ZSW_S210_Bit04_DI4 : Bool;
         ZSW_S210_Bit05_Reserved : Bool;
         ZSW_S210_Bit06_Reserved : Bool;
         ZSW_S210_Bit07_Reserved : Bool;
         DCLinkVoltage : Int;
         ActualCurrent : Int;
         ActivePower : Int;
      END_STRUCT;
      s_Timer_Reset_Delay { S7_SetPoint := 'True'} : Int;
      s_Copy_CMD_Straight : Bool;
      s_Copy_CMD_Left : Bool;
      s_Copy_CMD_Right : Bool;
      s_Copy_CMD_Save : Bool;
   END_VAR

   VAR_TEMP 
      t_GeoAddr {InstructionName := 'GEOADDR'; LibVersion := '1.0'} : GEOADDR;
      t_Ret_Val_Int : Int;   // Temp: Return Value Int
      t_Start_Address : Int;
      t_IO_Available : Bool;
      t_Actual_Telegram_HWID : HW_ANY;
   END_VAR

   VAR CONSTANT 
      C_RESET_DELAY_TIME : Int := 200;
      C_MODE_ABSOLUTE_POSITION : Int := 2;
      C_MODE_SET_HOME_POSITION : Int := 5;
      C_MODE_JOG : Int := 7;
      C_MODE_ADJUST_ENCODER : Int := 9;
   END_VAR


BEGIN
	REGION NETOWRK: Initial
	    #o_Ready_To_Reset := FALSE;
	END_REGION
	
	REGION NETOWRK: Diagnose PN Status
	    #t_Ret_Val_Int := LOG2GEO(LADDR := #i_Telegram_HW_ID, GEOADDR := #t_GeoAddr);
	    IF #i_CMD_Reset OR NOT #i_IO_Available THEN
	        #o_ER_PN_Not_Present := FALSE;
	        #o_ER_PN_Error := FALSE;
	    END_IF;
	    IF #i_IO_Available AND (#t_Ret_Val_Int <> 0 OR "DB_Diagnostics".PNIO_System_100.Device_Not_Present[#t_GeoAddr.STATION]) THEN
	        #o_ER_PN_Not_Present := TRUE;
	    END_IF;
	    IF #i_IO_Available AND "DB_Diagnostics".PNIO_System_100.Device_Error[#t_GeoAddr.STATION] THEN
	        #o_ER_PN_Error := TRUE;
	    END_IF;
	    IF
	        #o_ER_PN_Not_Present AND NOT (#t_Ret_Val_Int <> 0 OR "DB_Diagnostics".PNIO_System_100.Device_Not_Present[#t_GeoAddr.STATION])
	        //OR (#o_ER_PN_Error AND NOT ""DB_Diagnostics"".PNIO_System_100.Device_Error[#t_GeoAddr.STATION])
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    #t_IO_Available := #i_IO_Available AND NOT #o_ER_PN_Not_Present;
	END_REGION
	
	REGION NETWORK: Read IO
	    IF NOT #io_Global.PLC_Is_Simulated THEN
	        "FC_IFM_VFD_S210_In"(i_Telegram_HW_ID            := #i_Telegram_HW_ID,
	                             i_Additional_HW_ID          := #i_Additional_HW_ID,
	                             o_Telegram_Start_Address    => #t_Start_Address,
	                             o_ActualValue_Start_Address => #t_Start_Address,
	                             o_Data                      => #io_S210_Interface.Input);
	    END_IF;
	END_REGION
	
	REGION NETOWRK: Fixed Value
	    #s_SW_In.OverV := 100;
	END_REGION
	
	REGION NETOWRK: Reset Pulse    
	    "FC_Delay_Off"(i_CMD_Start     := #i_CMD_Reset AND #t_IO_Available,
	                   i_CFG_Target    := #C_RESET_DELAY_TIME,
	                   i_Cycle_Count   := #io_Global.OB_Prev_Cycle_Time,
	                   o_Delay_Finish => #s_SW_In.AckError,
	                   io_Setpoint     := #s_Timer_Reset_Delay);
	END_REGION
	
	REGION NETOWRK: Axis Enable
	    #s_SW_In.Enbale := NOT #i_CMD_Disable_Axis AND #t_IO_Available AND #i_Safety_OK AND NOT #s_SW_Out.Lockout AND NOT #s_SW_Out.AxisError;
	END_REGION
	
	REGION NETOWRK: Auto Mode
	    IF NOT #i_CMD_Maintenance_Mode THEN
	        #s_SW_In.Mode := #C_MODE_ABSOLUTE_POSITION;
	        #s_SW_In.ConfigEPOS := 16#00000003;
	        #s_SW_In.CancelTraversing := TRUE;
	        #s_SW_In.IntermediateStop := TRUE;
	        IF #i_HW_Setting.Enable_Soft_Limit THEN
	            #s_SW_In.ConfigEPOS.%X2 := TRUE;
	        END_IF;
	        IF #i_HW_Setting.Enable_Hard_Limit THEN
	            #s_SW_In.ConfigEPOS.%X3 := TRUE;
	        END_IF;
	        IF #i_HW_Setting.Continuous_Action_Mode THEN
	            #s_SW_In.ConfigEPOS.%X8 := TRUE;
	        END_IF;
	        #s_SW_In.Velocity := INT_TO_REAL(LIMIT_INT(MN := 0, IN := #i_HW_Setting.Speed_Setpoint, MX := #i_HW_Setting.Max_Speed));
	        #s_SW_In.Acceleration := INT_TO_REAL(#i_HW_Setting.Acc_Setpoint);
	        #s_SW_In.Deceleration := INT_TO_REAL(#i_HW_Setting.Dec_Setpoint);
	        
	        IF #i_CMD_Straight THEN
	            #s_SW_In.Position := 0.0;
	        ELSIF #i_CMD_Divert_Left THEN
	            #s_SW_In.Position := INT_TO_REAL(LIMIT_INT(MN := #i_HW_Setting.Max_Left_Position, IN := #i_HW_Setting.Left_Position_Setpoint, MX := 0));
	        ELSIF #i_CMD_Divert_Right THEN
	            #s_SW_In.Position := INT_TO_REAL(LIMIT_INT(MN := 0, IN := #i_HW_Setting.Right_Position_Setpoint, MX := #i_HW_Setting.Max_Right_Position));
	        END_IF;
	        
	        #s_SW_In.ExecuteMode := FALSE;
	        IF
	            (#i_CMD_Straight AND NOT #s_Copy_CMD_Straight
	            AND NOT #i_CMD_Divert_Left
	            AND NOT #i_CMD_Divert_Right)
	            OR (#i_CMD_Divert_Left AND NOT #s_Copy_CMD_Left
	            AND NOT #i_CMD_Straight
	            AND NOT #i_CMD_Divert_Right)
	            OR (#i_CMD_Divert_Right AND NOT #s_Copy_CMD_Right
	            AND NOT #i_CMD_Straight
	            AND NOT #i_CMD_Divert_Left)
	        THEN
	            #s_SW_In.ExecuteMode := TRUE;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION NETOWRK: Maintenance Mode
	    IF #i_CMD_Maintenance_Mode THEN
	        #s_SW_In.ExecuteMode := FALSE;
	        
	        REGION Home Mode
	            IF
	                #i_CMD_Home
	                AND NOT (#i_CMD_Jog_Left OR #i_CMD_Jog_Right)
	            THEN
	                #s_SW_In.Mode := #C_MODE_ADJUST_ENCODER;
	                #s_SW_In.ExecuteMode := TRUE;
	            END_IF;
	        END_REGION
	        
	        REGION Jog Mode
	            IF
	                (#i_CMD_Jog_Left
	                XOR #i_CMD_Jog_Right)
	                AND NOT #i_CMD_Home
	            THEN
	                #s_SW_In.Mode := #C_MODE_JOG;
	                #s_SW_In.ConfigEPOS := 16#00000003;
	                #s_SW_In.CancelTraversing := TRUE;
	                #s_SW_In.IntermediateStop := TRUE;
	                #s_SW_In.Jog_Left := #i_CMD_Jog_Left;
	                #s_SW_In.Jog_Right := #i_CMD_Jog_Right;
	                #s_SW_In.Positive := FALSE;
	                #s_SW_In.Negative := FALSE;
	            ELSE
	                #s_SW_In.Jog_Left := FALSE;
	                #s_SW_In.Jog_Right := FALSE;
	            END_IF;
	        END_REGION
	        
	        REGION Save Parameter
	            #s_FB_SINA_Save_Parameter(i_Trigger  := #i_CMD_Save AND NOT #s_Copy_CMD_Save AND NOT (#i_CMD_Jog_Left OR #i_CMD_Jog_Right) AND NOT #i_CMD_Home,
	                                      i_VFD_Type := 2,
	                                      i_HW_ID    := #i_Telegram_HW_ID);
	            #s_Copy_CMD_Save := #i_CMD_Save;
	        END_REGION
	    END_IF;
	END_REGION
	
	 REGION NETOWRK: Siemens Telegram 112
	    #s_SW_In.ConfigEPOS.%X1 := #i_Safety_OK;
	    
	    #s_FB_SINA_POS_TEL112(modePos          := #s_SW_In.Mode,
	                          enableAxis       := #s_SW_In.Enbale,
	                          cancelTraversing := #s_SW_In.CancelTraversing,
	                          intermediateStop := #s_SW_In.IntermediateStop,
	                          positive         := #s_SW_In.Positive,
	                          negative         := #s_SW_In.Negative,
	                          jog1             := #s_SW_In.Jog_Left,
	                          jog2             := #s_SW_In.Jog_Right,
	                          flyRef           := #s_SW_In.FlyRef,
	                          ackError         := #s_SW_In.AckError,
	                          executeMode      := #s_SW_In.ExecuteMode,
	                          position         := #s_SW_In.Position,
	                          velocity         := #s_SW_In.Velocity,
	                          overV            := #s_SW_In.OverV,
	                          acceleration     := #s_SW_In.Acceleration,
	                          deceleration     := #s_SW_In.Deceleration,
	                          fixStopTorque    := #s_SW_In.FixStopTorque,
	                          refCoordinate    := #s_SW_In.RefCoordinate,
	                          configEPOS       := #s_SW_In.ConfigEPOS,
	                          axisEnabled      => #s_SW_Out.AxisEnabled,
	                          axisPosOk        => #s_SW_Out.AxisPosOk,
	                          axisSpFixed      => #s_SW_Out.AxisSpFixed,
	                          axisRef          => #s_SW_Out.AxisRef,
	                          axisWarn         => #s_SW_Out.AxisWarn,
	                          axisError        => #s_SW_Out.AxisError,
	                          lockOut          => #s_SW_Out.Lockout,
	                          actVelocity      => #s_SW_Out.ActVelocity,
	                          actPosition      => #s_SW_Out.ActPosition,
	                          actMode          => #s_SW_Out.ActMode,
	                          actWarn          => #s_SW_Out.AlarmCode,
	                          actFault         => #s_SW_Out.FaultCode,
	                          error            => #s_SW_Out.Error,
	                          status           => #s_SW_Out.Status,
	                          diagID           => #s_SW_Out.DiagID,
	                          InputData        := #io_S210_Interface.Input,
	                          OutputData       := #io_S210_Interface.Output);
	    
	    #o_FaultCode := #s_SW_Out.FaultCode;
	    #o_AlarmCode := #s_SW_Out.AlarmCode;
	END_REGION
	
	REGION NETOWRK: Motor Status
	    IF #s_SW_In.AckError OR NOT #t_IO_Available OR NOT #i_Safety_OK THEN
	        #o_ER_Motor_Fault := FALSE;
	        #o_WN_Motor_Alarm := FALSE;
	        #o_ER_STO_Active := FALSE;
	        #o_ER_Home_Position_Missing := FALSE;
	    END_IF;
	    
	    IF #t_IO_Available AND #i_Safety_OK AND (#s_SW_Out.AxisError OR #s_SW_Out.Lockout) THEN
	        #o_ER_Motor_Fault := TRUE;
	    END_IF;
	    
	    IF #o_ER_Motor_Fault AND NOT (#s_SW_Out.AxisError OR #s_SW_Out.Lockout) THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    
	    IF #t_IO_Available AND #i_Safety_OK AND NOT #s_SW_Out.AxisRef THEN
	        #o_ER_Home_Position_Missing := TRUE;
	    END_IF;
	    
	    IF #o_ER_Home_Position_Missing AND #s_SW_Out.AxisRef THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    
	    #o_WN_Motor_Alarm := #t_IO_Available AND #i_Safety_OK AND #s_SW_Out.AxisWarn;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.STOUsed
	        AND (NOT #s_Actual_Value.ZSW_S210_Bit02_DI2
	        OR NOT #s_Actual_Value.ZSW_S210_Bit03_DI3)
	    THEN
	        #o_ER_STO_Active := TRUE;
	    END_IF;
	    
	    IF
	        #o_ER_STO_Active
	        AND NOT (NOT #s_Actual_Value.ZSW_S210_Bit02_DI2
	        OR NOT #s_Actual_Value.ZSW_S210_Bit03_DI3)
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Write IO
	    "FC_IFM_VFD_S210_Out"(i_Telegram_HW_ID            := #i_Telegram_HW_ID,
	                          i_Data                      := #io_S210_Interface.Output,
	                          o_Telegram_Start_Address    => #t_Start_Address,
	                          o_ActualValue_Start_Address => #t_Start_Address);
	END_REGION
	
	REGION NETOWRK: Report Status
	    #o_OL_Maintenance_Mode := #i_CMD_Maintenance_Mode;
	    #o_ST_Axis_Enabled := #s_SW_Out.AxisEnabled;
	    #o_ST_Position_Reached := #s_SW_Out.AxisPosOk;
	    #o_ST_Act_Position := #s_SW_Out.ActPosition;
	END_REGION
	
	REGION NETOWRK: Storage State
	    #s_Copy_CMD_Straight := #i_CMD_Straight;
	    #s_Copy_CMD_Left := #i_CMD_Divert_Left;
	    #s_Copy_CMD_Right := #i_CMD_Divert_Right;
	END_REGION
	
END_FUNCTION_BLOCK

