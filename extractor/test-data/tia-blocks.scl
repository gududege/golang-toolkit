TYPE "UDT_SSM_Status"
TITLE = UDT_Status_SSM
VERSION : 0.1
//Status for start stop manager
//# Block Info
//- Title:            UDT_Status_SSM
//- Comment/Function: Status for start stop manager
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      Started : Bool := FALSE;   // Started
      Starting : Bool := FALSE;   // Starting
      Stopped : Bool := FALSE;   // Stopped
      Stopping : Bool := FALSE;   // Stopping
      Ready_To_Restart : Bool := FALSE;   // Ready to restart
      Ready_To_Reset : Bool := FALSE;   // Ready to reset
      Spare_0_6 : Bool := FALSE;   // Spare_0_6
      Spare_0_7 : Bool := FALSE;   // Spare_0_7
      Spare_1_0 : Bool := FALSE;   // Spare_1_0
      Spare_1_1 : Bool := FALSE;   // Spare_1_1
      Spare_1_2 : Bool := FALSE;   // Spare_1_2
      Spare_1_3 : Bool := FALSE;   // Spare_1_3
      Spare_1_4 : Bool := FALSE;   // Spare_1_4
      Spare_1_5 : Bool := FALSE;   // Spare_1_5
      Spare_1_6 : Bool := FALSE;   // Spare_1_6
      Spare_1_7 : Bool := FALSE;   // Spare_1_7
   END_STRUCT;

END_TYPE

TYPE "UDT_SDC_4Servos_Status"
TITLE = UDT_Status_MCC
VERSION : 0.1
//Status of main control cabinet
//# Block Info
//- Title:            UDT_Status_MCC
//- Comment/Function: Status of main control cabinet
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      ER_Main_Switch_Trip : Bool;   // Main switch on cabinet is off
      ER_CB_Q0111_Trip_PowerSupply : Bool;   // Circuit breaker of power supply is off
      ER_Power_Supply_G0111_Fault : Bool;   // 24V Power supply is not ok
      ER_CB_F1002_Trip_Fan : Bool;   // Circuit breaker of fan is off
      WN_Cabinet_Temperature_High : Bool;   // Temperature is high in cabinet
      ER_CB_Q1041_Trip_Servo1 : Bool;   // Motor power of 1# servo is off
      ER_CB_F1041_Trip_Servo1 : Bool;   // Control power of 1# servo is off
      ER_CB_Q1051_Trip_Servo2 : Bool;   // Motor power of 2# servo is off
