TYPE "UDT_G115D_HW_Input"
VERSION : 0.1
   STRUCT
      ZSW1_Bit00_ReadyOn : Bool;   // 0: Ready for switching on
      ZSW1_Bit01_Ready : Bool;   // 1: Ready (operating condition)
      ZSW1_Bit02_Enabled : Bool;   // 2: Operation enabled
      ZSW1_Bit03_Fault : Bool;   // 3: Fault present (1: fault)
      ZSW1_Bit04_NoCoastActive : Bool;   // 4: No coast down active (0: active)
      ZSW1_Bit05_NoQuickStopActive : Bool;   // 5: No quick stop active (0: active)
      ZSW1_Bit06_Inhibit : Bool;   // 6: Switching on inhibited
      ZSW1_Bit07_Alarm : Bool;   // 7: Alarm present (1: alarm)
      ZSW1_Bit08_DeviationOK : Bool;   // 8: Setpoint/actual value deviation
      ZSW1_Bit09_ControlQuest : Bool;   // 9: Control requested
      ZSW1_Bit10_OverSpeed : Bool;   // 10: f or n comparison value reached
      ZSW1_Bit11_Limit : Bool;   // 11: Torque limit not reached
      ZSW1_Bit12_Brake : Bool;   // 12: Holding brake open
      ZSW1_Bit13_MotorTempOK : Bool;   // 13: Motor temperature OK (1: OK)
      ZSW1_Bit14_Direction_CW : Bool;   // 14: n_act >= 0 (1: positive)
      ZSW1_Bit15_VFDTempOK : Bool;   // 15: Reserved Speed actual value (NIST_A)
      NIST_A : Int;   // Actual speed (-16384 to +16384)
      ZSW_G115D_Bit00_DI0 : Bool;   // 0: Digital input 0 status
      ZSW_G115D_Bit01_DI1 : Bool;   // 1: Digital input 1 status
      ZSW_G115D_Bit02_DI2 : Bool;   // 2: Digital input 2 status
      ZSW_G115D_Bit03_DI3 : Bool;   // 3: Digital input 3 status
      ZSW_G115D_Bit04_DIO24 : Bool;   // 4: DI/O 24 status
      ZSW_G115D_Bit05_DIO25 : Bool;   // 5: DI/O 25 status
      ZSW_G115D_Bit06_STOActive : Bool;   // 6: STO is active
      ZSW_G115D_Bit07_Reserved : Bool;   // 7: Reserved
      ZSW_G115D_Bit08_PowerOff : Bool;   // 8: Power switch OFF status
      ZSW_G115D_Bit09_Auto : Bool;   // 9: Automatic mode active
      ZSW_G115D_Bit10_Manual : Bool;   // 10: Manual mode active
      ZSW_G115D_Bit11_Bypass : Bool;   // 11: Stop/Slow bypass activated
      ZSW_G115D_Bit12_ContMotion : Bool;   // 12: Continuous motion activated
      ZSW_G115D_Bit13_JogLeft : Bool;   // 13: Motor jogging to the left
      ZSW_G115D_Bit14_JogRight : Bool;   // 14: Motor jogging to the right
      ZSW_G115D_Bit15_Reserved : Bool;   // 15: Reserved Fault and alarm codes
      FaultCode : Word;   // Fault code (0: no fault)
      AlarmCode : Word;   // Alarm code (0: no alarm)
      DCLinkVoltage : Int;   // DC link voltage [V]
      ActualCurrent : Int;   // Actual current [0.1A]
      ActivePower : Int;   // Active power [W]
      ZSW2_G115D_Bit00_Memory_Card_In : Bool;
      ZSW2_G115D_Bit01_Memory_Card_Active : Bool;
      ZSW2_G115D_Bit02_Memory_Card_Siemens : Bool;
      ZSW2_G115D_Bit03_Memory_Card_USB : Bool;
      ZSW2_G115D_Bit04_Reserved : Bool;
      ZSW2_G115D_Bit05_Reserved : Bool;
      ZSW2_G115D_Bit06_Reserved : Bool;
      ZSW2_G115D_Bit07_Reserved : Bool;
      ZSW2_G115D_Bit08_Reserved : Bool;
      ZSW2_G115D_Bit09_Reserved : Bool;
      ZSW2_G115D_Bit10_Reserved : Bool;
      ZSW2_G115D_Bit11_Reserved : Bool;
      ZSW2_G115D_Bit12_Reserved : Bool;
      ZSW2_G115D_Bit13_Reserved : Bool;
      ZSW2_G115D_Bit14_Reserved : Bool;
      ZSW2_G115D_Bit15_Reserved : Bool;
   END_STRUCT;

END_TYPE

