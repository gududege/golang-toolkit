TYPE "UDT_Flow_Interface"
TITLE = UDT_Flow_Interface
VERSION : 0.1
//Flow interface of each section and unit
//# Block Info
//- Title:            UDT_Flow_Interface
//- Comment/Function: Flow interface of each section and unit
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      Item_at_Handover : Bool;   // [Up -> Down] Item at Handover position
      RTS : Bool;   // [Up -> Down] Ready To Send
      RTR : Bool;   // [Down -> Up] Ready To Receive
      TIP : Bool;   // [Up -> Down] Transfer in progress
      Handover : Bool;   // [Up -> Down] Handover Item
      Operational : Bool;   // [Down -> Up] Section is operational on
      Available : Bool;   // [Down -> Up] Section is available
      Cascade_Startup : Bool;   // [Down -> Up] Cascade start up upstream
      Cascade_Shutdown : Bool;   // [Up -> Down] Cascade shutdown downstream
      Motor_Run : Bool;   // [Down -> Up] Motor is running
      Motor_Stopped : Bool;   // [Down -> Up] Motor is stopped
      Receive_Item : Bool;   // [Down -> Up] Waiting item to the End PEC
      Items : Bool;   // [Down -> Up] Section have items
      PECPosition_Latch : Bool;   // [Up -> Down] PEC Latch at the end
      PECTrigger_Latch : Bool;   // [Up -> Down] PEC Latch on the conveyor
      Data_Sync : Bool;   // [Up -> Down] (One-shot) Hand-Over of data
      Req_Up_Disable_Send : Bool;   // [Down -> Up] Request Disable send new products
      Req_Upstream_Halt : Bool;   // [Down -> Up] Request Halt Upstream
      Req_Down_Reset_E_Saving : Bool;   // [Up -> Down] Request Reset energy saving
      Req_Down_Disable_Receive : Bool;   // [Up -> Down] Request Disable receiving new products
      Req_Downstream_Halt : Bool;   // [Up -> Down] Request Halt Downstream
      Speed : Int;   // [mm/s] Speed setpoint
      Displacement : Int;   // [mm] Cycle displacement
      Data : Int;   // Tracking Data
   END_STRUCT;

END_TYPE

