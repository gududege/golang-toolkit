FUNCTION_BLOCK "FB_EQP_PEC_Trigger"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_IO_Available : Bool;
      i_CMD_Reset : Bool;
      i_CMD_Clear_Stat : Bool;
      i_CFG_Blockage_Length : DInt;
      i_CFG_Delay_On : DInt;
      i_CFG_Delay_Off : DInt;
      i_CFG_Detect_PEC_OnStopped : Bool;
      i_CFG_Reset_Block_PEC_Oc : Bool;
      i_CFG_Item_On : Bool;
      i_CMD_Preset_Latch : Bool;
      i_Cycle_Count : Int;
      i_IO_PEC : Bool;
      i_Section_Running : Bool;
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Reset : Bool;
      o_ER_PEC_Blockage : Bool;   // ST: PEC blockage
      o_PEC_Filter : Bool;
      o_Stat_Items : UDInt;
   END_VAR

   VAR 
      s_FB_Digital_Signal { S7_SetPoint := 'False'} : "FB_Digital_Signal";
   END_VAR
   VAR RETAIN
      s_Cycle_Count : Int;
      s_Cnt_Blockage : DInt;
      s_ER_PEC_Blockage : Bool;
      s_PEC_Filter : Bool;
      s_OS_FP_PEC_Latch : Bool;
      s_OS_FN_PEC_Latch : Bool;
   END_VAR

   VAR_TEMP 
      t_IO_PEC : Bool;
   END_VAR

   VAR CONSTANT 
      C_MAX_UDINT : UDInt := 4_294_967_295;
   END_VAR


BEGIN
	REGION Determine the counter value
	    IF #i_Section_Running THEN
	        #s_Cycle_Count := #i_Cycle_Count;
	    ELSE
	        #s_Cycle_Count := 0;
	    END_IF;
	    
	    IF #i_CFG_Item_On THEN
	        #t_IO_PEC := #i_IO_PEC;
	    ELSE
	        #t_IO_PEC := NOT #i_IO_PEC;
	    END_IF;
	END_REGION
	
	REGION Delay On/Off   
	    #s_FB_Digital_Signal(i_Signal               := #t_IO_PEC,
	                         i_CMD_Preset           := #i_CMD_Preset_Latch OR (#i_CFG_Detect_PEC_OnStopped AND NOT #i_Section_Running),
	                         i_CFG_Dealy_On         := #i_CFG_Delay_On,
	                         i_CFG_Dealy_Off        := #i_CFG_Delay_Off,
	                         i_Cycle_Count           := #s_Cycle_Count,
	                         o_Signal_Filtered      => #s_PEC_Filter,
	                         o_Signal_Raising_Edge  => #s_OS_FP_PEC_Latch,
	                         o_Signal_Trailing_Edge => #s_OS_FN_PEC_Latch);
	END_REGION
	
	REGION Blockage Handling
	    IF (NOT #t_IO_PEC OR #i_CFG_Reset_Block_PEC_Oc) AND #s_ER_PEC_Blockage AND #i_CMD_Reset OR "DB_Setting".Common.Disable_PEC_Blockage THEN
	        #s_ER_PEC_Blockage := FALSE;
	        #s_Cnt_Blockage := 0;
	    END_IF;
	    
	    IF NOT #t_IO_PEC THEN
	        #s_Cnt_Blockage := 0;
	    END_IF;
	    
	    IF #t_IO_PEC AND #i_IO_Available AND #i_Section_Running AND NOT "DB_Setting".Common.Disable_PEC_Blockage THEN
	        #s_Cnt_Blockage := #s_Cnt_Blockage + #s_Cycle_Count;
	        IF #s_Cnt_Blockage > #i_CFG_Blockage_Length THEN
	            #s_Cnt_Blockage := #i_CFG_Blockage_Length;
	        END_IF;
	    END_IF;
	    
	    IF #i_CFG_Blockage_Length > 0 AND #s_Cnt_Blockage >= #i_CFG_Blockage_Length AND #t_IO_PEC THEN
	        #s_ER_PEC_Blockage := TRUE;
	    END_IF;
	    
	    #o_Ready_To_Reset := (NOT #t_IO_PEC OR #i_CFG_Reset_Block_PEC_Oc) AND #s_ER_PEC_Blockage;
	END_REGION
	
	REGION Statistics
	    IF #s_OS_FP_PEC_Latch THEN
	        #o_Stat_Items := #o_Stat_Items MOD #C_MAX_UDINT + 1;
	    END_IF;
	    
	    IF #i_CMD_Clear_Stat THEN
	        #o_Stat_Items := 0;
	    END_IF;
	END_REGION
	
	REGION Output
	    #o_ER_PEC_Blockage := #s_ER_PEC_Blockage;
	    #o_PEC_Filter := #s_PEC_Filter AND #i_IO_Available;
	END_REGION
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_EQP_PEC_Position"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_IO_Available : Bool;
      i_CMD_Reset : Bool;
      i_CMD_Clear_Stat : Bool;
      i_CFG_Blockage_Length : DInt;
      i_CFG_Delay_On : DInt;
      i_CFG_Delay_Off : DInt;
      i_CFG_Shifting_Offset : DInt;
      i_CFG_Handover_Offset : DInt;
      i_CFG_Detect_PEC_OnStopped : Bool;
      i_CFG_Reset_Block_PEC_Oc : Bool;
      i_CFG_Item_On : Bool;
      i_CMD_Preset_Latch : Bool;
      i_CMD_Clear_Data : Bool;
      i_Cycle_Count : Int;
      i_IO_PEC : Bool;
      i_Section_Running : Bool;
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Reset : Bool;
      o_ER_PEC_Blockage : Bool;   // ST: PEC blockage
      o_WN_PEC_Buffer_Full : Bool;
      o_PEC_Filter : Bool;
      o_Handover : Bool;
      o_Cnt_Buffer_Used : Int;
      o_Stat_Items : UDInt;
   END_VAR

   VAR 
      s_FB_Digital_Signal { S7_SetPoint := 'False'} : "FB_Digital_Signal";
   END_VAR
   VAR RETAIN
      s_TrackList : Array[1..#C_MAX_COUNT] of Struct
         Position : DInt;
         Length : Int;
         Active : Bool;
         Length_Measured : Bool;
      END_STRUCT;
      s_Default_TrackData : Struct
         Position : DInt;
         Length : Int;
         Active : Bool;
         Length_Measured : Bool;
      END_STRUCT;
      s_Signal_Count : Int;
      s_Copy_Shifting_Offset : DInt;
      s_Copy_Signal_In : Bool;
      s_Copy_ClearData : Bool;
      s_Cycle_Count : Int;
      s_Cnt_Blockage : DInt;
      s_ER_PEC_Blockage : Bool;
      s_WN_PEC_Buffer_Full : Bool;
      s_PEC_Filter : Bool;
      s_PEC_Delayed : Bool;
      s_OS_FP_PEC_Latch : Bool;
      s_OS_FN_PEC_Latch : Bool;
   END_VAR

   VAR_TEMP 
      t_IO_PEC : Bool;
      t_Index : Int;
      t_Trailing_Position : DInt;
      t_Ret_Val : Int;
   END_VAR

   VAR CONSTANT 
      C_MAX_COUNT : Int := 20;
      C_MAX_UDINT : UDInt := 4_294_967_295;
   END_VAR


BEGIN
	REGION Determine the counter value
	    IF #i_Section_Running THEN
	        #s_Cycle_Count := #i_Cycle_Count;
	    ELSE
	        #s_Cycle_Count := 0;
	    END_IF;
	    
	    IF #i_CFG_Item_On THEN
	        #t_IO_PEC := #i_IO_PEC;
	    ELSE
	        #t_IO_PEC := NOT #i_IO_PEC;
	    END_IF;
	END_REGION
	
	REGION Delay On/Off   
	    #s_FB_Digital_Signal(i_Signal               := #t_IO_PEC,
	                         i_CMD_Preset           := #i_CMD_Preset_Latch OR (#i_CFG_Detect_PEC_OnStopped AND NOT #i_Section_Running),
	                         i_CFG_Dealy_On         := #i_CFG_Delay_On,
	                         i_CFG_Dealy_Off        := #i_CFG_Delay_Off,
	                         i_Cycle_Count           := #s_Cycle_Count,
	                         o_Signal_Filtered      => #s_PEC_Filter,
	                         o_Signal_Raising_Edge  => #s_OS_FP_PEC_Latch,
	                         o_Signal_Trailing_Edge => #s_OS_FN_PEC_Latch);
	END_REGION
	
	REGION Blockage Handling
	    IF (NOT #t_IO_PEC OR #i_CFG_Reset_Block_PEC_Oc) AND #s_ER_PEC_Blockage AND #i_CMD_Reset OR "DB_Setting".Common.Disable_PEC_Blockage THEN
	        #s_ER_PEC_Blockage := FALSE;
	        #s_Cnt_Blockage := 0;
	    END_IF;
	    
	    IF NOT #t_IO_PEC THEN
	        #s_Cnt_Blockage := 0;
	    END_IF;
	    
	    IF #t_IO_PEC AND #i_IO_Available AND #i_Section_Running AND NOT "DB_Setting".Common.Disable_PEC_Blockage THEN
	        #s_Cnt_Blockage := #s_Cnt_Blockage + #s_Cycle_Count;
	        IF #s_Cnt_Blockage > #i_CFG_Blockage_Length THEN
	            #s_Cnt_Blockage := #i_CFG_Blockage_Length;
	        END_IF;
	    END_IF;
	    
	    IF #i_CFG_Blockage_Length > 0 AND #s_Cnt_Blockage >= #i_CFG_Blockage_Length AND #t_IO_PEC THEN
	        #s_ER_PEC_Blockage := TRUE;
	    END_IF;
	    
	    #o_Ready_To_Reset := #s_ER_PEC_Blockage AND (NOT #t_IO_PEC OR #i_CFG_Reset_Block_PEC_Oc);
	END_REGION
	
	REGION Delay Signal Output
	    REGION Reset Tracking Data
	        IF
	            (#i_CMD_Clear_Data AND NOT #s_Copy_ClearData)
	            //OR (#i_CFG_Shifting_Offset <> #s_Copy_Shifting_Offset)
	        THEN
	            FOR #t_Index := 1 TO #C_MAX_COUNT DO
	                #s_TrackList[#t_Index] := #s_Default_TrackData;
	            END_FOR;
	            #s_Signal_Count := 0;
	        END_IF;
	        #s_Copy_Shifting_Offset := #i_CFG_Shifting_Offset;
	        #s_Copy_ClearData := #i_CMD_Clear_Data;
	    END_REGION
	    
	    REGION Exit Function
	        IF
	            #i_CFG_Shifting_Offset < 0 OR #i_CFG_Handover_Offset < 0
	            OR (#i_CFG_Shifting_Offset = 0 AND #i_CFG_Handover_Offset = 0)
	        THEN
	            #o_Cnt_Buffer_Used := 0;
	            #s_PEC_Delayed := #s_PEC_Filter;
	            #o_Handover := #s_PEC_Filter;
	            #o_WN_PEC_Buffer_Full := FALSE;
	        ELSE
	            REGION Update Track List
	                IF #s_TrackList[1].Active AND NOT #s_TrackList[1].Length_Measured AND #s_PEC_Filter THEN
	                    #s_TrackList[1].Length := #s_TrackList[1].Length + #s_Cycle_Count;
	                END_IF;
	                
	                FOR #t_Index := 1 TO #s_Signal_Count DO
	                    IF #s_TrackList[#t_Index].Active THEN
	                        #s_TrackList[#t_Index].Position := #s_TrackList[#t_Index].Position + #s_Cycle_Count;
	                    ELSE
	                        EXIT;
	                    END_IF;
	                END_FOR;
	            END_REGION
	            
	            REGION New Signal
	                IF #s_OS_FP_PEC_Latch THEN
	                    IF #s_Signal_Count < #C_MAX_COUNT THEN
	                        #t_Ret_Val := MOVE_BLK_VARIANT(SRC := #s_TrackList, COUNT := INT_TO_UDINT(#C_MAX_COUNT - 1), SRC_INDEX := 0, DEST_INDEX := 1, DEST => #s_TrackList);
	                        #s_TrackList[1] := #s_Default_TrackData;
	                        #s_TrackList[1].Active := TRUE;
	                        #s_Signal_Count := #s_Signal_Count + 1;
	                    END_IF;
	                END_IF;
	                
	                IF #s_OS_FN_PEC_Latch THEN
	                    IF #s_TrackList[1].Active AND NOT #s_TrackList[1].Length_Measured THEN
	                        #s_TrackList[1].Length_Measured := TRUE;
	                    END_IF;
	                END_IF;
	            END_REGION
	            
	            REGION Check Outgoing Signal
	                #s_PEC_Delayed := FALSE;
	                #o_Handover := FALSE;
	                IF #s_Signal_Count > 0 THEN
	                    FOR #t_Index := #s_Signal_Count TO 1 BY -1 DO
	                        IF #s_TrackList[#t_Index].Active THEN
	                            #t_Trailing_Position := #s_TrackList[#t_Index].Position - #s_TrackList[#t_Index].Length;
	                            
	                            IF
	                                #s_TrackList[#t_Index].Position >= #i_CFG_Shifting_Offset AND
	                                #t_Trailing_Position <= #i_CFG_Shifting_Offset
	                            THEN
	                                #s_PEC_Delayed := TRUE;
	                            END_IF;
	                            
	                            IF
	                                #s_TrackList[#t_Index].Position >= #i_CFG_Handover_Offset + #i_CFG_Shifting_Offset AND
	                                #t_Trailing_Position <= #i_CFG_Handover_Offset + #i_CFG_Shifting_Offset
	                            THEN
	                                #o_Handover := TRUE;
	                            END_IF;
	                            
	                            IF #t_Trailing_Position > #i_CFG_Handover_Offset + #i_CFG_Shifting_Offset THEN
	                                #s_TrackList[#t_Index] := #s_Default_TrackData;
	                                #s_Signal_Count := #s_Signal_Count - 1;
	                            END_IF;
	                        END_IF;
	                    END_FOR;
	                END_IF;
	            END_REGION
	        END_IF;
	    END_REGION
	END_REGION
	
	REGION Statistics
	    IF #s_OS_FP_PEC_Latch THEN
	        #o_Stat_Items := #o_Stat_Items MOD #C_MAX_UDINT + 1;
	    END_IF;
	    
	    IF #i_CMD_Clear_Stat THEN
	        #o_Stat_Items := 0;
	    END_IF;
	END_REGION
	
	REGION Output
	    #o_ER_PEC_Blockage := #s_ER_PEC_Blockage;
	    #o_PEC_Filter := #s_PEC_Delayed AND #i_IO_Available;
	    #o_Cnt_Buffer_Used := #s_Signal_Count;
	    #o_WN_PEC_Buffer_Full := #s_Signal_Count >= #C_MAX_COUNT;
	END_REGION
END_FUNCTION_BLOCK

TYPE "UDT_System_Control"
TITLE = UDT_System_Control
VERSION : 0.1
//System control varibale for each section and object
//# Block Info
//- Title:            UDT_System_Control
//- Comment/Function: System control varibale for each section and object
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      Enable : Bool;   // Enable the equipment
      OS_Start : Bool;   // One Shot to start the equipment
      OS_Reset : Bool;   // One Shot to reset the equipment
      Controlled_Stop : Bool;   // Signal to stop equipment controlled
      OS_Reset_Jam : Bool;   // One Shot to reset the jam fault
      OS_Clear_Statistics : Bool;   // One shot to trigger the send and clear statistics routine
      Action_Active : Bool;   // Actions of this section are still active
      Ready_To_Reset : Bool;   // Signal from the equipment to indicate that it's ready to reset
      Ready_To_Start : Bool;   // Signal from the equipment to indicate that it's ready to start
      Spare_1_1 : Bool;   // Spare_1_1
      IO_Available : Bool;   // Signal to indicate that the IO is available
      Safety_OK : Bool;   // Signal to indicate that the safety is OK
      Power_On : Bool;   // Signal to indicate that the power is on
      IO_Available_2 : Bool;   // Signal to indicate that the IO is available for second network
      Spare_1_6 : Bool;   // Spare_1_6
      Spare_1_7 : Bool;   // Spare_1_7
   END_STRUCT;

END_TYPE

FUNCTION_BLOCK "FB_Displacement_AccDec"
TITLE = %version: c7d0bd3.1 % CN: 40
{ S7_Optimized_Access := 'FALSE' }
FAMILY : General
VERSION : 0.0
// Description:                                  
// This block calculates the amount of displacement during the time
// that the motor is running.
   VAR_INPUT 
      i_Conveyor_Speed : Int;   // SETT: [mm/sec] Conveyor Speed
      i_Accelaration : Int;   // SETT: [mm/sec^2] Ramp up
      i_Decelaration : Int;   // SETT: [mm/sec^2] Ramp down
      i_Prev_Cycle_Time : Int;   // [ms]
      i_PPI_Displacement : Int;   // Displacement coming from the external PPI block in [mm]
      i_Section_Run : Bool;   // Section Run signal
   END_VAR

   VAR_OUTPUT 
      o_Motor_On_Speed : Bool;   // Conveyor is on speed
      o_Motor_Stopped : Bool;   // Conveyor motor is stopped
      o_Actual_Speed : Int;   // Actual speed after last PLC cycle in [mm/sec]
      o_Displacement : Int;   // Displacement of the section in [mm]
      o_Act_Run_Out_Distance : Int;   // Actual run-out distance in [mm]
      o_Act_Start_Up_Distance : Int;   // Actual StartUp distance in [mm]
   END_VAR

   VAR 
      s_Motor_Not_Stopped : Bool;   // Conveyor is running
      s_Accelerating : Bool;   // Conveyor is acceleration
      s_Decelerating : Bool;   // Conveyor is deceleration
      s_Target_Speed : Int;   // Set target speed in [mm/sec]
      s_Curr_Conveyor_Speed : Int;   // Current conveyor speed used for calculation
      s_Curr_Run_Out_Distance : Int;   // Current run out distance used for calculation
      s_Curr_Start_Up_Distance : Int;   // Current start up distance used for calculation
      s_Actual_Speed : Int;   // Actual speed after last PLC cycle in [mm/sec]
      s_PrevScan_Actual_Speed : Int;   // Previous PLC cycle time in [mm/sec]
      s_Displacement : Int;   // Displacement in [mm]
      s_Displacement_PPI : Int;   // Displacement PPI in [mm]
      s_Previous_Displ_PPI : Int;   // Previous displacement of the PPI in [mm]
      s_Total_Disp_Till_Next_P : Int;   // Displacement till next PPI
      s_Acceleration : DInt;   // Acceleration speed in [mm/sec^2]
      s_Deceleration : DInt;   // Deceleration speed in [mm/sec^2]
      s_Act_Run_Out_Distance : DInt;   // Actual run-out distance in [mm]
      s_Act_Start_Up_Distance : DInt;   // Actual StartUp distance in [mm]
      s_Remainder_Speed : DInt;   // Remainder of division for calculation of acceleration
      s_Remainder_Displacement : DInt;   // Remainder of division for calculation of displacement
      s_Remainder_Displacement_mm : Int;   // Remainder of division for calculation of displacement
   END_VAR

   VAR_TEMP 
      t_PPI_Displacement : Bool;   // There is displacement of the PPI
      t_New_Speed : Int;   // New speed
      t_Lower_Part_Fraction : DInt;   // Lower part of fraction
      t_Displacement : DInt;   // Displacement in calculation
      t_Calculated_Speed : DInt;   // Speed in calcualation
      t_Remain_Speed : DInt;   // Remaining Speed
      t_Calculated_act_Speed : Int;   // New calculated speed during acceleration/deceleration in [mm/sec]
      t_Displacement_Diff : Int;   // Difference in previous and current PPI Displacement
   END_VAR


BEGIN
	REGION NETWORK AA: Determine Target Speed
	    IF #i_Section_Run THEN
	        #s_Target_Speed := #i_Conveyor_Speed;
	    ELSE
	        #s_Target_Speed := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK BA: Determine if accelerating or decelerating
	    #s_Accelerating := #s_Actual_Speed < #s_Target_Speed;
	    #s_Decelerating := #s_Actual_Speed > #s_Target_Speed;
	END_REGION
	
	REGION NETWORK CA: Save Actual speed from previous PLC cycle
	    #s_PrevScan_Actual_Speed := #s_Actual_Speed;
	END_REGION
	
	REGION NETWORK DA: Hold setpoint
	    #s_Curr_Conveyor_Speed := #i_Conveyor_Speed;
	    #s_Deceleration := #i_Decelaration;
	    #s_Acceleration := #i_Accelaration;
	END_REGION
	
	REGION NETWORK EA: Calculate Run Out Distance in mm
	    IF #s_Accelerating OR #s_Decelerating THEN
	        #s_Curr_Run_Out_Distance := DINT_TO_INT((INT_TO_DINT(#s_Curr_Conveyor_Speed) * INT_TO_DINT(#s_Curr_Conveyor_Speed)) / (2 * #s_Deceleration));
	    END_IF;
	END_REGION
	
	REGION NETWORK FA: Calculate Start Up Distance in mm
	    IF #s_Accelerating OR #s_Decelerating THEN
	        #s_Curr_Start_Up_Distance := DINT_TO_INT((INT_TO_DINT(#s_Curr_Conveyor_Speed) * INT_TO_DINT(#s_Curr_Conveyor_Speed)) / (2 * #s_Acceleration));
	    END_IF;
	END_REGION
	
	REGION NETWORK GA: Reset speed remainder when not accelerating/decelerating
	    IF NOT #s_Accelerating AND NOT #s_Decelerating THEN
	        #s_Remainder_Speed := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK HA: Recalculate Actual speed during accelerating
	    IF #s_Accelerating THEN
	        #t_Calculated_Speed := #s_Acceleration * INT_TO_DINT(#i_Prev_Cycle_Time) + #s_Remainder_Speed;
	        #s_Remainder_Speed := #t_Calculated_Speed MOD 1000;
	        #t_Calculated_act_Speed := DINT_TO_INT(#t_Calculated_Speed / 1000) + #s_PrevScan_Actual_Speed;
	        
	        IF #t_Calculated_act_Speed <= #s_Target_Speed THEN
	            #s_Actual_Speed := #t_Calculated_act_Speed;
	        ELSE
	            #s_Actual_Speed := #s_Target_Speed;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION NETWORK IA: Recalculate Actual speed during decelerating
	    IF #s_Decelerating THEN
	        #t_Calculated_Speed := #s_Deceleration * INT_TO_DINT(#i_Prev_Cycle_Time) + #s_Remainder_Speed;
	        #s_Remainder_Speed := #t_Calculated_Speed MOD 1000;
	        #t_New_Speed := DINT_TO_INT(#t_Calculated_Speed / 1000);
	        #t_Calculated_act_Speed := #s_PrevScan_Actual_Speed - #t_New_Speed;
	        
	        IF #t_Calculated_act_Speed >= #s_Target_Speed THEN
	            #s_Actual_Speed := #t_Calculated_act_Speed;
	        ELSE
	            #s_Actual_Speed := #s_Target_Speed;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION NETWORK JA: Safeguard when decelaration is zero or lower
	    IF #i_Decelaration <= 0 THEN
	        #s_Actual_Speed := #s_Target_Speed;
	    END_IF;
	END_REGION
	
	REGION NETWORK KA: Set speed status outputs
	    #s_Motor_Not_Stopped := #s_Actual_Speed <> 0;
	    #o_Motor_On_Speed := (#s_Actual_Speed = #i_Conveyor_Speed) AND #i_Section_Run AND #s_Motor_Not_Stopped;
	END_REGION
	
	REGION NETWORK NA: Calculate displacement during last scan
	    #t_Displacement := INT_TO_DINT(#s_Actual_Speed) * INT_TO_DINT(#i_Prev_Cycle_Time) + #s_Remainder_Displacement;
	    #s_Displacement := DINT_TO_INT(#t_Displacement / 1000);
	    #s_Remainder_Displacement := #t_Displacement MOD 1000;
	END_REGION
	
	REGION NETWORK OA: Check if there is any PPI displacement
	    #s_Displacement_PPI := #i_PPI_Displacement;
	    
	    #t_PPI_Displacement := (#s_Displacement_PPI > 0) OR (#s_Previous_Displ_PPI > 0);
	END_REGION
	
	REGION NETWORK PA: Compare with PPI Displacement
	    IF #t_PPI_Displacement AND #s_Motor_Not_Stopped THEN
	        IF #s_Displacement_PPI > 0 THEN
	            // New PPI pulse arrived
	            #t_Displacement_Diff := #s_Displacement_PPI - #s_Total_Disp_Till_Next_P;
	            #s_Previous_Displ_PPI := #s_Displacement_PPI;
	            #s_Total_Disp_Till_Next_P := #s_Displacement;
	            
	            IF (#s_Displacement + #t_Displacement_Diff) > 0 THEN
	                #s_Displacement := #s_Displacement + #t_Displacement_Diff;
	            ELSE
	                #s_Displacement := 0;
	            END_IF;
	        ELSIF #s_Total_Disp_Till_Next_P < #s_Previous_Displ_PPI THEN
	            // No new pulse, continue accumulating
	            #s_Total_Disp_Till_Next_P := #s_Displacement + #s_Total_Disp_Till_Next_P;
	        ELSE
	            // Exceeded PPI displacement without new pulse - reset
	            #s_Displacement := 0;
	        END_IF;
	    END_IF;
	END_REGION
	
	REGION NETWORK MA: Calculate start-up distance
	    IF #i_Conveyor_Speed > 0 THEN
	        #t_Remain_Speed := #i_Conveyor_Speed - #s_Actual_Speed;
	        
	        IF #t_Remain_Speed > 0 THEN
	            #s_Act_Start_Up_Distance := ((#t_Remain_Speed * #t_Remain_Speed) / (#s_Acceleration * 2)) + #s_Actual_Speed * #t_Remain_Speed / #s_Acceleration;
	        ELSE
	            #s_Act_Start_Up_Distance := 0;
	        END_IF;
	    ELSE
	        #s_Act_Start_Up_Distance := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK QA: Calculate run-out distance  
	    IF #o_Motor_On_Speed THEN
	        #s_Act_Run_Out_Distance := #s_Curr_Run_Out_Distance;
	    ELSIF #s_Decelerating THEN
	        IF #s_Act_Run_Out_Distance - #s_Displacement >= 0 THEN
	            #s_Act_Run_Out_Distance := #s_Act_Run_Out_Distance - #s_Displacement;
	        ELSE
	            #s_Act_Run_Out_Distance := 0;
	        END_IF;
	    ELSIF #s_Accelerating THEN
	        IF #s_Act_Run_Out_Distance + #s_Displacement <= #s_Curr_Run_Out_Distance THEN
	            #s_Act_Run_Out_Distance := #s_Act_Run_Out_Distance + #s_Displacement;
	        ELSE
	            #s_Act_Run_Out_Distance := #s_Curr_Run_Out_Distance;
	        END_IF;
	    ELSIF NOT #s_Motor_Not_Stopped THEN
	        #s_Act_Run_Out_Distance := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK RA: Write outputs
	    #o_Act_Run_Out_Distance := DINT_TO_INT(#s_Act_Run_Out_Distance);
	    #o_Act_Start_Up_Distance := DINT_TO_INT(#s_Act_Start_Up_Distance);
	    // #o_Displacement := (#s_Displacement + #s_Remainder_Displacement_mm);
	    // #s_Remainder_Displacement_mm := (#s_Displacement + #s_Remainder_Displacement_mm) MOD 10;
	    #o_Displacement := #s_Displacement;
	    #o_Actual_Speed := #s_Actual_Speed;
	    #o_Motor_Stopped := NOT #s_Motor_Not_Stopped;
	END_REGION
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_EQP_Transport"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT RETAIN
      i_Enable : Bool;
      i_IO_Available : Bool;
      i_Safety_OK : Bool;
      i_CMD_Reset : Bool;
      i_CMD_Start : Bool;
      i_CMD_Controlled_Stop : Bool;
      i_End_PEC_Latch : Bool;
      i_Manual_Run : Bool;
      i_CFG_Slave_Conveyor : Bool;
      i_CFG_Enable_DieForward : Bool;
      i_Delay_Waiting_Item : DInt;
      i_Delay_Dieback : DInt;
      i_Delay_Startup : DInt;
      i_Delay_Finish_Handover : DInt;
      i_Delay_Energysave : DInt;
      i_Delay_Cascade_Startup : DInt;
      i_Delay_Cascade_Shutdown : DInt;
      i_Delay_Motor_Startup : DInt;
      i_Minimum_Gap : DInt;
      i_Minimum_Head_To_Head : DInt;
      i_Ext_Req_Stop : Bool;
      i_Ext_Req_Halt : Bool;
      i_Ext_Req_Dis_Send : Bool;
      i_Ext_Req_Dis_Recv : Bool;
      i_Ext_Req_Rst_ESave : Bool;
      i_Ext_Req_Clear_Data : Bool;
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Start : Bool;
      o_ER_Receive_Timeout : Bool;
      o_ST_Safety_Stop : Bool;
      o_ST_Items : Bool;
      o_ST_Started : Bool;
      o_ST_Energy_Saving : Bool;
      o_ST_Die_Back : Bool;
      o_ST_Motor_Running : Bool;
      o_MTR_Run : Bool;
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_FIF_Upstream : "UDT_Flow_Interface";
      io_FIF : "UDT_Flow_Interface";
      io_FIF_Downstream : "UDT_Flow_Interface";
   END_VAR

   VAR RETAIN
      s_Copy : Struct
         Clear_Data : Bool;
         Operational_On : Bool;
         Upstream_TIP : Bool;
         Upstream_Handover : Bool;
         RTS : Bool;
         TIP : Bool;
         Item_In_Handover : Bool;
         Copy_Item_In_Handover : Bool;
         Handover : Bool;
         Motor_Run : Bool;
      END_STRUCT;
   END_VAR
   VAR 
      s_Cnt_Pre_Magnetization { S7_SetPoint := 'True'} : DInt;
   END_VAR
   VAR RETAIN
      s_Done : Bool;
      s_Operational_On : Bool;
      s_Section_Available : Bool;
      s_OL_Manual_Mode : Bool;
      s_ER_Receive_Timeout : Bool;
      s_Cnt_Delay_Dieback : DInt;
      s_Cnt_Delay_Finish_HO : DInt;
      s_Cnt_EnergySave : DInt;
      s_Cnt_Delay_Waiting_item : DInt;
      s_Cnt_Remining_Mini_H2h : DInt;
      s_Cnt_Remining_Mini_Gap : DInt;
      s_Cnt_Cascade_Startup : DInt;
      s_Cnt_Cascade_Shutdown : DInt;
      s_Cnt_Start_Up : DInt;
      s_Waiting_Fininsh : Bool;
      s_Dieback_Delay_Finish : Bool;
      s_Handover_Delay_Finish : Bool;
      s_Disable_Send : Bool;
      s_Mini_Gap_OK : Bool;
      s_Mini_H2h_OK : Bool;
      s_EnergySaving : Bool;
      s_Handover_Run_OK : Bool;
      s_Flow_Control_OK : Bool;
      s_Halt_Control : Bool;
      s_Cascade_Start_Ok : Bool;
      s_Cascade_Stop_Done : Bool;
      s_StartUp_Ok : Bool;
      s_ST_Items : Bool;
      s_Magnetization_Required : Bool;
   END_VAR

   VAR_TEMP 
      t_Clear_Data : Bool;
      t_Upstream_Req_Halt : Bool;
      t_Upstream_Req_Reset_E_Save : Bool;
      t_Downstream_Req_Halt : Bool;
      t_CMD_Motor_Run : Bool;
      t_Pre_Magnetization_Done : Bool;
   END_VAR


BEGIN
	REGION Initialize Data
	    IF #io_Global.OS_First_Scan OR NOT #s_Done THEN
	        #s_Done := TRUE;
	    END_IF;
	    #t_Clear_Data := #i_Ext_Req_Clear_Data AND NOT #s_Copy.Clear_Data;
	    IF #t_Clear_Data THEN
	        #io_FIF.Item_at_Handover := FALSE;
	        #io_FIF.RTS := FALSE;
	        #io_FIF.TIP := FALSE;
	        #io_FIF.Data := 0;
	        #io_FIF.Receive_Item := FALSE;
	    END_IF;
	    IF #i_CMD_Reset THEN
	        #s_ER_Receive_Timeout := FALSE;
	    END_IF;
	    
	    #io_FIF.PECPosition_Latch := #i_End_PEC_Latch;
	END_REGION
	
	REGION Operational On
	    IF #i_CMD_Start THEN
	        #s_Operational_On := TRUE;
	    END_IF;
	    IF NOT #i_IO_Available OR NOT #i_Safety_OK OR NOT #i_Enable OR #i_Ext_Req_Stop OR #s_ER_Receive_Timeout THEN
	        #s_Operational_On := FALSE;
	    END_IF;
	    #o_Ready_To_Start := NOT #s_Operational_On AND #i_IO_Available AND #i_Safety_OK AND #i_Enable AND NOT #i_Ext_Req_Stop AND NOT #s_ER_Receive_Timeout;
	END_REGION
	
	REGION Takeover from upstream   
	    // Waiting item to be transport to the end PEC.
	    IF #i_Delay_Waiting_Item > 0 THEN
	        IF #io_FIF_Upstream.TIP AND NOT #s_Copy.Upstream_TIP AND #io_FIF_Upstream.Motor_Run THEN
	            #io_FIF.Receive_Item := TRUE;
	        END_IF;
	        
	        "FC_Delay_On_Accumulator_Variant"(i_CMD_Start    := #io_FIF.Receive_Item,
	                                          i_Enable_Dly   := NOT #io_FIF.Motor_Stopped,
	                                          i_CFG_Target   := #i_Delay_Waiting_Item,
	                                          i_Cycle_Count  := #io_FIF.Displacement,
	                                          o_Delay_Finish => #s_Waiting_Fininsh,
	                                          io_Setpoint    := #s_Cnt_Delay_Waiting_item);
	        
	        IF #s_Waiting_Fininsh OR #io_FIF.PECPosition_Latch THEN
	            #io_FIF.Receive_Item := FALSE;
	        END_IF;
	        
	        // Monitor receive timeout
	        IF #s_Waiting_Fininsh AND #i_IO_Available THEN
	            #s_ER_Receive_Timeout := TRUE;
	        END_IF;
	    END_IF;
	    
	    IF #io_FIF_Upstream.Data_Sync THEN
	        #io_FIF.Data := #io_FIF_Upstream.Data;
	        #io_FIF_Upstream.Data := 0;
	    END_IF;
	    
	    // Send halt signal and drop RTR if current section occur any error once takeover item from upstream.
	    #io_FIF.RTR := (NOT #io_FIF_Upstream.Req_Down_Disable_Receive AND NOT #i_Ext_Req_Dis_Recv AND #s_Flow_Control_OK OR #io_FIF_Upstream.TIP)
	    AND #s_Operational_On AND #s_Section_Available AND (NOT #io_FIF.Item_at_Handover OR #io_FIF.Motor_Run);
	END_REGION
	
	REGION Handover to downstream
	    #io_FIF.Data_Sync := FALSE;
	    
	    "FC_Delay_On_Accumulator_Variant"(i_CMD_Start    := #io_FIF.PECPosition_Latch,
	                                      i_Enable_Dly   := NOT #io_FIF.Motor_Stopped,
	                                      i_CFG_Target   := #i_Delay_Dieback,
	                                      i_Cycle_Count  := #io_FIF.Displacement,
	                                      o_Delay_Finish => #s_Dieback_Delay_Finish,
	                                      io_Setpoint    := #s_Cnt_Delay_Dieback);
	    
	    IF #s_Dieback_Delay_Finish THEN
	        #io_FIF.Item_at_Handover := TRUE;
	    END_IF;
	    
	    IF #i_Delay_Finish_Handover > 0 THEN
	        "FC_Delay_On_Accumulator_Variant"(i_CMD_Start    := #io_FIF.Item_at_Handover AND NOT #io_FIF.PECPosition_Latch,
	                                          i_Enable_Dly   := NOT #io_FIF.Motor_Stopped,
	                                          i_CFG_Target   := #i_Delay_Finish_Handover,
	                                          i_Cycle_Count  := #io_FIF.Displacement,
	                                          o_Delay_Finish => #s_Handover_Delay_Finish,
	                                          io_Setpoint    := #s_Cnt_Delay_Finish_HO);
	        
	        IF #s_Handover_Delay_Finish THEN
	            #io_FIF.Item_at_Handover := FALSE;
	            #io_FIF.Data_Sync := TRUE;
	        END_IF;
	    ELSE
	        IF #io_FIF.Handover AND NOT #s_Copy.Handover THEN
	            #io_FIF.Data_Sync := TRUE;
	        END_IF;
	        
	        IF NOT #io_FIF.Handover AND #s_Copy.Handover THEN
	            #io_FIF.Item_at_Handover := FALSE;
	        END_IF;
	    END_IF;
	    
	    // Disable send item once it at then end of the section and have relevant command.
	    #s_Disable_Send := ((#s_Copy.Item_In_Handover AND NOT #s_Copy.Copy_Item_In_Handover) OR (#s_Disable_Send AND NOT #t_Clear_Data))
	    AND (#io_FIF_Downstream.Req_Up_Disable_Send OR #i_Ext_Req_Dis_Send)
	    AND NOT #i_CFG_Slave_Conveyor;
	    
	    IF NOT #i_CFG_Slave_Conveyor THEN
	        // Section can have ready to send signal once:
	        // 1. At the end;
	        // 2. Section is started
	        // 3. No disable send signal
	        #io_FIF.RTS := (#io_FIF.Item_at_Handover AND NOT (#io_FIF.Item_at_Handover AND NOT #s_Copy.Item_In_Handover)) AND #s_Operational_On AND NOT #s_Disable_Send;
	        
	        // The transfer in progress is built during downstream send back RTR signal.
	        IF #io_FIF.RTS AND #io_FIF_Downstream.RTR THEN
	            #io_FIF.TIP := TRUE;
	        END_IF;
	        // And would be reset after item send to downstream completely.
	        IF NOT #io_FIF.Item_at_Handover THEN
	            #io_FIF.TIP := FALSE;
	        END_IF;
	        
	        // Section can handover item when no disable send signal and no downstream drop off neither running nor RTR status during current is ready to send.
	        #s_Handover_Run_OK := NOT #s_Disable_Send AND NOT (#io_FIF.RTS AND #s_Copy.RTS AND (NOT #io_FIF_Downstream.Motor_Run OR NOT #io_FIF_Downstream.RTR));
	    ELSE
	        // Always set RTS state while section is opertional and not energySaving
	        #io_FIF.RTS := NOT #s_EnergySaving AND #s_Operational_On;
	        
	        // Always set TIP state while section is opertional and not energySaving
	        #io_FIF.TIP := NOT #s_EnergySaving AND #s_Operational_On;
	        
	        // Always follow downstream section
	        #s_Handover_Run_OK := #io_FIF_Downstream.Motor_Run;
	    END_IF;
	END_REGION
	
	REGION Basic Flow Control    
	    IF #i_Minimum_Gap > 0 THEN
	        IF NOT #io_FIF_Upstream.Handover AND #s_Copy.Upstream_Handover AND #io_FIF_Upstream.Motor_Run THEN
	            #s_Cnt_Remining_Mini_Gap := #i_Minimum_Gap;
	        END_IF;
	        
	        IF NOT #io_FIF.Motor_Stopped THEN
	            #s_Cnt_Remining_Mini_Gap := LIMIT_INT(MN := 0, IN := #s_Cnt_Remining_Mini_Gap - #io_FIF.Displacement, MX := #i_Minimum_Gap);
	        END_IF;
	    ELSE
	        #s_Cnt_Remining_Mini_Gap := 0;
	    END_IF;
	    
	    IF #i_Minimum_Head_To_Head > 0 THEN
	        IF #io_FIF_Upstream.Handover AND NOT #s_Copy.Upstream_Handover AND #io_FIF_Upstream.Motor_Run THEN
	            #s_Cnt_Remining_Mini_H2h := #i_Minimum_Head_To_Head;
	        END_IF;
	        
	        IF NOT #io_FIF.Motor_Stopped THEN
	            #s_Cnt_Remining_Mini_H2h := LIMIT_INT(MN := 0, IN := #s_Cnt_Remining_Mini_H2h - #io_FIF.Displacement, MX := #i_Minimum_Head_To_Head);
	        END_IF;
	    ELSE
	        #s_Cnt_Remining_Mini_H2h := 0;
	    END_IF;
	    
	    #s_Mini_Gap_OK := #s_Cnt_Remining_Mini_Gap <= 0;
	    #s_Mini_H2h_OK := #s_Cnt_Remining_Mini_H2h <= 0;
	    #s_Flow_Control_OK := (#s_Mini_Gap_OK AND #s_Mini_H2h_OK);
	END_REGION
	
	REGION Halt Control
	    // Upstream need to halt during handover item
	    #t_Upstream_Req_Halt := #io_FIF_Upstream.TIP AND (#io_FIF_Upstream.Req_Downstream_Halt OR NOT #io_FIF_Upstream.RTS) AND #i_CFG_Enable_DieForward;
	    // Downstream need to halt during takeover item
	    #t_Downstream_Req_Halt := #io_FIF.TIP AND #io_FIF_Downstream.Req_Upstream_Halt;
	    #s_Halt_Control := #i_Ext_Req_Halt OR #t_Upstream_Req_Halt OR #t_Downstream_Req_Halt;
	    
	    // Do not let a section do takeover and handover at the same time if possible.
	    #io_FIF.Req_Upstream_Halt := #io_FIF_Upstream.TIP AND (#i_Ext_Req_Halt OR #t_Downstream_Req_Halt);
	    #io_FIF.Req_Downstream_Halt := #io_FIF.TIP AND (#i_Ext_Req_Halt OR #t_Upstream_Req_Halt);
	END_REGION
	
	REGION Energy Save
	    // Reset energy save Command from upstream
	    #t_Upstream_Req_Reset_E_Save := #io_FIF_Upstream.RTS OR #io_FIF_Upstream.TIP OR #io_FIF_Upstream.Req_Down_Reset_E_Saving;
	    
	    IF
	        #t_Upstream_Req_Reset_E_Save // Upstream signal
	        //OR #io_FIF.RTS OR #io_FIF.TIP // or current section is being handover item
	        OR #s_ST_Items // or current has an item
	    THEN
	        #s_Cnt_EnergySave := #i_Delay_Energysave;
	    END_IF;
	    
	    IF
	        #i_Ext_Req_Rst_ESave // External request
	        OR (#s_Operational_On AND NOT #s_Copy.Operational_On) // or positive edge of operational on
	    THEN
	        #s_Cnt_EnergySave := #i_Delay_Energysave;
	    END_IF;
	    
	    IF #io_FIF.Motor_Run THEN
	        #s_Cnt_EnergySave := LIMIT_INT(MN := 0, IN := #s_Cnt_EnergySave - #io_FIF.Displacement, MX := #i_Delay_Energysave);
	    END_IF;
	    #s_EnergySaving := #s_Cnt_EnergySave <= 0 AND #i_Delay_Energysave > 0;
	    
	    IF NOT #i_CFG_Slave_Conveyor THEN
	        // Conveyor Request E-Saving
	        #io_FIF.Req_Down_Reset_E_Saving := #io_FIF.PECPosition_Latch AND #s_Operational_On AND #s_Section_Available AND NOT #s_Disable_Send;
	    ELSE
	        // Slave Conveyor Request E-Saving
	        #io_FIF.Req_Down_Reset_E_Saving := NOT #s_EnergySaving AND #s_Operational_On;
	    END_IF;
	END_REGION
	
	REGION Cascade Start Up
	    IF #i_Delay_Cascade_Startup > 0 THEN
	        IF NOT #i_Enable OR (NOT #s_Operational_On AND #s_Copy.Operational_On) OR #s_Cascade_Stop_Done THEN
	            #s_Cnt_Cascade_Startup := #i_Delay_Cascade_Startup;
	        END_IF;
	        
	        IF #i_Enable AND #s_Operational_On AND #io_FIF_Downstream.Cascade_Startup THEN
	            #s_Cnt_Cascade_Startup := LIMIT_INT(MN := 0, IN := #s_Cnt_Cascade_Startup - #io_FIF_Downstream.Displacement, MX := #i_Delay_Cascade_Startup);
	        END_IF;
	        #s_Cascade_Start_Ok := #s_Cnt_Cascade_Startup <= 0;
	    ELSE
	        #s_Cascade_Start_Ok := TRUE;
	    END_IF;
	    #io_FIF.Cascade_Startup := #s_Cascade_Start_Ok;
	END_REGION
	
	REGION Cascade Shut Down
	    IF #i_Delay_Cascade_Shutdown > 0 THEN
	        IF #i_Enable AND NOT #i_CMD_Controlled_Stop THEN
	            #s_Cnt_Cascade_Shutdown := #i_Delay_Cascade_Shutdown;
	        END_IF;
	        
	        IF #i_Enable AND #io_FIF_Upstream.Cascade_Shutdown AND #i_CMD_Controlled_Stop THEN
	            #s_Cnt_Cascade_Shutdown := LIMIT_INT(MN := 0, IN := #s_Cnt_Cascade_Shutdown - #io_Global.OB_Prev_Cycle_Time, MX := #i_Delay_Cascade_Shutdown);
	        END_IF;
	        #s_Cascade_Stop_Done := #s_Cnt_Cascade_Shutdown <= 0;
	        #io_FIF.Cascade_Shutdown := #s_Cascade_Stop_Done;
	    ELSIF #i_Delay_Cascade_Shutdown = 0 THEN
	        #s_Cascade_Stop_Done := #i_CMD_Controlled_Stop;
	        #io_FIF.Cascade_Shutdown := #s_Cascade_Stop_Done;
	    ELSE
	        #s_Cascade_Stop_Done := FALSE;
	    END_IF;
	END_REGION
	
	REGION Start Up After Dieback
	    IF #i_Delay_Startup > 0 AND NOT #i_CFG_Slave_Conveyor THEN
	        IF #io_FIF.RTS AND (NOT #io_FIF_Downstream.RTR OR NOT #io_FIF_Downstream.Motor_Run) AND NOT #io_FIF.TIP THEN
	            #s_Cnt_Start_Up := #i_Delay_Startup;
	        END_IF;
	        
	        IF #io_FIF_Downstream.Motor_Run THEN
	            #s_Cnt_Start_Up := LIMIT_INT(MN := 0, IN := #s_Cnt_Start_Up - #io_FIF_Downstream.Displacement, MX := #i_Delay_Startup);
	        END_IF;
	    ELSE
	        #s_Cnt_Start_Up := 0;
	    END_IF;
	    
	    #s_StartUp_Ok := #s_Cnt_Start_Up <= 0;
	END_REGION
	
	REGION Motor Control
	    #t_CMD_Motor_Run := #s_Operational_On // Section is started without any error
	    AND NOT #s_EnergySaving // and no need to save energy
	    AND #s_Handover_Run_OK  // and handover over siganl is ok
	    AND NOT #s_Halt_Control // and no any halt control
	    AND #s_Cascade_Start_Ok // and downstream cascade statup
	    AND NOT #s_Cascade_Stop_Done // and no upstream cascade stop
	    AND #s_StartUp_Ok;
	    
	    // Pre-magnetization time
	    IF #io_FIF.Motor_Stopped THEN
	        #s_Magnetization_Required := TRUE;
	    END_IF;
	    
	    "FC_Delay_On_Variant"(i_CMD_Start    := #t_CMD_Motor_Run,
	                          i_CFG_Target   := #i_Delay_Motor_Startup,
	                          i_Cycle_Count  := #io_Global.OB_Prev_Cycle_Time,
	                          o_Delay_Finish => #t_Pre_Magnetization_Done,
	                          io_Setpoint    := #s_Cnt_Pre_Magnetization);
	    
	    #io_FIF.Motor_Run := #t_CMD_Motor_Run AND ((#t_Pre_Magnetization_Done AND #s_Magnetization_Required) OR NOT #s_Magnetization_Required OR #i_Delay_Motor_Startup <= 0);
	    IF #io_FIF.Motor_Run THEN
	        #s_Magnetization_Required := FALSE;
	    END_IF;
	    #o_MTR_Run := (#t_CMD_Motor_Run OR #i_Manual_Run) AND #i_Safety_OK;
	END_REGION
	
	REGION Output
	    #s_Section_Available := #io_FIF.Available := #s_Cascade_Start_Ok AND #s_StartUp_Ok AND NOT #s_Halt_Control;
	    #o_ER_Receive_Timeout := #s_ER_Receive_Timeout;
	    #o_ST_Safety_Stop := NOT #i_Safety_OK;
	    #o_ST_Started := #io_FIF.Operational := #s_Operational_On;
	    #o_ST_Motor_Running := #io_FIF.Motor_Run;
	    #o_ST_Items := #io_FIF.Items := #s_ST_Items := #io_FIF.Item_at_Handover OR #io_FIF.Receive_Item OR #i_End_PEC_Latch;
	    #o_ST_Die_Back := #o_ST_Started AND #io_FIF.Item_at_Handover AND NOT #o_ST_Motor_Running;
	    #o_ST_Energy_Saving := #s_Operational_On AND #s_EnergySaving;
	END_REGION
	
	REGION Storage State
	    #s_Copy.Clear_Data := #i_Ext_Req_Clear_Data;
	    #s_Copy.Operational_On := #s_Operational_On;
	    #s_Copy.Upstream_TIP := #io_FIF_Upstream.TIP;
	    #s_Copy.Upstream_Handover := #io_FIF_Upstream.Handover;
	    #s_Copy.RTS := #io_FIF.RTS;
	    #s_Copy.TIP := #io_FIF.TIP;
	    #s_Copy.Copy_Item_In_Handover := #s_Copy.Item_In_Handover;
	    #s_Copy.Item_In_Handover := #io_FIF.Item_at_Handover;
	    #s_Copy.Handover := #io_FIF.Handover;
	    #s_Copy.Motor_Run := #io_FIF.Motor_Run;
	END_REGION
	
END_FUNCTION_BLOCK

FUNCTION_BLOCK "FB_HW_VFD_S210"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Telegram_HW_ID { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : HW_SUBMODULE;
      i_Additional_HW_ID { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : HW_SUBMODULE;
      i_Enable : Bool;
      i_IO_Available : Bool;
      i_Safety_OK : Bool;
      i_CMD_Reset : Bool;
      i_CMD_Clear_Stat : Bool;
      i_HW_Setting : "UDT_S210_Speed_Setting";
      i_CFG_Motor_Switch_Time : Int := 100;
      i_CMD_Select_Speed : Int := 1;
      i_CMD_Motor_Run : Bool;
      i_CMD_Motor_Reverse : Bool;
   END_VAR

   VAR_OUTPUT RETAIN
      o_Ready_To_Reset : Bool;
      o_Req_Halt : Bool;
      o_ER_PN_Not_Present : Bool;
      o_ER_PN_Error : Bool;
      o_ER_Motor_Fault : Bool;
      o_WN_Motor_Alarm : Bool;
      o_ER_STO_Active : Bool;
      o_ST_Motor_Running : Bool;
      o_FaultCode : Word;
      o_AlarmCode : Word;
      o_Speed_Selected : Int;
      o_Diagnostics : "UDT_S210_HW_Diagnostics";
   END_VAR

   VAR_IN_OUT 
      io_Global : "UDT_Global";
      io_S210_Interface : "UDT_S210_HW_Interface";
   END_VAR

   VAR 
      s_FB_SINA_POS_TEL112 : "FB_SINA_POS_TEL112";
   END_VAR
   VAR RETAIN
      s_SW_In : "UDT_S210_SW_Input";
      s_SW_Out : "UDT_S210_SW_Output";
      s_Copy : Struct
         Clear_Stat : Bool;
         MTR_Run : Bool;
         MTR_Reverse : Bool;
         ActPosition : Real;
      END_STRUCT;
      s_Cnt_Motor_Switch_Action : Int;
      s_Cnt_Reset_Delay : Int;
      s_Cnt_Enable_Delay : Int;
      s_Motor_Run : Bool;
      s_Switch_In_Progress : Bool;
      s_Stopped_Elapsed : Bool;
      s_CMD_Reset : Bool;
      s_CMD_Enable : Bool;
   END_VAR

   VAR_TEMP 
      t_GeoAddr {InstructionName := 'GEOADDR'; LibVersion := '1.0'} : GEOADDR;
      t_Ret_Val_Int : Int;
      t_Start_Address : Int;
      t_IO_Available : Bool;
   END_VAR

   VAR CONSTANT 
      C_RESET_DELAY_TIME : Int := 200;
   END_VAR


BEGIN
	REGION NETOWRK: Initial
	    #o_Ready_To_Reset := FALSE;
	END_REGION
	
	REGION NETWORK: Diagnose PN Status
	    #t_Ret_Val_Int := LOG2GEO(LADDR := #i_Telegram_HW_ID, GEOADDR := #t_GeoAddr);
	    IF #i_CMD_Reset OR NOT #i_IO_Available THEN
	        #o_ER_PN_Not_Present := FALSE;
	        #o_ER_PN_Error := FALSE;
	    END_IF;
	    IF #i_IO_Available AND (#t_Ret_Val_Int <> 0 OR "DB_Diagnostics".PNIO_System_100.Device_Not_Present[#t_GeoAddr.STATION]) THEN
	        #o_ER_PN_Not_Present := TRUE;
	    END_IF;
	    IF #i_IO_Available AND "DB_Diagnostics".PNIO_System_100.Device_Error[#t_GeoAddr.STATION] THEN
	        #o_ER_PN_Error := TRUE;
	    END_IF;
	    IF
	        #o_ER_PN_Not_Present AND NOT (#t_Ret_Val_Int <> 0 OR "DB_Diagnostics".PNIO_System_100.Device_Not_Present[#t_GeoAddr.STATION])
	        //OR (#o_ER_PN_Error AND NOT ""DB_Diagnostics"".PNIO_System_100.Device_Error[#t_GeoAddr.STATION])
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    #t_IO_Available := #i_IO_Available AND NOT #o_ER_PN_Not_Present;
	END_REGION
	
	REGION NETWORK: Read IO
	    "FC_IFM_VFD_S210_In"(i_Telegram_HW_ID            := #i_Telegram_HW_ID,
	                         i_Additional_HW_ID          := #i_Additional_HW_ID,
	                         o_Telegram_Start_Address    => #t_Start_Address,
	                         o_ActualValue_Start_Address => #t_Start_Address,
	                         o_Data                      => #io_S210_Interface.Input);
	END_REGION
	
	REGION NETWORK: Motor switch delay
	    IF #i_CMD_Motor_Reverse XOR #s_Copy.MTR_Reverse THEN
	        #s_Switch_In_Progress := TRUE;
	        #o_Diagnostics.Motor_Direction_Switch_Count += 1;
	    END_IF;
	    
	    "FC_Delay_On"(i_CMD_Start    := #s_Motor_Run,
	                  i_CFG_Target   := #i_CFG_Motor_Switch_Time,
	                  i_Cycle_Count  := #io_Global.OB_Prev_Cycle_Time,
	                  o_Delay_Finish => #s_Stopped_Elapsed,
	                  io_Setpoint    := #s_Cnt_Motor_Switch_Action);
	    
	    IF NOT #s_Stopped_Elapsed THEN
	        #s_Switch_In_Progress := FALSE;
	    END_IF;
	    #o_Req_Halt := #s_Switch_In_Progress;
	END_REGION
	
	REGION NETWORK: Reset Pulse    
	    "FC_Delay_Off"(i_CMD_Start    := #i_CMD_Reset AND #t_IO_Available,
	                   i_CFG_Target   := #C_RESET_DELAY_TIME,
	                   i_Cycle_Count  := #io_Global.OB_Prev_Cycle_Time,
	                   o_Delay_Finish => #s_CMD_Reset,
	                   io_Setpoint    := #s_Cnt_Reset_Delay);
	END_REGION
	
	REGION NETWORK: Delay off Enable
	    "FC_Delay_Off"(i_CMD_Start    := #i_Enable,
	                   i_CFG_Target   := 1000,
	                   i_Cycle_Count  := #io_Global.OB_Prev_Cycle_Time,
	                   o_Delay_Finish => #s_CMD_Enable,
	                   io_Setpoint    := #s_Cnt_Enable_Delay);
	END_REGION
	
	REGION NETWORK: Choose Speedsetpoint
	    IF #i_CMD_Select_Speed = 0 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed1;
	    ELSIF #i_CMD_Select_Speed = 1 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed2;
	    ELSIF #i_CMD_Select_Speed = 2 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed3;
	    ELSIF #i_CMD_Select_Speed = 3 THEN
	        #o_Speed_Selected := #i_HW_Setting.Speed4;
	    ELSE
	        #o_Speed_Selected := #i_HW_Setting.Speed1;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Motor Run
	    #s_Motor_Run := #i_CMD_Motor_Run AND #t_IO_Available AND NOT #o_ER_Motor_Fault AND NOT #o_ER_STO_Active AND NOT #s_Switch_In_Progress;
	END_REGION
	
	REGION NETWORK: 112# Telegram   
	    REGION Set Software Interface
	        #s_SW_In.Mode := 3;
	        #s_SW_In.Enbale := #s_CMD_Enable AND #t_IO_Available AND NOT #s_SW_Out.Lockout AND NOT #s_SW_Out.AxisError;
	        //#s_SW_In.ExecuteMode := #s_Motor_Run;
	        #s_SW_In.AckError := #s_CMD_Reset;
	        #s_SW_In.Positive := NOT (#i_CMD_Motor_Reverse XOR #i_HW_Setting.ReverseDirection);
	        #s_SW_In.Negative := NOT #s_SW_In.Positive;
	        #s_SW_In.Velocity := INT_TO_REAL(#o_Speed_Selected);
	        #s_SW_In.OverV := 100;
	        #s_SW_In.Acceleration := INT_TO_REAL(#i_HW_Setting.Acceleration);
	        #s_SW_In.Deceleration := INT_TO_REAL(#i_HW_Setting.Deceleration);
	        #s_SW_In.CancelTraversing := #i_Enable AND #t_IO_Available;
	        #s_SW_In.IntermediateStop := #s_Motor_Run;
	        #s_SW_In.Jog_Left := FALSE;
	        #s_SW_In.Jog_Right := FALSE;
	        #s_SW_In.ConfigEPOS := 16#00000003;
	        #s_SW_In.ConfigEPOS.%X1 := #i_Safety_OK;
	        #s_SW_In.ConfigEPOS.%X8 := #i_HW_Setting.Continuous_Action_Mode;
	    END_REGION
	    
	    #s_FB_SINA_POS_TEL112(modePos          := #s_SW_In.Mode,
	                          enableAxis       := #s_SW_In.Enbale,
	                          cancelTraversing := #s_SW_In.CancelTraversing,
	                          intermediateStop := #s_SW_In.IntermediateStop,
	                          positive         := #s_SW_In.Positive,
	                          negative         := #s_SW_In.Negative,
	                          jog1             := #s_SW_In.Jog_Left,
	                          jog2             := #s_SW_In.Jog_Right,
	                          flyRef           := #s_SW_In.FlyRef,
	                          ackError         := #s_SW_In.AckError,
	                          executeMode      := #s_SW_In.ExecuteMode,
	                          position         := #s_SW_In.Position,
	                          velocity         := #s_SW_In.Velocity,
	                          overV            := #s_SW_In.OverV,
	                          acceleration     := #s_SW_In.Acceleration,
	                          deceleration     := #s_SW_In.Deceleration,
	                          fixStopTorque    := #s_SW_In.FixStopTorque,
	                          refCoordinate    := #s_SW_In.RefCoordinate,
	                          configEPOS       := #s_SW_In.ConfigEPOS,
	                          axisEnabled      => #s_SW_Out.AxisEnabled,
	                          axisPosOk        => #s_SW_Out.AxisPosOk,
	                          axisSpFixed      => #s_SW_Out.AxisSpFixed,
	                          axisRef          => #s_SW_Out.AxisRef,
	                          axisWarn         => #s_SW_Out.AxisWarn,
	                          axisError        => #s_SW_Out.AxisError,
	                          lockOut          => #s_SW_Out.Lockout,
	                          actVelocity      => #s_SW_Out.ActVelocity,
	                          actPosition      => #s_SW_Out.ActPosition,
	                          actMode          => #s_SW_Out.ActMode,
	                          actWarn          => #s_SW_Out.AlarmCode,
	                          actFault         => #s_SW_Out.FaultCode,
	                          error            => #s_SW_Out.Error,
	                          status           => #s_SW_Out.Status,
	                          diagID           => #s_SW_Out.DiagID,
	                          InputData        := #io_S210_Interface.Input,
	                          OutputData       := #io_S210_Interface.Output);
	    
	    #o_FaultCode := #s_SW_Out.FaultCode;
	    #o_AlarmCode := #s_SW_Out.AlarmCode;
	END_REGION
	
	REGION NETWORK: Motor Status
	    IF #s_CMD_Reset OR NOT #t_IO_Available OR NOT #i_Safety_OK THEN
	        #o_ER_Motor_Fault := FALSE;
	        #o_ER_STO_Active := FALSE;
	    END_IF;
	    
	    IF #t_IO_Available AND #i_Safety_OK AND (#s_SW_Out.AxisError OR #s_SW_Out.Lockout) THEN
	        #o_ER_Motor_Fault := TRUE;
	    END_IF;
	    
	    IF #o_ER_Motor_Fault AND NOT (#s_SW_Out.AxisError OR #s_SW_Out.Lockout) THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	    
	    #o_WN_Motor_Alarm := #t_IO_Available AND #i_Safety_OK AND #s_SW_Out.AxisWarn;
	    
	    IF
	        #t_IO_Available
	        AND #i_Safety_OK
	        AND #i_HW_Setting.STOUsed
	        AND (NOT #io_S210_Interface.Input.ZSW_S210_Bit02_DI2
	        OR NOT #io_S210_Interface.Input.ZSW_S210_Bit03_DI3)
	    THEN
	        #o_ER_STO_Active := TRUE;
	    END_IF;
	    
	    IF
	        #o_ER_STO_Active
	        AND NOT (NOT #io_S210_Interface.Input.ZSW_S210_Bit02_DI2
	        OR NOT #io_S210_Interface.Input.ZSW_S210_Bit03_DI3)
	    THEN
	        #o_Ready_To_Reset := TRUE;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Write IO
	    "FC_IFM_VFD_S210_Out"(i_Telegram_HW_ID            := #i_Telegram_HW_ID,
	                          i_Data                      := #io_S210_Interface.Output,
	                          o_Telegram_Start_Address    => #t_Start_Address,
	                          o_ActualValue_Start_Address => #t_Start_Address);
	END_REGION
	
	REGION NETWORK: Diagnostics and Statistical
	    #o_Diagnostics.Run_Command := #s_SW_In.Enbale AND #s_SW_In.CancelTraversing AND #s_SW_In.IntermediateStop;
	    #o_Diagnostics.DI0 := #io_S210_Interface.Input.ZSW_S210_Bit00_DI0;
	    #o_Diagnostics.DI1 := #io_S210_Interface.Input.ZSW_S210_Bit01_DI1;
	    #o_Diagnostics.DI2 := #io_S210_Interface.Input.ZSW_S210_Bit02_DI2;
	    #o_Diagnostics.DI3 := #io_S210_Interface.Input.ZSW_S210_Bit03_DI3;
	    #o_Diagnostics.DI4 := #io_S210_Interface.Input.ZSW_S210_Bit04_DI4;
	    #o_Diagnostics.PN_Port1_Down := FALSE;
	    #o_Diagnostics.PN_Port2_Down := FALSE;
	    #o_Diagnostics.Actual_Position := #io_S210_Interface.Input.XIST;
	    #o_Diagnostics.DCLink_Voltage := #io_S210_Interface.Input.DCLinkVoltage;
	    #o_Diagnostics.Actual_Current := #io_S210_Interface.Input.ActualCurrent;
	    #o_Diagnostics.Active_Power := #io_S210_Interface.Input.ActivePower;
	    
	    #o_Diagnostics.Actual_Speed := REAL_TO_INT(#s_SW_Out.ActVelocity);
	    #o_Diagnostics.Actual_Displacement := REAL_TO_INT(LIMIT_REAL(MN := 0, IN := #s_SW_Out.ActPosition - #s_Copy.ActPosition, MX := 1000.0));
	    IF NOT #s_SW_In.Positive OR NOT #s_CMD_Enable THEN
	        #o_Diagnostics.Actual_Displacement := 0;
	    END_IF;
	    
	    IF #s_Motor_Run AND NOT #s_Copy.MTR_Run THEN
	        #o_Diagnostics.Motor_Start_Stop_Count += 1;
	    END_IF;
	    
	    IF #s_Motor_Run AND #io_Global.OS_New_Second THEN
	        #o_Diagnostics.Motor_Started_Time += 1;
	    END_IF;
	    
	    IF #i_CMD_Clear_Stat AND NOT #s_Copy.Clear_Stat THEN
	        #o_Diagnostics.Motor_Started_Time := 0;
	        #o_Diagnostics.Motor_Start_Stop_Count := 0;
	        #o_Diagnostics.Motor_Direction_Switch_Count := 0;
	    END_IF;
	END_REGION
	
	REGION NETWORK: Storage Previous State
	    #s_Copy.MTR_Run := #s_Motor_Run;
	    #s_Copy.MTR_Reverse := #i_CMD_Motor_Reverse;
	    #s_Copy.Clear_Stat := #i_CMD_Clear_Stat;
	    #s_Copy.ActPosition := #s_SW_Out.ActPosition;
	END_REGION
END_FUNCTION_BLOCK

TYPE "UDT_General_Status"
TITLE = UDT_General_Status
VERSION : 0.1
//Flow interface of each section and object
//# Block Info
//- Title:            UDT_General_Status
//- Comment/Function: Flow interface of each section and object
//- Library/Family:   APS
//- Author:           Jay Liu
//- Tested with:      ---
//- Engineering:      TIA Portal V20
//- Restrictions:     ---
//- Requirements:     ---
//
//# History
// |Version  | Date       | Author                 | Description                   |
// |---------|------------|------------------------|------------------------------ |
// |01.00.00 | 2026-01-22 | Jay Liu                | First released version        |
   STRUCT
      Safety_Stop : Bool;   // The component has detected an safety event
      Off_Line : Bool;   // A local operator (Technician) in the field puts the component out of operation
      Manual : Bool;   // The component is on manual mode
      Error : Bool;   // The component has detected a fault with a high severity
      Jam : Bool;   // The component has detected a jam state
      Warning : Bool;   // The component has detected a fault with a low severity
      Started : Bool;   // The component is operational on and automatically fulfilling its function
      Die_Back : Bool;   // The component is occupied with items and the downstream component is not available
      Items : Bool;   // The component is occupied with items
      Energy_Saving : Bool;   // The component is in energy saving
      Motor_Running : Bool;   // The component is running
      Motor_Stopped : Bool;   // The component is stopped. (Actuele speed = 0)
      Motor_On_Speed : Bool;   // The component is running on target speed
      SPARE_1_5 : Bool;   // SPARE_1_5
      SPARE_1_6 : Bool;   // SPARE_1_6
      SPARE_1_7 : Bool;   // SPARE_1_7
   END_STRUCT;

END_TYPE

FUNCTION "FC_IsValue_InTolerance" : Bool
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_Value : Int;   // Value to be checked to determine whether it is within the defined value range
      i_Setpoint : Int;   // Set point
      i_High_Tolerance : Int;   // High tolerance range around the set point in percent (%), <0 means infinite
      i_Low_Tolerance : Int;   // Low tolerance range around the set point in percent (%), <0 means infinite
   END_VAR

   VAR_TEMP 
      t_High_Limit : Real;   // Calculated high limit
      t_Low_Limit : Real;   // Calculated low limit
      t_Value_Over_High_Limt : Bool;   // Input value is over the high limit
      t_Value_Over_Low_Limt : Bool;   // Input value is below the low limit
   END_VAR


BEGIN
	IF #i_Setpoint >= 0 THEN
	    #t_High_Limit := INT_TO_REAL(#i_Setpoint) * (1.0 + INT_TO_REAL(ABS_INT(#i_High_Tolerance)) / 100.0);
	    #t_Low_Limit := INT_TO_REAL(#i_Setpoint) * (1.0 - INT_TO_REAL(ABS_INT(#i_Low_Tolerance)) / 100.0);
	ELSE
	    #t_High_Limit := INT_TO_REAL(#i_Setpoint) * (1.0 - INT_TO_REAL(ABS_INT(#i_High_Tolerance)) / 100.0);
	    #t_Low_Limit := INT_TO_REAL(#i_Setpoint) * (1.0 + INT_TO_REAL(ABS_INT(#i_Low_Tolerance)) / 100.0);
	END_IF;
	
	#t_Value_Over_High_Limt := FALSE;
	#t_Value_Over_Low_Limt := FALSE;
	
	IF #i_High_Tolerance >= 0 THEN
	    #t_Value_Over_High_Limt := INT_TO_REAL(#i_Value) > #t_High_Limit;
	END_IF;
	
	IF #i_Low_Tolerance >= 0 THEN
	    #t_Value_Over_Low_Limt := INT_TO_REAL(#i_Value) < #t_Low_Limit;
	END_IF;
	
	#FC_IsValue_InTolerance := NOT #t_Value_Over_High_Limt AND NOT #t_Value_Over_Low_Limt;
END_FUNCTION

FUNCTION_BLOCK "FB_HW_SWS_Roller_Interface"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CFG_HW_Port : HW_ANY;
      i_IO_Available : Bool;
      i_OB_First_Scan : Bool;
      i_CMD_Reset : Bool;
      i_CFG_Status_Interval : Time := T#100MS;
      i_CFG_Num_Of_Comm_Error : Int := 3;
      i_Sett_Roller_Hardware : "UDT_SWS_Roller_Hardware_Setting";
      i_Roller_Running : Bool;
   END_VAR

   VAR_OUTPUT 
      o_WN_Modbus_Initializing : Bool;
      o_ER_Modbus_Initialize_Fault : Bool;
      o_ER_Modbus_Com_Error : Bool;
      o_Modules_Status : Array[1..#C_ARRAY_COUNT] of "UDT_SWS_Roller_Module_Status";
   END_VAR

   VAR 
      s_Initialized : Bool;
      s_FieldBus_Status_Ready : Bool;
      s_Prev_FieldBus_Status : Bool;
      s_MB_Comm_Load {InstructionName := 'Modbus_Comm_Load'; LibVersion := '5.0'} : Modbus_Comm_Load;
      s_MB_Master {InstructionName := 'Modbus_Master'; LibVersion := '6.0'} : Modbus_Master;
      s_Modbus_Comm_Contr : Struct
         Req : Bool;
         Done : Bool;
         Error : Bool;
         Idle : Bool;
         Busy : Bool;
         Update_Speed : Bool;
         Query_Alarm : Bool;
         StationAddr : UInt;
         Mode : USInt;
         DataAddr : UDInt;
         DataLength : UInt;
         Status : Word;
         Data : Array[1..#C_MODBUS_DATA_BUFFER] of Byte;
      END_STRUCT;
      s_Prev_Speed_Straight : Int;
      s_Prev_Speed_Left : Int;
      s_Prev_Speed_Right : Int;
      s_Cnt_Comm_Error : Int;
      s_Pulse_Generator {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      s_Module_Index : Int := 1;
      s_Group_A_Motors_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..6] of "UDT_SWS_Roller_Module_Motor_Status";
      s_Group_B_Motors_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..6] of "UDT_SWS_Roller_Module_Motor_Status";
      s_Group_C_Motors_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..6] of "UDT_SWS_Roller_Module_Motor_Status";
      s_Group_D_Motors_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..6] of "UDT_SWS_Roller_Module_Motor_Status";
      s_Group_E_Motors_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..6] of "UDT_SWS_Roller_Module_Motor_Status";
      s_Group_F_Motors_Status { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'; S7_SetPoint := 'False'} : Array[1..6] of "UDT_SWS_Roller_Module_Motor_Status";
      s_Overall_Group_Motors_Status : "UDT_SWS_Roller_Module_Motor_Status";
      s_Cnt_Module_Com_Error : Array[1..#C_ARRAY_COUNT] of UInt;
   END_VAR

   VAR_TEMP 
      t_Initial_Req : Bool;
      t_Initial_Done : Bool;
      t_Initial_Error : Bool;
      t_Initial_Status : Word;
      t_RetVal : Int;
      t_Index : UInt;
      t_Motor_Index : UInt;
      t_Pos : DInt;
      t_Byte : Byte;
      t_Req_Query_Status : Bool;
      t_CMD_Reset : Bool;
      t_Cnt_Motor_Connected : UInt;
      t_Motor_RPM : UInt;
   END_VAR

   VAR CONSTANT 
      C_MODBUS_TIMEOUT : UInt := 200;   // [ms]
      C_MODBUS_DATA_BUFFER : UInt := 72;
      C_SIEMENS_MODBUS_START_ADDR : UDInt := 40001;
      C_MAMBAROLL_MODBUS_SPEED_ADDR : UDInt := 1036;
      C_MAMBAROLL_MODBUS_ALARM_ADDR : UDInt := 768;
      C_ARRAY_COUNT : UInt := 9;
   END_VAR


BEGIN
	REGION Init    
	    IF #i_CFG_HW_Port <= 0 THEN
	        RETURN;
	    END_IF;
	    #s_FieldBus_Status_Ready := #i_IO_Available;
	    #t_CMD_Reset := #i_CMD_Reset;
	END_REGION
	
	REGION Initialize Modbus Configuration    
	    #t_Initial_Req := #i_OB_First_Scan OR (NOT #s_Initialized AND #t_CMD_Reset) OR (#s_FieldBus_Status_Ready AND NOT #s_Prev_FieldBus_Status);
	    #s_Prev_FieldBus_Status := #s_FieldBus_Status_Ready;
	    
	    #s_MB_Comm_Load.MODE := 4;//Half duplex (RS485) two-wire mode
	    #s_MB_Comm_Load(REQ         := #t_Initial_Req,
	                    "PORT"      := #i_CFG_HW_Port,
	                    BAUD        := 38400,
	                    PARITY      := 2,
	                    FLOW_CTRL   := 0,
	                    RTS_ON_DLY  := 0,
	                    RTS_OFF_DLY := 0,
	                    RESP_TO     := #C_MODBUS_TIMEOUT,
	                    DONE        => #t_Initial_Done,
	                    ERROR       => #t_Initial_Error,
	                    STATUS      => #t_Initial_Status,
	                    MB_DB       := #s_MB_Master.MB_DB);
	    
	    IF #t_Initial_Req THEN
	        #s_Initialized := FALSE;
	        #o_WN_Modbus_Initializing := TRUE;
	    END_IF;
	    IF #t_Initial_Done AND NOT #t_Initial_Error AND NOT #s_Initialized THEN
	        #s_Initialized := TRUE;
	        #o_WN_Modbus_Initializing := FALSE;
	    END_IF;
	    IF NOT #s_Initialized THEN
	        RETURN;
	    END_IF;
	END_REGION
	
	REGION Modbus Communication
	    #s_MB_Master(REQ       := #s_Modbus_Comm_Contr.Req,
	                 MB_ADDR   := #s_Modbus_Comm_Contr.StationAddr,
	                 MODE      := #s_Modbus_Comm_Contr.Mode,
	                 DATA_ADDR := #s_Modbus_Comm_Contr.DataAddr,
	                 DATA_LEN  := #s_Modbus_Comm_Contr.DataLength,
	                 DONE      => #s_Modbus_Comm_Contr.Done,
	                 ERROR     => #s_Modbus_Comm_Contr.Error,
	                 STATUS    => #s_Modbus_Comm_Contr.Status,
	                 DATA_PTR  := #s_Modbus_Comm_Contr.Data);
	    
	    #s_Modbus_Comm_Contr.Idle := #s_Modbus_Comm_Contr.Status = 16#7000 AND NOT #s_Modbus_Comm_Contr.Error AND #s_FieldBus_Status_Ready;
	    #s_Modbus_Comm_Contr.Busy := #s_Modbus_Comm_Contr.Status = 16#7001 OR #s_Modbus_Comm_Contr.Status = 16#7002;
	    
	    IF #s_Modbus_Comm_Contr.Idle THEN
	        #s_Modbus_Comm_Contr.Req := FALSE;
	    END_IF;
	    
	    IF #s_Modbus_Comm_Contr.Done AND NOT #s_Modbus_Comm_Contr.Error THEN
	        IF #s_Modbus_Comm_Contr.Query_Alarm THEN
	            #s_Overall_Group_Motors_Status.None :=
	            #s_Overall_Group_Motors_Status.NotConnected :=
	            #s_Overall_Group_Motors_Status.Blockage := FALSE;
	            #s_Overall_Group_Motors_Status.OK := TRUE;
	            #t_Cnt_Motor_Connected := 0;
	            FOR #t_Index := 1 TO #C_MODBUS_DATA_BUFFER DO
	                IF #t_Index MOD 2 = 0 THEN
	                    CONTINUE;
	                END_IF;
	                #t_Motor_Index := (#t_Index + 1) / 2;
	                CASE #t_Motor_Index OF
	                    1..6:
	                        "FC_SWS_Convert_Motor_Status"(i_Status_Byte_1 := #s_Modbus_Comm_Contr.Data[#t_Index],
	                                                      i_Status_Byte_2 := #s_Modbus_Comm_Contr.Data[#t_Index + 1],
	                                                      o_Motor_Status  => #s_Group_F_Motors_Status[#t_Motor_Index]);
	                        #s_Overall_Group_Motors_Status.None := #s_Overall_Group_Motors_Status.None OR #s_Group_F_Motors_Status[#t_Motor_Index].None;
	                        #s_Overall_Group_Motors_Status.NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #s_Group_F_Motors_Status[#t_Motor_Index].NotConnected;
	                        #s_Overall_Group_Motors_Status.Blockage := #s_Overall_Group_Motors_Status.Blockage OR #s_Group_F_Motors_Status[#t_Motor_Index].Blockage;
	                        #s_Overall_Group_Motors_Status.OK := #s_Overall_Group_Motors_Status.OK AND #s_Group_F_Motors_Status[#t_Motor_Index].OK;
	                        IF
	                            #s_Group_F_Motors_Status[#t_Motor_Index].NotConnected
	                            OR #s_Group_F_Motors_Status[#t_Motor_Index].Blockage
	                            OR #s_Group_F_Motors_Status[#t_Motor_Index].OK
	                        THEN
	                            #t_Cnt_Motor_Connected += 1;
	                        END_IF;
	                    7..12:
	                        "FC_SWS_Convert_Motor_Status"(i_Status_Byte_1 := #s_Modbus_Comm_Contr.Data[#t_Index],
	                                                      i_Status_Byte_2 := #s_Modbus_Comm_Contr.Data[#t_Index + 1],
	                                                      o_Motor_Status  => #s_Group_E_Motors_Status[#t_Motor_Index - 6]);
	                        #s_Overall_Group_Motors_Status.None := #s_Overall_Group_Motors_Status.None OR #s_Group_E_Motors_Status[#t_Motor_Index - 6].None;
	                        #s_Overall_Group_Motors_Status.NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #s_Group_E_Motors_Status[#t_Motor_Index - 6].NotConnected;
	                        #s_Overall_Group_Motors_Status.Blockage := #s_Overall_Group_Motors_Status.Blockage OR #s_Group_E_Motors_Status[#t_Motor_Index - 6].Blockage;
	                        #s_Overall_Group_Motors_Status.OK := #s_Overall_Group_Motors_Status.OK AND #s_Group_E_Motors_Status[#t_Motor_Index - 6].OK;
	                        IF
	                            #s_Group_E_Motors_Status[#t_Motor_Index - 6].NotConnected
	                            OR #s_Group_E_Motors_Status[#t_Motor_Index - 6].Blockage
	                            OR #s_Group_E_Motors_Status[#t_Motor_Index - 6].OK
	                        THEN
	                            #t_Cnt_Motor_Connected += 1;
	                        END_IF;
	                    13..18:
	                        "FC_SWS_Convert_Motor_Status"(i_Status_Byte_1 := #s_Modbus_Comm_Contr.Data[#t_Index],
	                                                      i_Status_Byte_2 := #s_Modbus_Comm_Contr.Data[#t_Index + 1],
	                                                      o_Motor_Status  => #s_Group_D_Motors_Status[#t_Motor_Index - 12]);
	                        #s_Overall_Group_Motors_Status.None := #s_Overall_Group_Motors_Status.None OR #s_Group_D_Motors_Status[#t_Motor_Index - 12].None;
	                        #s_Overall_Group_Motors_Status.NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #s_Group_D_Motors_Status[#t_Motor_Index - 12].NotConnected;
	                        #s_Overall_Group_Motors_Status.Blockage := #s_Overall_Group_Motors_Status.Blockage OR #s_Group_D_Motors_Status[#t_Motor_Index - 12].Blockage;
	                        #s_Overall_Group_Motors_Status.OK := #s_Overall_Group_Motors_Status.OK AND #s_Group_D_Motors_Status[#t_Motor_Index - 12].OK;
	                        IF
	                            #s_Group_D_Motors_Status[#t_Motor_Index - 12].NotConnected
	                            OR #s_Group_D_Motors_Status[#t_Motor_Index - 12].Blockage
	                            OR #s_Group_D_Motors_Status[#t_Motor_Index - 12].OK
	                        THEN
	                            #t_Cnt_Motor_Connected += 1;
	                        END_IF;
	                    19..24:
	                        "FC_SWS_Convert_Motor_Status"(i_Status_Byte_1 := #s_Modbus_Comm_Contr.Data[#t_Index],
	                                                      i_Status_Byte_2 := #s_Modbus_Comm_Contr.Data[#t_Index + 1],
	                                                      o_Motor_Status  => #s_Group_C_Motors_Status[#t_Motor_Index - 18]);
	                        #s_Overall_Group_Motors_Status.None := #s_Overall_Group_Motors_Status.None OR #s_Group_C_Motors_Status[#t_Motor_Index - 18].None;
	                        #s_Overall_Group_Motors_Status.NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #s_Group_C_Motors_Status[#t_Motor_Index - 18].NotConnected;
	                        #s_Overall_Group_Motors_Status.Blockage := #s_Overall_Group_Motors_Status.Blockage OR #s_Group_C_Motors_Status[#t_Motor_Index - 18].Blockage;
	                        #s_Overall_Group_Motors_Status.OK := #s_Overall_Group_Motors_Status.OK AND #s_Group_C_Motors_Status[#t_Motor_Index - 18].OK;
	                        IF
	                            #s_Group_C_Motors_Status[#t_Motor_Index - 18].NotConnected
	                            OR #s_Group_C_Motors_Status[#t_Motor_Index - 18].Blockage
	                            OR #s_Group_C_Motors_Status[#t_Motor_Index - 18].OK
	                        THEN
	                            #t_Cnt_Motor_Connected += 1;
	                        END_IF;
	                    25..30:
	                        "FC_SWS_Convert_Motor_Status"(i_Status_Byte_1 := #s_Modbus_Comm_Contr.Data[#t_Index],
	                                                      i_Status_Byte_2 := #s_Modbus_Comm_Contr.Data[#t_Index + 1],
	                                                      o_Motor_Status  => #s_Group_B_Motors_Status[#t_Motor_Index - 24]);
	                        #s_Overall_Group_Motors_Status.None := #s_Overall_Group_Motors_Status.None OR #s_Group_B_Motors_Status[#t_Motor_Index - 24].None;
	                        #s_Overall_Group_Motors_Status.NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #s_Group_B_Motors_Status[#t_Motor_Index - 24].NotConnected;
	                        #s_Overall_Group_Motors_Status.Blockage := #s_Overall_Group_Motors_Status.Blockage OR #s_Group_B_Motors_Status[#t_Motor_Index - 24].Blockage;
	                        #s_Overall_Group_Motors_Status.OK := #s_Overall_Group_Motors_Status.OK AND #s_Group_B_Motors_Status[#t_Motor_Index - 24].OK;
	                        IF
	                            #s_Group_B_Motors_Status[#t_Motor_Index - 24].NotConnected
	                            OR #s_Group_B_Motors_Status[#t_Motor_Index - 24].Blockage
	                            OR #s_Group_B_Motors_Status[#t_Motor_Index - 24].OK
	                        THEN
	                            #t_Cnt_Motor_Connected += 1;
	                        END_IF;
	                    31..36:
	                        "FC_SWS_Convert_Motor_Status"(i_Status_Byte_1 := #s_Modbus_Comm_Contr.Data[#t_Index],
	                                                      i_Status_Byte_2 := #s_Modbus_Comm_Contr.Data[#t_Index + 1],
	                                                      o_Motor_Status  => #s_Group_A_Motors_Status[#t_Motor_Index - 30]);
	                        #s_Overall_Group_Motors_Status.None := #s_Overall_Group_Motors_Status.None OR #s_Group_A_Motors_Status[#t_Motor_Index - 30].None;
	                        #s_Overall_Group_Motors_Status.NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #s_Group_A_Motors_Status[#t_Motor_Index - 30].NotConnected;
	                        #s_Overall_Group_Motors_Status.Blockage := #s_Overall_Group_Motors_Status.Blockage OR #s_Group_A_Motors_Status[#t_Motor_Index - 30].Blockage;
	                        #s_Overall_Group_Motors_Status.OK := #s_Overall_Group_Motors_Status.OK AND #s_Group_A_Motors_Status[#t_Motor_Index - 30].OK;
	                        IF
	                            #s_Group_A_Motors_Status[#t_Motor_Index - 30].NotConnected
	                            OR #s_Group_A_Motors_Status[#t_Motor_Index - 30].Blockage
	                            OR #s_Group_A_Motors_Status[#t_Motor_Index - 30].OK
	                            
	                        THEN
	                            #t_Cnt_Motor_Connected += 1;
	                        END_IF;
	                END_CASE;
	            END_FOR;
	            #o_Modules_Status[#s_Module_Index].WN_Motor_Blockage := #s_Overall_Group_Motors_Status.Blockage;
	            #o_Modules_Status[#s_Module_Index].WN_Motor_NotConnected := #s_Overall_Group_Motors_Status.NotConnected OR #t_Cnt_Motor_Connected <= #i_Sett_Roller_Hardware.Module_Roller_Count;
	            #s_Cnt_Module_Com_Error[#s_Module_Index] := 0;
	        END_IF;
	        
	        #s_Modbus_Comm_Contr.Update_Speed := FALSE;
	        #s_Modbus_Comm_Contr.Query_Alarm := FALSE;
	        #s_Modbus_Comm_Contr.Req := FALSE;
	        #s_Cnt_Comm_Error := 0;
	    END_IF;
	    
	    IF #s_Modbus_Comm_Contr.Error THEN
	        IF #i_CFG_Num_Of_Comm_Error > 0 THEN
	            IF #s_Modbus_Comm_Contr.Query_Alarm THEN
	                #s_Cnt_Module_Com_Error[#s_Module_Index] += 1;
	            ELSE
	                #s_Cnt_Comm_Error += 1;
	            END_IF;
	        END_IF;
	        
	        #s_Modbus_Comm_Contr.Update_Speed := FALSE;
	        #s_Modbus_Comm_Contr.Query_Alarm := FALSE;
	        #s_Modbus_Comm_Contr.Req := FALSE;
	    END_IF;
	    
	    IF #i_CFG_Num_Of_Comm_Error > 0 THEN
	        IF #s_Cnt_Comm_Error >= #i_CFG_Num_Of_Comm_Error AND #s_FieldBus_Status_Ready THEN
	            #o_ER_Modbus_Com_Error := TRUE;
	            #s_Cnt_Comm_Error := #i_CFG_Num_Of_Comm_Error;
	        END_IF;
	        
	        FOR #t_Index := 1 TO #C_ARRAY_COUNT DO
	            IF #s_Cnt_Module_Com_Error[#s_Module_Index] >= #i_CFG_Num_Of_Comm_Error THEN
	                #s_Cnt_Module_Com_Error[#s_Module_Index] := #i_CFG_Num_Of_Comm_Error;
	            END_IF;
	            IF #t_CMD_Reset THEN
	                #s_Cnt_Module_Com_Error[#s_Module_Index] := 0;
	            END_IF;
	            #o_Modules_Status[#s_Module_Index].WN_Modbus_Com_Error := #s_Cnt_Module_Com_Error[#s_Module_Index] >= #i_CFG_Num_Of_Comm_Error;
	        END_FOR;
	    ELSE
	        FOR #t_Index := 1 TO #C_ARRAY_COUNT DO
	            #o_Modules_Status[#s_Module_Index].WN_Modbus_Com_Error := FALSE;
	        END_FOR;
	    END_IF;
	    
	    IF #t_CMD_Reset AND #s_FieldBus_Status_Ready OR #i_CFG_Num_Of_Comm_Error = 0 THEN
	        #o_ER_Modbus_Com_Error := FALSE;
	        #s_Cnt_Comm_Error := 0;
	    END_IF;
	END_REGION
	
	REGION Update Speed
	    IF
	        (#i_Sett_Roller_Hardware.Speed_Straight <> #s_Prev_Speed_Straight
	        OR #i_Sett_Roller_Hardware.Speed_Left <> #s_Prev_Speed_Left
	        OR #i_Sett_Roller_Hardware.Speed_Right <> #s_Prev_Speed_Right)
	        AND #s_Modbus_Comm_Contr.Idle AND NOT #i_Roller_Running
	        
	    THEN
	        #s_Modbus_Comm_Contr.Req := #s_Modbus_Comm_Contr.Update_Speed := TRUE;
	        #s_Modbus_Comm_Contr.Idle := FALSE;
	        // Broadcast 
	        #s_Modbus_Comm_Contr.StationAddr := 0;
	        // Mode 1 would convert to modbus function 16.
	        #s_Modbus_Comm_Contr.Mode := 1;
	        #s_Modbus_Comm_Contr.DataAddr := #C_SIEMENS_MODBUS_START_ADDR + #C_MAMBAROLL_MODBUS_SPEED_ADDR;
	        #s_Modbus_Comm_Contr.DataLength := 4;
	        #t_Pos := 0;
	        #t_RetVal := WRITE_BIG(src_variable := DINT_TO_INT(0), dest_array := #s_Modbus_Comm_Contr.Data, pos := #t_Pos);
	        
	        #t_Motor_RPM := REAL_TO_UINT(INT_TO_REAL(#i_Sett_Roller_Hardware.Speed_Straight) / 1000.0 * #i_Sett_Roller_Hardware.Reference_RPM);
	        #t_RetVal := WRITE_BIG(src_variable := #t_Motor_RPM, dest_array := #s_Modbus_Comm_Contr.Data, pos := #t_Pos);
	        
	        #t_Motor_RPM := REAL_TO_UINT(INT_TO_REAL(#i_Sett_Roller_Hardware.Speed_Left) / 1000.0 * #i_Sett_Roller_Hardware.Reference_RPM);
	        #t_RetVal := WRITE_BIG(src_variable := #t_Motor_RPM, dest_array := #s_Modbus_Comm_Contr.Data, pos := #t_Pos);
	        
	        #t_Motor_RPM := REAL_TO_UINT(INT_TO_REAL(#i_Sett_Roller_Hardware.Speed_Right) / 1000.0 * #i_Sett_Roller_Hardware.Reference_RPM);
	        #t_RetVal := WRITE_BIG(src_variable := #t_Motor_RPM, dest_array := #s_Modbus_Comm_Contr.Data, pos := #t_Pos);
	        
	        #s_Prev_Speed_Straight := #i_Sett_Roller_Hardware.Speed_Straight;
	        #s_Prev_Speed_Left := #i_Sett_Roller_Hardware.Speed_Left;
	        #s_Prev_Speed_Right := #i_Sett_Roller_Hardware.Speed_Right;
	    END_IF;
	END_REGION
	
	REGION Read Alarm
	    #s_Pulse_Generator(IN := TRUE,
	                       PT := #i_CFG_Status_Interval,
	                       Q  => #t_Req_Query_Status);
	    
	    IF #t_Req_Query_Status THEN
	        RESET_TIMER(#s_Pulse_Generator);
	    END_IF;
	    
	    IF #t_Req_Query_Status AND #s_Modbus_Comm_Contr.Idle THEN
	        #s_Modbus_Comm_Contr.Req := #s_Modbus_Comm_Contr.Query_Alarm := TRUE;
	        #s_Modbus_Comm_Contr.Idle := FALSE;
	        // Broadcast
	        #s_Modbus_Comm_Contr.StationAddr := #s_Module_Index := (#s_Module_Index MOD #C_ARRAY_COUNT) + 1;
	        // Mode 0 would convert to modbus function 03
	        #s_Modbus_Comm_Contr.Mode := 0;
	        #s_Modbus_Comm_Contr.DataAddr := #C_SIEMENS_MODBUS_START_ADDR + #C_MAMBAROLL_MODBUS_ALARM_ADDR;
	        #s_Modbus_Comm_Contr.DataLength := 36;
	        #t_Byte := 0;
	        FILL_BLK(IN    := #t_Byte,
	                 COUNT := #s_Modbus_Comm_Contr.DataLength * 2,
	                 OUT   => #s_Modbus_Comm_Contr.Data[1]);
	    END_IF;
	END_REGION
END_FUNCTION_BLOCK

TYPE "UDT_Conv_Dual_G115D_Status"
VERSION : 0.1
   STRUCT
      OL_Maintenance_Mode : Bool;   // Maintenance mode on
      ER_PE1_Blockage : Bool;   // PE1 blockage
      ER_PE2_Blockage : Bool;   // PE2 blockage
      ER_U01_VFD_PN_NotPresent : Bool;   // VFD 1# not present on profinet network
      ER_U01_VFD_PN_Error : Bool;   // VFD 1# has error profinet network
      ER_U01_VFD_Fault : Bool;   // VFD 1# has error
      WN_U01_VFD_Alarm : Bool;   // VFD 1# has an warning
      ER_U01_VFD_STO_Active : Bool;   // VFD 1# STO is active
      WN_U01_No_MemoryCard : Bool;   // Memory card is missing
      ER_U02_VFD_PN_NotPresent : Bool;   // VFD 2# not present on profinet network
      ER_U02_VFD_PN_Error : Bool;   // VFD 2# has error profinet network
      ER_U02_VFD_Fault : Bool;   // VFD 2# has error
      WN_U02_VFD_Alarm : Bool;   // VFD 2# has an warning
      ER_U02_VFD_STO_Active : Bool;   // VFD 2# STO is active
      WN_U02_No_MemoryCard : Bool;   // Memory card is missing
      Spare_1_7 : Bool;   // Spare_1_7
      Spare_2_0 : Bool;   // Spare_2_0
      Spare_2_1 : Bool;   // Spare_2_1
      Spare_2_2 : Bool;   // Spare_2_2
      Spare_2_3 : Bool;   // Spare_2_3
      Spare_2_4 : Bool;   // Spare_2_4
      Spare_2_5 : Bool;   // Spare_2_5
      Spare_2_6 : Bool;   // Spare_2_6
      Spare_2_7 : Bool;   // Spare_2_7
      Spare_3_0 : Bool;   // Spare_3_0
      Spare_3_1 : Bool;   // Spare_3_1
      Spare_3_2 : Bool;   // Spare_3_2
      Spare_3_3 : Bool;   // Spare_3_3
      Spare_3_4 : Bool;   // Spare_3_4
      Spare_3_5 : Bool;   // Spare_3_5
      Spare_3_6 : Bool;   // Spare_3_6
      Spare_3_7 : Bool;   // Spare_3_7
      U01_FaultCode : Word;   // VFD 1# fault code
      U01_AlarmCode : Word;   // VFD 1# alarm code
      U02_FaultCode : Word;   // VFD 2# fault code
      U02_AlarmCode : Word;   // VFD 2# alarm code
   END_STRUCT;

END_TYPE

