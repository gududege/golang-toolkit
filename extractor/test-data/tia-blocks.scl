FUNCTION "FC_Delay_On_Accumulator" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      i_CMD_Start : Bool;
      i_Enable_Dly : Bool;
      i_CFG_Target : Int;
      i_Cycle_Count : Int;
   END_VAR

   VAR_OUTPUT 
      o_Delay_Finish : Bool;
   END_VAR

   VAR_IN_OUT 
      io_Setpoint : Int;
   END_VAR


BEGIN
	// Init time value
	IF NOT #i_CMD_Start THEN
	    #io_Setpoint := 0;
	END_IF;
	
	// Detect result
	#o_Delay_Finish := #i_CMD_Start AND #io_Setpoint >= #i_CFG_Target;
	
	// Count time value
	IF #i_CMD_Start THEN
	    IF #i_Enable_Dly THEN
	        #io_Setpoint := #io_Setpoint + #i_Cycle_Count;
	    END_IF;
	    IF #io_Setpoint > #i_CFG_Target THEN
	        #io_Setpoint := #i_CFG_Target;
	    END_IF;
	END_IF;
END_FUNCTION

